# Browser-safe public Supabase config
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Verify / AI server-side provider keys.
# Leave any provider blank to disable it. Never expose these as PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional Gemini reasoning level used by the router when supported.
GEMINI_THINKING_LEVEL=high

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# NVIDIA hosted NIM / free-endpoint access.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# Cohere trial/evaluation API.
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Optional local/self-hosted fallback for development.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Optional comma-separated provider priority override.
# Example: gemini,cerebras,groq,mistral,nvidia,cloudflare,openrouter,cohere,huggingface,ollama
AI_PROVIDER_ORDER=
