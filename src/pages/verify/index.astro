---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Verify an AI agent GitHub repository" description="Analyze a public GitHub AI agent or skill for freshness, repository health, setup signals, dependencies and static risk indicators.">
<main class="verify-page"><header><span>VERIFIER / PUBLIC GITHUB EVIDENCE</span><h1>Does this agent<br/><em>deserve your time?</em></h1><p>Paste a public GitHub repository. PARADOX checks live repository metadata, documentation, key project files and public activity, then explains the result.</p></header><form id="verifyForm"><input id="repoUrl" type="url" placeholder="https://github.com/owner/repository" required /><button>ANALYZE REPOSITORY ↗</button></form><div id="verifyStatus" class="status" role="status"></div><section id="result" class="result" hidden></section><section class="disclaimer"><b>Important:</b> this is automated static analysis, not a security audit or guarantee that software is safe to run.</section></main>
<script type="module" src="/scripts/verify.js"></script>
<style>.verify-page{padding:80px clamp(20px,7vw,110px);background:#f2efe7;min-height:90svh}.verify-page header>span{font:9px 'DM Mono';letter-spacing:.16em;color:#ff5a3d}.verify-page h1{font:700 clamp(70px,11vw,155px)/.78 'DM Sans';letter-spacing:-.09em;margin:28px 0}.verify-page h1 em{font:400 clamp(58px,9vw,130px)/.8 'Instrument Serif';color:#ff5a3d}.verify-page header p{max-width:730px;color:#686a63;line-height:1.65;font-size:17px}.verify-page form{display:flex;gap:10px;margin:35px 0 15px}.verify-page input{flex:1;min-width:0;padding:16px;border:1px solid #aaa79e;background:#fff;font:12px 'DM Mono'}.verify-page form button{padding:16px;background:#0d0e0e;color:#fff;border:0;font:9px 'DM Mono';white-space:nowrap}.status{min-height:25px;font:10px 'DM Mono';color:#ff5a3d}.result{margin-top:35px}.result-head{display:flex;justify-content:space-between;gap:20px;align-items:end;border-bottom:1px solid #aaa79e;padding-bottom:20px}.result h2{font:400 52px/.9 'Instrument Serif';margin:0}.verdict{font:700 12px 'DM Mono';padding:10px 12px;border:1px solid #0d0e0e}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#aaa79e;margin-top:1px}.metric{background:#fff;padding:20px}.metric span{font:9px 'DM Mono';color:#777970}.metric b{display:block;font-size:26px;margin-top:10px}.columns{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.panel{background:#0d0e0e;color:#fff;padding:22px}.panel h3{font:9px 'DM Mono';letter-spacing:.12em;color:#ff5a3d}.panel ul{padding-left:18px;line-height:1.7;color:#c7cac3}.save{margin-top:14px;padding:13px;background:#d9ff3f;color:#0d0e0e;border:0;font:9px 'DM Mono'}.disclaimer{margin-top:30px;color:#777970;font:10px/1.6 'DM Mono'}@media(max-width:800px){.verify-page form{display:grid}.metrics{grid-template-columns:1fr 1fr}.columns{grid-template-columns:1fr}}
</style>
</BaseLayout>
