---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Your PARADOX Workspace — AI Agent Intelligence"
  description="Saved agents and scan history tied to your private PARADOX workspace."
  canonical="https://paradox.engineer/dashboard/"
  robots="noindex,nofollow"
>
  <main class="professional-dashboard" aria-label="PARADOX private workspace">
    <header class="dashboard-topbar">
      <div class="workspace-identity">
        <div class="workspace-kicker">
          <span class="dot-pulse" aria-hidden="true"></span>
          <span>PARADOX / PRIVATE WORKSPACE</span>
        </div>
        <p id="accountEmail">Loading workspace credentials…</p>
      </div>

      <div class="account-actions" aria-label="Workspace actions">
        <a class="btn btn-emerald btn-sm" href="/verify/">Verify repository <span>↗</span></a>
        <a class="btn btn-ghost btn-sm" href="/ai-studio/?v=50cfb393ec7fe2bbb99d3b33adddf0722a143e4a&section=toolkit">AI tools <span>↗</span></a>
        <button id="clearHistory" class="btn btn-ghost btn-sm" type="button">Clear history</button>
        <button id="signOut" class="btn btn-ghost btn-sm dashboard-signout" type="button">Sign out</button>
      </div>
    </header>

    <section class="dashboard-hero" aria-labelledby="workspace-title">
      <div class="hero-copy animate-fade-slide-up">
        <span class="dashboard-label">CONTROL CENTER</span>
        <h1 id="workspace-title">Your Intelligence Workspace.</h1>
        <p>
          Keep shortlisted agent candidates, review scan evidence and risk history, and jump back into projects you are actively evaluating.
        </p>
      </div>

      <div class="dashboard-metrics" aria-label="Workspace summary">
        <article class="metric-box">
          <span>SAVED AGENTS</span>
          <strong id="savedCount">—</strong>
          <small>shortlisted</small>
        </article>
        <article class="metric-box">
          <span>SCAN HISTORY</span>
          <strong id="historyCount">—</strong>
          <small>analyses</small>
        </article>
        <article class="metric-box">
          <span>MEDIAN SCORE</span>
          <strong id="avgScore">—</strong>
          <small id="avgScoreNote">across saved</small>
        </article>
        <article class="metric-box metric-box-status">
          <span>SYNC STATUS</span>
          <strong id="workspaceMode">ONLINE</strong>
          <small>cloud synced</small>
        </article>
      </div>
    </section>

    <section class="dashboard-section insight-section dashboard-panel" aria-label="Evidence breakdown" id="insightSection" hidden>
      <div class="section-head">
        <div>
          <span class="dashboard-label">01 / VERDICT MIX</span>
          <h2>Evidence distribution</h2>
          <p id="evidenceDescription">How your current workspace evidence breaks down by verdict.</p>
        </div>
        <span class="section-note" id="attentionNote"></span>
      </div>
      <div class="verdict-bar" id="verdictBar" role="img" aria-label="Verdict distribution across workspace evidence"></div>
      <ul class="verdict-legend" id="verdictLegend"></ul>
    </section>

    <section class="dashboard-section dashboard-panel" aria-label="Saved agents">
      <div class="section-head">
        <div>
          <span class="dashboard-label">02 / SHORTLIST</span>
          <h2>Saved Agents</h2>
          <p>Shortlisted repositories ready to reopen or compare.</p>
        </div>
        <a href="/agents/" class="btn btn-ghost btn-sm">Discover more agents →</a>
      </div>

      <div class="list-toolbar" id="savedToolbar" hidden>
        <div class="toolbar-search">
          <input id="savedFilter" class="input-tech" type="search" placeholder="Filter by repository name…" autocomplete="off" />
        </div>
        <select id="savedSort" class="input-tech toolbar-sort" aria-label="Sort saved agents">
          <option value="recent">Most recent</option>
          <option value="score-desc">Highest score</option>
          <option value="score-asc">Lowest score</option>
          <option value="name">Name A–Z</option>
        </select>
        <span class="result-count" id="savedShown" aria-live="polite"></span>
      </div>

      <div id="savedAgents" class="grid-agents dashboard-list" aria-live="polite"></div>
    </section>

    <section class="dashboard-section dashboard-panel" aria-label="Scan activity">
      <div class="section-head">
        <div>
          <span class="dashboard-label dashboard-label-emerald">03 / SCAN ACTIVITY</span>
          <h2>Scan History</h2>
          <p>Every completed repository analysis tied to this workspace.</p>
        </div>
        <a href="/verify/" class="btn btn-emerald btn-sm">Run new verification ↗</a>
      </div>

      <div class="list-toolbar history-toolbar" id="historyToolbar" hidden>
        <div class="toolbar-search">
          <input id="historyFilter" class="input-tech" type="search" placeholder="Filter scan history…" autocomplete="off" />
        </div>
        <span class="result-count" id="historyShown" aria-live="polite"></span>
      </div>

      <div id="scanHistory" class="grid-agents dashboard-list" aria-live="polite"></div>
    </section>

    <section class="dashboard-section dashboard-panel security-panel" aria-label="Account details">
      <div class="section-head">
        <div>
          <span class="dashboard-label dashboard-label-muted">04 / PRIVACY & DATA</span>
          <h2>Workspace Security</h2>
          <p>How PARADOX secures your private evaluation records.</p>
        </div>
      </div>

      <div class="bento-grid-4">
        <div class="bento-cell">
          <span class="kicker">SESSION</span>
          <strong id="profileEmail">Authenticated</strong>
          <p>Your current secure session identity.</p>
        </div>
        <div class="bento-cell">
          <span class="kicker">DATA ISOLATION</span>
          <h3>Private Row-Level</h3>
          <p>All saved agents and history are protected by Postgres Row Level Security (RLS).</p>
        </div>
        <div class="bento-cell">
          <span class="kicker">OFFLINE FALLBACK</span>
          <h3>Device Local Cache</h3>
          <p>Saved scans remain accessible locally even when disconnected from Supabase.</p>
        </div>
        <div class="bento-cell">
          <span class="kicker">NEXT STEP</span>
          <h3 id="nextAction">Build Evidence</h3>
          <p id="nextActionNote">Verify new repositories and add them to your decision matrix.</p>
        </div>
      </div>
    </section>
  </main>

  <script>
    import '../../scripts/pages/dashboard-page.ts';
  </script>
</BaseLayout>

<style>
  .professional-dashboard {
    max-width: var(--max-w-wide);
    margin: 0 auto;
    padding: 32px 24px 96px;
  }

  .dashboard-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .workspace-kicker,
  .dashboard-label,
  .metric-box > span,
  .metric-box > small,
  .result-count,
  .section-note {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .workspace-kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 7px;
    color: var(--accent-light);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .workspace-identity p {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .account-actions {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }

  .dashboard-signout {
    color: var(--rose-light);
  }

  .dashboard-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    gap: 42px;
    align-items: center;
    padding: 46px 0 38px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-copy {
    min-width: 0;
  }

  .dashboard-label {
    color: var(--cyan);
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .dashboard-label-emerald {
    color: var(--emerald-light);
  }

  .dashboard-label-muted {
    color: var(--text-muted);
  }

  .hero-copy h1 {
    margin: 10px 0 14px;
    color: var(--text-primary);
    font-size: clamp(38px, 4.5vw, 62px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .hero-copy p {
    max-width: 600px;
    margin: 0;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.65;
  }

  .dashboard-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .metric-box {
    min-height: 108px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 18px;
    background: linear-gradient(145deg, var(--surface-1), rgba(255,255,255,0.015));
    border: 1px solid var(--border-default);
  }

  .metric-box > span {
    color: var(--text-muted);
    font-size: 9px;
    letter-spacing: 0.11em;
  }

  .metric-box > strong {
    color: var(--text-primary);
    font-size: 28px;
    font-weight: 750;
    line-height: 1;
  }

  .metric-box > small {
    color: var(--text-muted);
    font-size: 9px;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .metric-box-status {
    border-color: rgba(99, 102, 241, 0.4);
    background: rgba(99, 102, 241, 0.08);
  }

  .metric-box-status > strong {
    color: var(--accent-light);
    font-size: 16px;
  }

  .dashboard-section {
    margin-top: 30px;
  }

  .dashboard-panel {
    padding: 26px;
    border: 1px solid var(--border-subtle);
    background: rgba(255,255,255,0.012);
  }

  .insight-section {
    margin-top: 30px;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .section-head h2 {
    margin: 6px 0 0;
    color: var(--text-primary);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .section-head p {
    margin: 5px 0 0;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.5;
  }

  .section-note {
    min-height: 14px;
    color: var(--amber-light);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .verdict-bar {
    display: flex;
    width: 100%;
    height: 8px;
    overflow: hidden;
    border-radius: 99px;
    background: rgba(255,255,255,0.05);
  }

  .verdict-bar i {
    display: block;
    height: 100%;
  }

  .verdict-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 15px 20px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
  }

  .verdict-legend li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .verdict-legend b {
    width: 7px;
    height: 7px;
    display: inline-block;
    border-radius: 50%;
  }

  .verdict-legend em {
    color: var(--text-primary);
    font-style: normal;
  }

  .list-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding: 10px;
    border: 1px solid var(--border-subtle);
    background: rgba(0,0,0,0.16);
  }

  .toolbar-search {
    flex: 1;
    min-width: 220px;
  }

  .toolbar-sort {
    width: 190px;
    cursor: pointer;
  }

  .list-toolbar .input-tech {
    width: 100%;
    box-sizing: border-box;
  }

  .result-count {
    min-width: 72px;
    color: var(--text-muted);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-align: right;
    white-space: nowrap;
  }

  .dashboard-list {
    min-height: 56px;
  }

  .security-panel {
    margin-top: 30px;
  }

  .security-panel .bento-grid-4 {
    margin-top: 2px;
  }

  @media (max-width: 980px) {
    .dashboard-hero {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 680px) {
    .professional-dashboard {
      padding: 22px 16px 70px;
    }

    .dashboard-topbar {
      align-items: flex-start;
    }

    .account-actions {
      width: 100%;
    }

    .account-actions .btn {
      flex: 1;
      justify-content: center;
    }

    .dashboard-panel {
      padding: 20px;
    }

    .dashboard-metrics {
      grid-template-columns: 1fr 1fr;
    }

    .metric-box {
      min-height: 96px;
      padding: 15px;
    }

    .metric-box > strong {
      font-size: 24px;
    }

    .list-toolbar {
      align-items: stretch;
      flex-direction: column;
    }

    .toolbar-search,
    .toolbar-sort {
      width: 100%;
    }

    .result-count {
      text-align: left;
    }
  }

  @media (max-width: 430px) {
    .dashboard-metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
