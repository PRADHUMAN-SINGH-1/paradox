---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Your PARADOX Workspace — AI Agent Intelligence" 
  description="Saved agents and scan history tied to your private PARADOX workspace." 
  canonical="https://paradox.engineer/dashboard/" 
  robots="noindex,nofollow"
>
  <main class="professional-dashboard" style="max-width: var(--max-w-wide); margin: 0 auto; padding: 40px 24px 100px;">
    <!-- Top Identity Bar -->
    <header class="dashboard-topbar" style="display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: 24px; border-bottom: 1px solid var(--border-subtle); flex-wrap: wrap;">
      <div class="workspace-identity">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
          <span class="dot-pulse"></span>
          <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--accent-light); text-transform: uppercase;">PARADOX / PRIVATE WORKSPACE</span>
        </div>
        <p id="accountEmail" style="margin: 0; font-family: var(--font-mono); font-size: 13px; color: var(--text-primary);">Loading workspace credentials…</p>
      </div>
      <div class="account-actions" style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;" aria-label="Workspace actions">
        <a class="btn btn-emerald btn-sm" href="/verify/">Verify repository <span>↗</span></a>
        <a class="btn btn-ghost btn-sm" href="/ai-studio/?v=50cfb393ec7fe2bbb99d3b33adddf0722a143e4a&section=toolkit">AI tools <span>↗</span></a>
        <button id="clearHistory" class="btn btn-ghost btn-sm" type="button">Clear history</button>
        <button id="signOut" class="btn btn-ghost btn-sm" type="button" style="color: var(--rose-light);">Sign out</button>
      </div>
    </header>

    <!-- Workspace Hero -->
    <section class="dashboard-hero" style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 36px; align-items: center; padding: 48px 0 40px; border-bottom: 1px solid var(--border-subtle);" aria-labelledby="workspace-title">
      <div class="hero-copy animate-fade-slide-up">
        <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--cyan); text-transform: uppercase;">CONTROL CENTER</span>
        <h1 id="workspace-title" style="font-size: clamp(36px, 4.5vw, 62px); font-weight: 800; letter-spacing: -0.03em; margin: 10px 0 14px; color: var(--text-primary);">
          Your Intelligence Workspace.
        </h1>
        <p style="font-size: 15px; color: var(--text-secondary); line-height: 1.6; margin: 0; max-width: 580px;">
          Keep shortlisted agent candidates, review scan evidence and risk history, and jump back into projects you are actively evaluating.
        </p>
      </div>

      <!-- Bento Metrics -->
      <div class="dashboard-metrics" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;" aria-label="Workspace summary">
        <article class="metric-box">
          <span>SAVED AGENTS</span>
          <strong id="savedCount">—</strong>
          <small style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted);">shortlisted</small>
        </article>
        <article class="metric-box">
          <span>SCAN HISTORY</span>
          <strong id="historyCount">—</strong>
          <small style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted);">analyses</small>
        </article>
        <article class="metric-box">
          <span>MEDIAN SCORE</span>
          <strong id="avgScore">—</strong>
          <small id="avgScoreNote" style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted);">across saved</small>
        </article>
        <article class="metric-box" style="border-color: rgba(99, 102, 241, 0.4); background: rgba(99, 102, 241, 0.08);">
          <span>SYNC STATUS</span>
          <strong id="workspaceMode" style="color: var(--accent-light); font-size: 16px;">ONLINE</strong>
          <small style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted);">cloud synced</small>
        </article>
      </div>
    </section>

    <!-- Evidence Breakdown Section -->
    <section class="dashboard-section insight-section" style="margin-top: 40px;" aria-label="Evidence breakdown" id="insightSection" hidden>
      <div class="section-head" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px;">
        <div>
          <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--accent-light); text-transform: uppercase;">01 / VERDICT MIX</span>
          <h2 style="font-size: 24px; font-weight: 800; margin: 6px 0 0;">Evidence distribution</h2>
          <p style="font-size: 13px; color: var(--text-secondary); margin: 4px 0 0;">How your saved repositories break down by verdict.</p>
        </div>
        <span class="section-note" id="attentionNote" style="font-family: var(--font-mono); font-size: 11px; color: var(--amber-light);"></span>
      </div>
      <div class="verdict-bar" id="verdictBar" role="img" aria-label="Verdict distribution across saved agents" style="display: flex; width: 100%; height: 8px; border-radius: 99px; overflow: hidden; background: rgba(255, 255, 255, 0.05);"></div>
      <ul class="verdict-legend" id="verdictLegend" style="display: flex; flex-wrap: wrap; gap: 16px; margin: 14px 0 0; padding: 0; list-style: none;"></ul>
    </section>

    <!-- Saved Agents Collection -->
    <section class="dashboard-section" style="margin-top: 50px;" aria-label="Workspace collections">
      <div class="section-head" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px; flex-wrap: wrap; gap: 16px;">
        <div>
          <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--cyan); text-transform: uppercase;">02 / SHORTLIST</span>
          <h2 style="font-size: 24px; font-weight: 800; margin: 6px 0 0;">Saved Agents</h2>
          <p style="font-size: 13px; color: var(--text-secondary); margin: 4px 0 0;">Shortlisted repositories ready to reopen or compare.</p>
        </div>
        <a href="/agents/" class="btn btn-ghost btn-sm">Discover more agents →</a>
      </div>

      <div class="list-toolbar" id="savedToolbar" hidden style="display: flex; gap: 12px; align-items: center; margin-bottom: 20px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 240px;">
          <input id="savedFilter" class="input-tech" type="search" placeholder="Filter by repository name…" autocomplete="off" />
        </div>
        <div style="width: 200px;">
          <select id="savedSort" class="input-tech" style="cursor: pointer;">
            <option value="recent">Most recent</option>
            <option value="score-desc">Highest score</option>
            <option value="score-asc">Lowest score</option>
            <option value="name">Name A–Z</option>
          </select>
        </div>
        <span class="result-count" id="savedShown" aria-live="polite" style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);"></span>
      </div>

      <div id="savedAgents" class="grid-agents" aria-live="polite"></div>
    </section>

    <!-- Scan History Activity -->
    <section class="dashboard-section" style="margin-top: 60px; border-top: 1px solid var(--border-subtle); padding-top: 40px;" aria-label="Scan activity">
      <div class="section-head" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px; flex-wrap: wrap; gap: 16px;">
        <div>
          <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--emerald-light); text-transform: uppercase;">03 / SCAN ACTIVITY</span>
          <h2 style="font-size: 24px; font-weight: 800; margin: 6px 0 0;">Scan History</h2>
          <p style="font-size: 13px; color: var(--text-secondary); margin: 4px 0 0;">Every completed repository analysis tied to this workspace.</p>
        </div>
        <a href="/verify/" class="btn btn-emerald btn-sm">Run new verification ↗</a>
      </div>

      <div id="scanHistory" class="grid-agents" aria-live="polite"></div>
    </section>

    <!-- Account Details -->
    <section class="dashboard-section" style="margin-top: 60px; border-top: 1px solid var(--border-subtle); padding-top: 40px;" aria-label="Account details">
      <div class="section-head" style="margin-bottom: 20px;">
        <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--text-muted); text-transform: uppercase;">04 / PRIVACY & DATA</span>
        <h2 style="font-size: 24px; font-weight: 800; margin: 6px 0 0;">Workspace Security</h2>
        <p style="font-size: 13px; color: var(--text-secondary); margin: 4px 0 0;">How PARADOX secures your private evaluation records.</p>
      </div>

      <div class="bento-grid-4">
        <div class="bento-cell">
          <span class="kicker">SESSION</span>
          <strong id="profileEmail" style="font-family: var(--font-mono); font-size: 13px; color: var(--text-primary); word-break: break-all;">Authenticated</strong>
          <p>Your current secure session identity.</p>
        </div>
        <div class="bento-cell">
          <span class="kicker">DATA ISOLATION</span>
          <h3>Private Row-Level</h3>
          <p>All saved agents and history are protected by Postgres Row Level Security (RLS).</p>
        </div>
        <div class="bento-cell">
          <span class="kicker">OFFLINE FALLBACK</span>
          <h3>Device Local Cache</h3>
          <p>Saved scans remain accessible locally even when disconnected from Supabase.</p>
        </div>
        <div class="bento-cell">
          <span class="kicker">NEXT STEP</span>
          <h3 id="nextAction">Build Evidence</h3>
          <p id="nextActionNote">Verify new repositories and add them to your decision matrix.</p>
        </div>
      </div>
    </section>
  </main>

  <script>
    import '../../scripts/pages/dashboard-page.ts';
  </script>
</BaseLayout>
<style>
@media (max-width: 900px) {
  .dashboard-hero {
    grid-template-columns: 1fr !important;
  }
}
</style>
