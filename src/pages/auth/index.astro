---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Sign in to PARADOX" description="Create a PARADOX account to save agents and keep your scan history.">
<main class="auth-page"><div class="auth-card"><div class="label">PARADOX ACCOUNT</div><h1 id="authTitle">Join the shortlist.</h1><p id="authCopy">Save agents, keep scan history, and come back to the projects you care about.</p><form id="authForm"><input id="authEmail" type="email" autocomplete="email" placeholder="you@example.com" required /><input id="authPassword" type="password" autocomplete="new-password" placeholder="Password" minlength="8" required /><button type="submit" id="authSubmit">CREATE ACCOUNT</button></form><button class="oauth" id="githubAuth" type="button">CONTINUE WITH GITHUB</button><button class="link-btn" id="toggleMode" type="button">Already have an account? Sign in.</button><button class="link-btn" id="resetPassword" type="button">Forgot your password?</button><p class="status" id="authStatus" role="status"></p></div></main>
<script type="module" src="/scripts/auth-page.js"></script>
<style>.auth-page{min-height:75svh;display:grid;place-items:center;padding:50px 20px;background:#f2efe7}.auth-card{width:min(480px,100%);background:#0d0e0e;color:#fff;padding:34px}.label{font:9px 'DM Mono';letter-spacing:.16em;color:#ff5a3d}.auth-card h1{font:400 58px/.9 'Instrument Serif';margin:22px 0 12px}.auth-card p{color:#9ea29a;line-height:1.55}.auth-card form{display:grid;gap:10px;margin-top:25px}.auth-card input,.auth-card button{font:11px 'DM Mono';padding:14px;border:1px solid #3b3e39}.auth-card input{background:#151817;color:#fff}.auth-card button{background:#d9ff3f;color:#0d0e0e;cursor:pointer}.auth-card .oauth,.auth-card .link-btn{background:transparent;color:#fff}.auth-card .link-btn{border:0;text-align:left;padding:7px 0}.status{min-height:20px;margin-top:12px!important;font:11px 'DM Mono'}</style>
</BaseLayout>
