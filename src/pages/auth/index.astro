---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Create or Sign In — PARADOX" 
  description="Sign in to PARADOX to sync saved agent shortlists, access verification history, and use developer tools." 
  canonical="https://paradox.engineer/auth/" 
  robots="noindex,nofollow"
>
  <main class="auth-page auth-modern">
    <section class="auth-shell" aria-label="PARADOX authentication">
      <div class="auth-intro animate-fade-slide-up">
        <div class="hero-eyebrow" style="margin-bottom: 12px;">
          <span class="dot-pulse"></span>
          <span>PARADOX / DEVELOPER ACCESS</span>
        </div>
        <h1 id="authTitle" style="font-size: clamp(36px, 4.5vw, 60px); font-weight: 800; letter-spacing: -0.03em; margin: 0 0 16px; color: var(--text-primary);">
          Access the Intelligence Core.
        </h1>
        <p id="authCopy" style="font-size: 16px; line-height: 1.6; color: var(--text-secondary); margin: 0 0 28px;">
          Sign in or create an account to save custom agent shortlists, sync scan history, and access private developer workbench tools.
        </p>
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="display: flex; align-items: center; gap: 12px;">
            <span style="display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(99, 102, 241, 0.15); color: var(--accent-light); font-family: var(--font-mono); font-size: 11px; font-weight: 700;">01</span>
            <span style="font-family: var(--font-mono); font-size: 12px; color: var(--text-primary);">Personalized Shortlists & Scan History</span>
          </div>
          <div style="display: flex; align-items: center; gap: 12px;">
            <span style="display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(0, 229, 255, 0.15); color: var(--cyan); font-family: var(--font-mono); font-size: 11px; font-weight: 700;">02</span>
            <span style="font-family: var(--font-mono); font-size: 12px; color: var(--text-primary);">Deep Static Analysis & Exportable JSON Reports</span>
          </div>
          <div style="display: flex; align-items: center; gap: 12px;">
            <span style="display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(16, 185, 129, 0.15); color: var(--emerald-light); font-family: var(--font-mono); font-size: 11px; font-weight: 700;">03</span>
            <span style="font-family: var(--font-mono); font-size: 12px; color: var(--text-primary);">Developer Workbench & Code Generators</span>
          </div>
        </div>
      </div>

      <!-- Auth Card -->
      <div class="card-glass animate-fade-slide-up" style="animation-delay: 150ms; padding: 36px; border-color: var(--border-default); box-shadow: var(--shadow-card);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
          <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; color: var(--accent-light); font-weight: 700;">SIGN IN / SIGN UP</span>
          <span class="chip" style="font-size: 9px;">PRIVATE ACCOUNT</span>
        </div>

        <form id="authForm" style="display: flex; flex-direction: column; gap: 14px;">
          <div>
            <label for="authEmail" style="display: block; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">Email Address</label>
            <input id="authEmail" class="input-tech" type="email" autocomplete="email" placeholder="you@example.com" required />
          </div>

          <div>
            <label for="authPassword" style="display: block; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">Password</label>
            <div style="position: relative;">
              <input id="authPassword" class="input-tech" type="password" autocomplete="new-password" placeholder="At least 8 characters" minlength="8" required style="padding-right: 70px;" />
              <button type="button" id="togglePassword" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); cursor: pointer;">Show</button>
            </div>
          </div>

          <button class="btn btn-primary" type="submit" id="authSubmit" style="margin-top: 10px; height: 44px; font-size: 12px;">
            Create account
          </button>
        </form>

        <div style="display: flex; align-items: center; gap: 12px; margin: 24px 0 16px; color: var(--text-muted); font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em;">
          <div style="flex: 1; height: 1px; background: var(--border-subtle);"></div>
          <span>OR CONTINUE WITH</span>
          <div style="flex: 1; height: 1px; background: var(--border-subtle);"></div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <button class="btn btn-ghost" id="githubAuth" type="button" style="border-color: var(--border-default); background: var(--surface);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            <span>GitHub</span>
          </button>
          <button class="btn btn-ghost" id="googleAuth" type="button" style="border-color: var(--border-default); background: var(--surface);">
            <svg width="14" height="14" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.36 24 12 24z"/><path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.36 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/></svg>
            <span>Google</span>
          </button>
        </div>

        <button class="btn btn-ghost btn-sm auth-switch" id="toggleMode" type="button" style="margin-top: 18px; width: 100%;">
          Already have an account? Sign in.
        </button>
        <button class="btn btn-ghost btn-sm" id="resetPassword" type="button" style="margin-top: 6px; width: 100%; color: var(--text-muted);">
          Forgot your password?
        </button>
        
        <p class="status" id="authStatus" role="status" aria-live="polite" style="font-family: var(--font-mono); font-size: 11px; color: var(--cyan); text-align: center; margin-top: 12px;"></p>
        
        <p style="margin-top: 16px; font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); text-align: center; line-height: 1.5;">
          By continuing, you agree to PARADOX's <a href="/terms/" style="color: var(--text-secondary);">Terms</a> and <a href="/privacy/" style="color: var(--text-secondary);">Privacy Policy</a>.
        </p>
      </div>
    </section>
  </main>
  <script>
    import '../../scripts/auth-page.ts';
  </script>
</BaseLayout>
<style>
.auth-modern {
  min-height: calc(100vh - 140px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 24px;
}
.auth-shell {
  width: 100%;
  max-width: 1060px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 60px;
  align-items: center;
}
@media (max-width: 860px) {
  .auth-shell {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}
</style>
