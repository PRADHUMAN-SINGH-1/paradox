---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Sign in to PARADOX" description="Create a PARADOX account to save agents and keep your scan history." canonical="https://paradox.engineer/auth/" robots="noindex,nofollow">
  <main class="auth-page">
    <div class="auth-card">
      <div class="label">PARADOX ACCOUNT</div>
      <h1 id="authTitle">Save the agents you trust.</h1>
      <p id="authCopy">Discovery and verification stay free. Sign in only when you want a private shortlist and scan history.</p>
      <form id="authForm">
        <label class="visually-hidden" for="authEmail">Email</label>
        <input id="authEmail" type="email" autocomplete="email" placeholder="you@example.com" required />
        <label class="visually-hidden" for="authPassword">Password</label>
        <input id="authPassword" type="password" autocomplete="new-password" placeholder="Password" minlength="8" required />
        <button type="submit" id="authSubmit">Create account</button>
      </form>
      <button class="oauth" id="githubAuth" type="button">Continue with GitHub</button>
      <button class="link-btn" id="toggleMode" type="button">Already have an account? Sign in.</button>
      <button class="link-btn" id="resetPassword" type="button">Forgot your password?</button>
      <p class="status" id="authStatus" role="status"></p>
    </div>
  </main>
  <script>
    import '../../scripts/auth-page.ts';
  </script>
</BaseLayout>
<style>
.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
.label{font:9px 'DM Mono',monospace;letter-spacing:.16em;color:#ff5a3d}
</style>
