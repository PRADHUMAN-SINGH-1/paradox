---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalog from '../../data/catalog.json';
---
<BaseLayout title="Trending AI agents — PARADOX" description="Recently catalogued and active public AI agent repositories. Trends are explained; percentages are not invented." canonical="https://paradox.engineer/trending/">
  <main class="agents-page">
    <header>
      <span>TRENDING / DISCOVERY</span>
      <h1>What is moving<br /><em>in public GitHub.</em></h1>
      <p class="page-lead">This list is a curated discovery layer plus a live GitHub search for recently updated agent-related projects. It is not Google search volume.</p>
    </header>
    <section>
      <h2>Catalogued projects</h2>
      <div class="grid-2">
        {catalog.map((e) => (
          <article class="agent-card">
            <div class="meta"><span>Recently catalogued</span><span>{e.category}</span></div>
            <h3>{e.owner}/{e.repo}</h3>
            <p>{e.summary}</p>
            <div class="links"><a href={`/agents/${e.owner}/${e.repo}/`}>Why it is listed → profile</a></div>
          </article>
        ))}
      </div>
    </section>
    <section>
      <h2>Recently updated on GitHub</h2>
      <p class="page-lead">Live query: public repositories matching “ai agent”, sorted by last update. Rate limits may empty this list.</p>
      <div id="liveTrend" class="grid-2"><p class="muted">Loading public GitHub activity…</p></div>
    </section>
  </main>
  <script>
    const el = document.querySelector('#liveTrend');
    fetch('https://api.github.com/search/repositories?q=ai+agent&sort=updated&order=desc&per_page=8', { headers: { Accept: 'application/vnd.github+json' } })
      .then(async (r) => {
        if (!r.ok || !el) { if (el) el.innerHTML = '<p class="muted">Live GitHub trend data is unavailable right now.</p>'; return; }
        const data = await r.json();
        el.innerHTML = (data.items || []).map((x: { full_name: string; description?: string; html_url: string; pushed_at: string }) =>
          `<article class="agent-card"><div class="meta"><span>Rapid recent activity</span><span>${x.pushed_at?.slice(0,10) || 'Unknown'}</span></div><h3>${x.full_name}</h3><p>${x.description || 'No description provided.'}</p><div class="links"><a href="/verify/?url=${encodeURIComponent(x.html_url)}">Verify</a></div></article>`
        ).join('') || '<p class="muted">No live results.</p>';
      })
      .catch(() => { if (el) el.innerHTML = '<p class="muted">Live GitHub trend data is unavailable right now.</p>'; });
  </script>
</BaseLayout>
