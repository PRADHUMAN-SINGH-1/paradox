---
import tools from '../../data/ai-tools.json';

export function getStaticPaths() {
  return tools.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const destination = '/ai-studio/?section=toolkit&tool=' + item.slug;
---
<!doctype html>
<html lang="en">
<head>
  <meta http-equiv="refresh" content={'0;url=' + destination}>
  <meta name="robots" content="noindex,nofollow">
  <title>{item.label} — PARADOX AI Studio</title>
</head>
<body>
  <p>Opening {item.label} inside PARADOX Studio…</p>
  <script is:inline>
    window.location.replace(destination);
  </script>
</body>
</html>
