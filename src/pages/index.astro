---
import MakerLayout from '../layouts/MakerLayout.astro';
import verified from '../data/verified_opportunities.json';
import utilityOpportunities from '../data/utility-opportunities.json';

const tools=[
  {icon:'🎲',name:'Bingo cards',desc:'Make a custom printable card in seconds.',href:'/bingo-card-generator/',tags:'bingo classroom school party game'},
  {icon:'🔎',name:'Word searches',desc:'Turn any word list into a printable puzzle.',href:'/word-search-generator/',tags:'word search spelling vocabulary puzzle'},
  {icon:'👥',name:'Random teams',desc:'Split a group fairly without arguing.',href:'/random-team-generator/',tags:'random team picker classroom office sports'},
  {icon:'🎡',name:'Decision wheel',desc:'Add choices and let the wheel pick.',href:'/decision-wheel/',tags:'decision random picker choice wheel'},
  {icon:'🏆',name:'Tournament bracket',desc:'Build matchups for your next competition.',href:'/tournament-bracket-generator/',tags:'tournament bracket sports competition'},
  {icon:'🎟️',name:'Raffle tickets',desc:'Create numbered tickets ready to print.',href:'/raffle-ticket-generator/',tags:'raffle tickets fundraiser giveaway'},
  {icon:'🪑',name:'Seating chart',desc:'Arrange names into a clean seating plan.',href:'/seating-chart-generator/',tags:'seating chart wedding classroom dinner'},
  {icon:'🏅',name:'Certificates',desc:'Make a clean certificate for any occasion.',href:'/certificate-maker/',tags:'certificate award graduation appreciation'}
];

const utilities = utilityOpportunities.length ? utilityOpportunities.slice(0,8) : [
  {slug:'percentage-calculator',label:'Percentage calculator'},
  {slug:'age-calculator',label:'Age calculator'},
  {slug:'time-zone-converter',label:'Time zone converter'},
  {slug:'unit-converter',label:'Unit converter'},
  {slug:'countdown-timer',label:'Countdown timer'},
  {slug:'random-number-generator',label:'Random number generator'},
  {slug:'word-counter',label:'Word counter'},
  {slug:'date-difference-calculator',label:'Date difference calculator'}
];

const opportunityList = Array.isArray(verified) ? verified.filter(item => item.route).slice(0,6) : [];
const popular = opportunityList.length ? opportunityList : [
  {label:'Percentage calculator',route:'/utilities/percentage-calculator/',score:0},
  {label:'Age calculator',route:'/utilities/age-calculator/',score:0},
  {label:'Random team generator',route:'/random-team-generator/',score:0},
  {label:'Tournament bracket generator',route:'/tournament-bracket-generator/',score:0},
  {label:'Word search generator',route:'/word-search-generator/',score:0},
  {label:'Bingo card generator',route:'/bingo-card-generator/',score:0}
];
---
<MakerLayout title="PARADOX — Free tools that get the job done" description="Free browser tools for calculators, teams, puzzles, brackets, raffles, charts and everyday jobs. No account required.">
<main class="home">
  <section class="home-hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="live-dot"></span> FREE · NO ACCOUNT · NO UPLOADS</div>
      <h1>Need to get<br><em>something done?</em></h1>
      <p class="hero-lead">Skip the signup. Pick a tool. Get the result. PARADOX is a growing collection of small browser tools for real-world jobs.</p>
      <div class="hero-search">
        <span>⌕</span>
        <input id="toolSearch" type="search" placeholder="Search: percentage, teams, bracket, bingo…" aria-label="Search tools" autocomplete="off">
        <kbd>/</kbd>
      </div>
      <div class="hero-links"><a class="button button-dark" href="#tools">Browse the toolbox</a><a class="text-link" href="/utilities/">Open calculators →</a></div>
    </div>
    <div class="hero-feature">
      <div class="feature-label">POPULAR RIGHT NOW</div>
      <div class="feature-emoji">↗</div>
      <div class="feature-body">
        <span>Useful searches surfaced from the demand pipeline</span>
        <div class="popular-list">
          {popular.map((item,index)=><a href={item.route}><b>{String(index+1).padStart(2,'0')}</b><span>{item.label}</span><small>Use it →</small></a>)}
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip"><span>Works in your browser</span><span>No signup</span><span>Mobile friendly</span><span>Private by default</span><span>Printable results</span></section>

  <section class="section tools-section" id="tools">
    <div class="section-intro"><div><span class="eyebrow">THE TOOLBOX</span><h2>Pick a job.<br><em>Finish it.</em></h2></div><p>These are the things people actually use: make, pick, split, print, calculate.</p></div>
    <div class="tool-grid" id="toolGrid">
      {tools.map((tool,index)=><a class="tool-card" data-search={tool.name+' '+tool.desc+' '+tool.tags} href={tool.href}><div class="tool-icon">{tool.icon}</div><div class="tool-number">{String(index+1).padStart(2,'0')}</div><h3>{tool.name}</h3><p>{tool.desc}</p><span class="tool-arrow">Use it →</span></a>)}
    </div>
    <div id="noResults" class="no-results" hidden>No exact match. Try <a href="/utilities/">the utility library →</a></div>
  </section>

  <section class="section quick-section">
    <div class="section-intro"><div><span class="eyebrow">QUICK TOOLS</span><h2>One tiny task.<br><em>One tiny tool.</em></h2></div><p>Calculations, dates, conversions and text utilities for “I just need this done” moments.</p></div>
    <div class="quick-grid">{utilities.map(item=><a href={'/utilities/'+item.slug+'/'}><span>{item.label}</span><small>Open →</small></a>)}</div>
  </section>

  <section class="section live-section">
    <div class="live-intro"><div><span class="eyebrow">COME BACK</span><h2>Useful once.<br><em>Useful again.</em></h2><p>Two lightweight spaces that change over time: a tiny daily challenge and a live world desk.</p></div>
    <div class="live-actions"><a class="live-card" href="/daily/"><span>🔥</span><div><b>PARADOX Daily</b><small>5-second challenge · streak · share</small></div><strong>→</strong></a><a class="live-card" href="/world/"><span>🌍</span><div><b>World Desk</b><small>Live weather · currency · country facts</small></div><strong>→</strong></a></div></div>
  </section>

  <section class="section simple-section">
    <div class="simple-grid"><div><span class="eyebrow">HOW IT WORKS</span><h2>Open.<br>Make.<br><em>Done.</em></h2></div>
      <div class="simple-points"><article><b>01</b><div><h3>No account</h3><p>There is no registration wall between you and the tool.</p></div></article><article><b>02</b><div><h3>Browser-first</h3><p>Most tools run directly in your browser, so your inputs can stay on your device.</p></div></article><article><b>03</b><div><h3>Built for finishing</h3><p>Generate the thing you came for, then copy, print or share the result.</p></div></article></div>
    </div>
  </section>

  <section class="section final-cta"><div class="final-cta-inner"><span class="eyebrow">NO HUNTING AROUND</span><h2>Tell PARADOX what you're trying to do.</h2><p>Use the search above, or start with the full collection.</p><a class="button button-dark" href="/utilities/">See all quick tools →</a></div></section>
</main>
<script is:inline>
(() => {
 const input=document.querySelector('#toolSearch'), cards=[...document.querySelectorAll('.tool-card')], empty=document.querySelector('#noResults');
 if(!input) return;
 input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let shown=0;cards.forEach(c=>{const ok=!q||c.dataset.search.toLowerCase().includes(q);c.hidden=!ok;if(ok)shown++});empty.hidden=shown>0});
 window.addEventListener('keydown',e=>{if(e.key==='/'&&document.activeElement!==input&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();input.focus()}});
})();
</script>
</MakerLayout>
