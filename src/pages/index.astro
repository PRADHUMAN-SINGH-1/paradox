---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalog from '../data/catalog.json';
import tools from '../data/ai-tools.json';

const featured = catalog.slice(0, 8);
const featuredTools = tools.slice(0, 6);
---

<BaseLayout 
  title="PARADOX — Observable AI Agent Intelligence & Trust Signals" 
  description="Discover, inspect, compare and evaluate public AI agents and GitHub projects using observable repository evidence before you depend on them."
>
  <main class="editorial-main">
    <!-- Chapter 01: Full-Viewport Massive Editorial Typography (BOOT / CORE) -->
    <section class="hero-editorial-full" data-chapter="BOOT">
      <div class="hero-top-meta">
        <span class="coord-stamp">45.1094° N, 0.0000° E // ZERO_EXECUTION</span>
        <span class="meta-label">OBSERVABLE REPOSITORY EVIDENCE</span>
      </div>

      <div class="hero-headline-massive">
        <h1 class="giant-editorial-title" data-kinetic data-hero-kinetic>
          OBSERVE WHAT<br />
          OTHERS ASSUME.
        </h1>
      </div>

      <div class="hero-bottom-grid">
        <p class="hero-statement">
          Deterministic static analysis for public AI agents, Model Context Protocol tooling, and GitHub repositories. Zero code execution. Mathematical proof.
        </p>

        <div class="hero-actions-minimal">
          <a href="/verify/" class="btn btn-primary" data-cursor="VERIFY">Inspect Repository →</a>
          <a href="/agents/" class="btn btn-ghost" data-cursor="EXPLORE">Explore Atlas ↗</a>
        </div>
      </div>

      <div class="hero-scroll-indicator">
        <span>SCROLL TO ADVANCE</span>
        <div class="scroll-hairline"></div>
      </div>
    </section>

    <!-- Continuous Architectural Marquee -->
    <div class="marquee-strip" aria-hidden="true">
      <div class="marquee-content">
        <span>PARADOX <strong>OBSERVABILITY</strong></span>
        <span>STATIC <strong>VERIFICATION</strong></span>
        <span>ZERO <strong>EXECUTION</strong></span>
        <span>DETERMINISTIC <strong>EVIDENCE</strong></span>
        <span>MODEL <strong>CONTEXT PROTOCOL</strong></span>
        <span>PARADOX <strong>OBSERVABILITY</strong></span>
        <span>STATIC <strong>VERIFICATION</strong></span>
        <span>ZERO <strong>EXECUTION</strong></span>
        <span>DETERMINISTIC <strong>EVIDENCE</strong></span>
        <span>MODEL <strong>CONTEXT PROTOCOL</strong></span>
      </div>
    </div>

    <!-- Chapter 02: Editorial Decision Architecture Rail (OBSERVE) -->
    <section class="editorial-section" data-chapter="OBSERVE">
      <div class="editorial-section-header">
        <span class="section-num">02 // EVIDENCE_ARCHITECTURE</span>
        <h2 class="editorial-section-title" data-kinetic>Deterministic signals. Zero guesswork.</h2>
      </div>

      <div class="horizontal-track-wrapper">
        <div class="horizontal-track-pin">
          <div class="horizontal-track-inner">
            <article class="editorial-card spotlight-card" data-cursor="EVIDENCE">
              <span class="card-num">01</span>
              <span class="card-category">DECISION ARCHITECTURE</span>
              <h3>Evidence First</h3>
              <p>Scores are anchored in public commit histories, release provenance, and manifests. No subjective marketing claims or speculative hype.</p>
            </article>

            <article class="editorial-card spotlight-card" data-cursor="ISOLATION">
              <span class="card-num">02</span>
              <span class="card-category">ISOLATION CORE</span>
              <h3>Zero Code Run</h3>
              <p>Target repository install scripts, Dockerfiles, and binary payloads are never executed. Pure deterministic static AST parsing behind an immutable boundary.</p>
            </article>

            <article class="editorial-card spotlight-card" data-cursor="VELOCITY">
              <span class="card-num">03</span>
              <span class="card-category">SIGNAL VELOCITY</span>
              <h3>Live Health & Risk</h3>
              <p>Detection of abandoned codebases, unpinned transitive dependencies, credential access heuristics, and remote shell execution vectors.</p>
            </article>

            <article class="editorial-card spotlight-card" data-cursor="MATRIX">
              <span class="card-num">04</span>
              <span class="card-category">COMPARISON ENGINE</span>
              <h3>Side-by-Side Matrix</h3>
              <p>Direct mathematical alignment of competing frameworks across maintenance freshness, stars, releases, and vulnerability vectors.</p>
            </article>

            <article class="editorial-card spotlight-card" data-cursor="REASONING">
              <span class="card-num">05</span>
              <span class="card-category">PROTOCOL VERIFICATION</span>
              <h3>Verified Manifests</h3>
              <p>Comprehensive AST analysis extracting Model Context Protocol (MCP) definitions, tool exports, and agent capabilities in sub-millisecond execution.</p>
            </article>
          </div>
          <div class="horizontal-progress-bar" id="trackProgress"></div>
        </div>
      </div>
    </section>

    <!-- Chapter 03: Precision Verification Portal (VERIFY) -->
    <section class="editorial-section" data-chapter="VERIFY">
      <div class="editorial-section-header">
        <span class="section-num">03 // VERIFICATION_PORTAL</span>
        <h2 class="editorial-section-title" data-kinetic>Inspect any public repository.</h2>
      </div>

      <div class="verify-terminal-box">
        <div class="verify-terminal-header">
          <span>STATIC AST SCANNER // PUBLIC REPOSITORY EVALUATION</span>
          <span class="status-indicator">READY</span>
        </div>

        <form class="verify-input-row" method="get" action="/verify/">
          <input 
            type="text" 
            name="url" 
            placeholder="Paste GitHub URL (e.g. https://github.com/langchain-ai/langgraph)" 
            autocomplete="off"
            required 
          />
          <button type="submit" class="btn btn-primary" data-cursor="INSPECT">Verify Now →</button>
        </form>

        <div class="verify-heuristics-grid">
          <div class="heuristic-item">
            <span class="heuristic-label">LOCKFILE PARITY</span>
            <span class="heuristic-val">SHA256 Manifest Proof</span>
          </div>
          <div class="heuristic-item">
            <span class="heuristic-label">EXECUTION SAFETY</span>
            <span class="heuristic-val">Static Sandbox Isolation</span>
          </div>
          <div class="heuristic-item">
            <span class="heuristic-label">FRESHNESS DELTA</span>
            <span class="heuristic-val">Commit Velocity Bounds</span>
          </div>
          <div class="heuristic-item">
            <span class="heuristic-label">MCP CAPABILITIES</span>
            <span class="heuristic-val">Direct Tool Definition Parser</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Chapter 04: Indexed Agent Atlas (ATLAS) -->
    <section class="editorial-section" data-chapter="ATLAS">
      <div class="editorial-section-header-split">
        <div>
          <span class="section-num">04 // AGENT_ATLAS</span>
          <h2 class="editorial-section-title" data-kinetic>Featured Public Agent Repositories</h2>
        </div>
        <a href="/agents/" class="btn btn-ghost" data-cursor="EXPLORE">Explore Full Atlas →</a>
      </div>

      <div class="editorial-catalog-grid">
        {featured.map((e) => (
          <article class="catalog-entry spotlight-card" data-cursor="INSPECT">
            <div class="entry-meta">
              <span class="chip chip-accent">{e.category}</span>
              <span class="entry-owner">{e.owner}</span>
            </div>
            <h3 class="entry-title">{e.repo}</h3>
            <p class="entry-desc">{e.summary}</p>
            <div class="entry-links">
              <a href={`/agents/${e.owner}/${e.repo}/`} class="entry-link-primary">Inspect Profile →</a>
              <a href={`/verify/?url=${encodeURIComponent(`https://github.com/${e.owner}/${e.repo}`)}`} class="entry-link-subtle">Run Verifier ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Chapter 05: Practical Developer Studio (STUDIO) -->
    <section class="editorial-section" data-chapter="STUDIO" id="ai-tools">
      <div class="editorial-section-header-split">
        <div>
          <span class="section-num">05 // DEVELOPER_STUDIO</span>
          <h2 class="editorial-section-title" data-kinetic>Practical Developer AI Tools</h2>
        </div>
        <a href="/ai/" class="btn btn-primary" data-cursor="STUDIO">Open Studio ↗</a>
      </div>

      <div class="editorial-tools-grid">
        {featuredTools.map((tool, i) => (
          <a class="tool-entry spotlight-card" href={`/ai/${tool.slug}/`} data-cursor="LAUNCH">
            <div class="tool-entry-meta">
              <span class="tool-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="tool-arrow">↗</span>
            </div>
            <strong class="tool-name">{tool.label}</strong>
            <p class="tool-desc">{tool.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Chapter 06: Final Statement — Meditative Void (VOID) -->
    <section class="editorial-void-section" data-chapter="VOID">
      <div class="void-content">
        <span class="void-kicker">[ 06 // RESOLUTION ]</span>
        <h2 class="void-title" data-kinetic>
          BETTER EVIDENCE.<br />
          BETTER DECISIONS.
        </h2>
        <p class="void-lead">
          Stop evaluating agents on marketing claims. Inspect deterministic commit histories, release provenance, and static AST risk signals.
        </p>
        <div class="void-actions">
          <a href="/verify/" class="btn btn-primary btn-lg" data-cursor="VERIFY">Inspect Repository Now →</a>
          <a href="/agents/" class="btn btn-ghost btn-lg" data-cursor="ATLAS">Explore Agent Atlas ↗</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
