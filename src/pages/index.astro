---
import MakerLayout from '../layouts/MakerLayout.astro';
import utilityOpportunities from '../data/utility-opportunities.json';
import aiTools from '../data/ai-tools.json';

const hot = [
  {icon:'⌘', title:'Image Compressor', desc:'Shrink JPG, PNG & WebP files in your browser.', href:'/utilities/image-compressor/', tag:'IMAGE'},
  {icon:'▣', title:'QR Code Generator', desc:'Create a QR code for any link or text.', href:'/utilities/qr-code-generator/', tag:'QR'},
  {icon:'{}', title:'JSON Formatter', desc:'Format, validate and copy JSON instantly.', href:'/utilities/json-formatter/', tag:'DEV'},
  {icon:'●', title:'Password Generator', desc:'Generate strong random passwords locally.', href:'/utilities/password-generator/', tag:'SECURITY'},
  {icon:'₹', title:'EMI Calculator', desc:'Calculate monthly loan payments and interest.', href:'/utilities/emi-calculator/', tag:'MONEY'},
  {icon:'%', title:'GST Calculator', desc:'Add or remove GST from any amount.', href:'/utilities/gst-calculator/', tag:'INDIA'},
  {icon:'↗', title:'SIP Calculator', desc:'Estimate returns on a monthly investment.', href:'/utilities/sip-calculator/', tag:'MONEY'},
  {icon:'BMI', title:'BMI Calculator', desc:'Calculate BMI and understand your range.', href:'/utilities/bmi-calculator/', tag:'HEALTH'},
  {icon:'T', title:'Word Counter', desc:'Words, characters, lines and reading time.', href:'/utilities/word-counter/', tag:'TEXT'},
  {icon:'↔', title:'PDF & Image Tools', desc:'Fast browser utilities for everyday files.', href:'/utilities/', tag:'LIBRARY'}
];

const categories=[
 {n:'01',label:'IMAGE',desc:'Compress, resize, convert',href:'/utilities/',items:['Image Compressor','Image Resizer','JPG to PDF']},
 {n:'02',label:'PDF',desc:'Work with documents',href:'/utilities/',items:['Compress PDF','Merge PDF','PDF to JPG']},
 {n:'03',label:'MONEY',desc:'Calculate before you decide',href:'/utilities/',items:['EMI Calculator','SIP Calculator','GST Calculator']},
 {n:'04',label:'AI + DEV',desc:'Build and clean faster',href:'/ai/',items:['JSON Formatter','Token Counter','Prompt Tools']}
];
---
<MakerLayout title="PARADOX — Free tools for real work" description="Free online tools for images, PDF, money, AI, text and developer tasks. Fast, private and no signup.">
<main class="v2-home">
  <section class="v2-hero">
    <div class="v2-meta"><span>PARADOX / 2026</span><span>FREE UTILITY INDEX</span><span>NO SIGNUP · LOCAL-FIRST</span></div>
    <div class="v2-hero-grid">
      <div>
        <p class="v2-kicker"><i></i> THE INTERNET'S SMALL JOBS, IN ONE PLACE</p>
        <h1>Do the<br/><em>thing.</em></h1>
        <p class="v2-lead">Compress an image. Calculate a loan. Format JSON. Make a QR code. Generate a password. No accounts, no friction, no twenty-tab hunt.</p>
        <div class="v2-search"><span>⌕</span><input id="v2Search" placeholder="What do you need to do?" aria-label="Search PARADOX tools"/><kbd>/</kbd></div>
        <div class="v2-pills"><a href="#popular">Popular tools ↓</a><a href="/utilities/">Browse 100+ utilities ↗</a><a href="/ai/">AI toolkit ↗</a></div>
      </div>
      <div class="v2-orbit" aria-hidden="true">
        <div class="orbit-ring ring-a"></div><div class="orbit-ring ring-b"></div>
        <div class="orbit-core"><span>PX</span><small>TOOLS<br/>ENGINE</small></div>
        <div class="orbit-label l1">IMAGE</div><div class="orbit-label l2">MONEY</div><div class="orbit-label l3">AI</div><div class="orbit-label l4">TEXT</div>
      </div>
    </div>
    <div class="v2-ticker"><span>01</span><strong>UTILITY INDEX</strong><span>BUILT FOR SPEED</span><span>FILES STAY LOCAL WHEN POSSIBLE</span><span>FREE FOREVER</span><span>02</span><strong>UTILITY INDEX</strong></div>
  </section>

  <section class="v2-section" id="popular">
    <div class="v2-section-head"><div><span class="v2-number">01</span><h2>People need<br/><em>these.</em></h2></div><p>High-intent utilities are the front door. Every tool below is a real interaction, not a keyword page.</p></div>
    <div class="v2-hot-grid">{hot.map((tool,i)=><a class="v2-hot" href={tool.href} data-v2-search={(tool.title+' '+tool.desc+' '+tool.tag).toLowerCase()}><span class="v2-hot-no">{String(i+1).padStart(2,'0')}</span><span class="v2-hot-icon">{tool.icon}</span><span class="v2-hot-tag">{tool.tag}</span><h3>{tool.title}</h3><p>{tool.desc}</p><b>Open tool <span>↗</span></b></a>)}</div>
    <div id="v2Empty" hidden class="v2-empty">Nothing found. <a href="/utilities/">Open the full utility index →</a></div>
  </section>

  <section class="v2-marquee"><span>IMAGE</span><b>×</b><span>PDF</span><b>×</b><span>MONEY</span><b>×</b><span>AI</span><b>×</b><span>DEVELOPER</span><b>×</b><span>TEXT</span><b>×</b><span>IMAGE</span><b>×</b><span>PDF</span></section>

  <section class="v2-section v2-categories">
    <div class="v2-section-head"><div><span class="v2-number">02</span><h2>Pick a<br/><em>world.</em></h2></div><p>Four high-intent clusters. Enter the category, finish the job, leave.</p></div>
    <div class="v2-category-grid">{categories.map(c=><a href={c.href} class="v2-category"><span>{c.n}</span><div><small>{c.label}</small><h3>{c.desc}</h3><p>{c.items.join(' · ')}</p></div><strong>↗</strong></a>)}</div>
  </section>

  <section class="v2-ai">
    <div class="v2-ai-copy"><span class="v2-number">03 / AI</span><h2>AI is useful<br/><em>when it ships.</em></h2><p>Prompt builders, token tools, JSON utilities, cost calculators and developer helpers that run without an API key.</p><a href="/ai/" class="v2-button">ENTER AI LAB ↗</a></div>
    <div class="v2-ai-stack">{aiTools.slice(0,5).map((t,i)=><a href={'/ai/'+t.slug+'/'}><span>{String(i+1).padStart(2,'0')}</span><b>{t.label}</b><small>{t.description}</small><strong>↗</strong></a>)}</div>
  </section>

  <section class="v2-section v2-return">
    <div class="v2-return-card"><span>THE PARADOX LOOP</span><h2>Find it.<br/><em>Use it.</em><br/>Come back.</h2><p>Daily challenges, live signals and a growing index give PARADOX a reason to be useful beyond one search.</p><div><a href="/daily/">Daily ↗</a><a href="/trending/">Trending ↗</a><a href="/world/">World ↗</a><a href="/ai-radar/">AI Radar ↗</a></div></div>
  </section>
</main>
<script is:inline>
(()=>{const i=document.querySelector('#v2Search'),cards=[...document.querySelectorAll('[data-v2-search]')],e=document.querySelector('#v2Empty');if(!i)return;const run=()=>{const q=i.value.trim().toLowerCase();let n=0;cards.forEach(c=>{const ok=!q||c.dataset.v2Search.includes(q);c.hidden=!ok;if(ok)n++});e.hidden=!!n||!q};i.addEventListener('input',run);addEventListener('keydown',x=>{if(x.key==='/'&&!/INPUT|TEXTAREA/.test(document.activeElement.tagName)){x.preventDefault();i.focus()}})})();
</script>
<style>
.v2-home{--v2-black:#0b0d0d;--v2-paper:#f4f1e8;--v2-acid:#d9ff3f;--v2-red:#ff5638;--v2-grey:#777970;max-width:1440px;margin:auto;background:var(--v2-paper);color:var(--v2-black);overflow:hidden}
.v2-hero{min-height:100svh;padding:22px clamp(18px,4vw,62px) 0;display:flex;flex-direction:column;background:var(--v2-paper)}
.v2-meta{display:flex;justify-content:space-between;border-bottom:1px solid #aaa79e;padding-bottom:13px;font:9px 'DM Mono',monospace;letter-spacing:.13em}
.v2-hero-grid{display:grid;grid-template-columns:1.15fr .85fr;align-items:center;flex:1;gap:5vw;padding:6vh 0}
.v2-kicker{font:10px 'DM Mono',monospace;letter-spacing:.16em;margin:0 0 25px}.v2-kicker i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--v2-red);margin-right:8px}
.v2-hero h1{font:700 clamp(90px,14vw,210px)/.72 'DM Sans',sans-serif;letter-spacing:-.09em;margin:0 0 42px}.v2-hero h1 em,.v2-section h2 em,.v2-ai h2 em,.v2-return-card h2 em{font-family:'Instrument Serif',serif;font-weight:400;letter-spacing:-.06em}
.v2-lead{max-width:590px;font-size:clamp(15px,1.4vw,19px);line-height:1.5;color:#4f514c}
.v2-search{display:flex;align-items:center;gap:12px;height:70px;max-width:690px;margin-top:30px;border:1px solid var(--v2-black);background:#fffdf7;padding:0 18px;box-shadow:9px 9px 0 var(--v2-black);transition:.2s}.v2-search:focus-within{transform:translate(-4px,-4px);box-shadow:13px 13px 0 var(--v2-acid)}.v2-search span{font-size:28px}.v2-search input{border:0;outline:0;background:transparent;width:100%;font-size:16px}.v2-search kbd{font:9px 'DM Mono';border:1px solid #bbb;padding:5px 8px}
.v2-pills{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.v2-pills a,.v2-button{font:9px 'DM Mono',monospace;letter-spacing:.1em;border:1px solid var(--v2-black);padding:10px 13px}.v2-pills a:hover{background:var(--v2-black);color:white}
.v2-orbit{height:min(44vw,560px);min-height:350px;position:relative;display:grid;place-items:center}.orbit-ring{position:absolute;border:1px solid #b7b5ad;border-radius:50%;transform:rotate(-25deg)}.ring-a{width:86%;height:48%}.ring-b{width:68%;height:72%;transform:rotate(65deg)}.orbit-core{width:155px;height:155px;border-radius:50%;background:var(--v2-black);color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:15px 15px 0 var(--v2-red);z-index:2}.orbit-core span{font:700 45px 'DM Sans';letter-spacing:-.08em}.orbit-core small{font:8px 'DM Mono';line-height:1.2;letter-spacing:.14em;color:#aaa}.orbit-label{position:absolute;font:9px 'DM Mono';border:1px solid var(--v2-black);padding:8px;background:var(--v2-paper)}.l1{top:14%;left:12%}.l2{top:23%;right:6%}.l3{bottom:18%;left:7%}.l4{bottom:11%;right:15%}
.v2-ticker{height:45px;margin:0 -62px;background:var(--v2-black);color:white;display:flex;align-items:center;gap:24px;white-space:nowrap;overflow:hidden;font:9px 'DM Mono';letter-spacing:.12em}.v2-ticker strong{color:var(--v2-acid)}.v2-ticker span,.v2-ticker b{padding-left:18px}
.v2-section{padding:clamp(90px,11vw,170px) clamp(18px,4vw,62px)}.v2-section-head{display:grid;grid-template-columns:1fr .55fr;gap:5vw;align-items:end;margin-bottom:55px}.v2-number{font:9px 'DM Mono';letter-spacing:.15em;color:var(--v2-red)}.v2-section h2{font:700 clamp(62px,8vw,120px)/.8 'DM Sans';letter-spacing:-.075em;margin:18px 0 0}.v2-section-head p{max-width:420px;color:#60615b;line-height:1.6}
.v2-hot-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#bbb8ae;border:1px solid #bbb8ae}.v2-hot{min-height:310px;padding:22px;background:#faf8f1;display:flex;flex-direction:column;position:relative;transition:transform .25s,background .25s}.v2-hot:hover{background:white;transform:translateY(-7px);z-index:2}.v2-hot-no{font:9px 'DM Mono';color:#8c8d86}.v2-hot-icon{font:34px 'DM Mono';margin-top:55px}.v2-hot-tag{position:absolute;right:18px;top:20px;font:8px 'DM Mono';padding:5px 7px;border:1px solid #bbb8ae}.v2-hot h3{font-size:19px;margin:18px 0 5px;letter-spacing:-.03em}.v2-hot p{font-size:12px;line-height:1.45;color:#777970;margin:0}.v2-hot b{margin-top:auto;font:9px 'DM Mono';letter-spacing:.08em}.v2-hot b span{color:var(--v2-red);font-size:14px}
.v2-marquee{background:var(--v2-acid);height:80px;display:flex;align-items:center;justify-content:space-around;overflow:hidden;white-space:nowrap;font:700 clamp(18px,3vw,38px) 'DM Sans';letter-spacing:-.06em}.v2-marquee b{font-weight:400}
.v2-category-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid #aaa79e}.v2-category{display:grid;grid-template-columns:60px 1fr 40px;gap:15px;padding:25px 10px;border-bottom:1px solid #aaa79e;transition:.2s}.v2-category:hover{background:#fff}.v2-category>span{font:10px 'DM Mono';color:var(--v2-red)}.v2-category small{font:9px 'DM Mono';letter-spacing:.12em}.v2-category h3{font-size:24px;margin:8px 0}.v2-category p{font:11px 'DM Mono';color:#777970}.v2-category strong{font:22px 'DM Mono';align-self:center}
.v2-ai{background:var(--v2-black);color:white;padding:clamp(70px,10vw,150px) clamp(18px,4vw,62px);display:grid;grid-template-columns:1fr 1fr;gap:7vw}.v2-ai h2{font:700 clamp(62px,7vw,110px)/.8 'DM Sans';letter-spacing:-.07em;margin:20px 0}.v2-ai-copy p{max-width:470px;color:#9da09a;line-height:1.6;margin-bottom:32px}.v2-button{display:inline-block;border-color:#666}.v2-button:hover{background:white;color:black}.v2-ai-stack{border-top:1px solid #383b38}.v2-ai-stack a{display:grid;grid-template-columns:38px 1fr auto;gap:12px;align-items:center;padding:19px 0;border-bottom:1px solid #383b38;color:white}.v2-ai-stack span{font:9px 'DM Mono';color:#666}.v2-ai-stack b{font-size:15px}.v2-ai-stack small{grid-column:2;font-size:11px;color:#858982}.v2-ai-stack strong{grid-column:3;grid-row:1/3}.v2-ai-stack a:hover{color:var(--v2-acid)}
.v2-return{background:#e9e5da}.v2-return-card{border-top:2px solid var(--v2-black);padding-top:25px;max-width:1100px}.v2-return-card>span{font:9px 'DM Mono';letter-spacing:.12em}.v2-return-card h2{font:700 clamp(70px,10vw,145px)/.72 'DM Sans';letter-spacing:-.08em;margin:35px 0}.v2-return-card p{max-width:470px;color:#64665f}.v2-return-card>div{display:flex;flex-wrap:wrap;gap:1px;margin-top:40px}.v2-return-card a{padding:13px 18px;border:1px solid #aaa79e;font:9px 'DM Mono'}.v2-return-card a:hover{background:var(--v2-black);color:white}.v2-empty{padding:35px;border:1px dashed #aaa79e}.v2-empty a{text-decoration:underline}
.v2-hot[hidden]{display:none}
@media(max-width:900px){.v2-hero-grid,.v2-ai,.v2-section-head{grid-template-columns:1fr}.v2-orbit{height:420px}.v2-hot-grid{grid-template-columns:repeat(2,1fr)}.v2-ticker{margin:0 -18px}.v2-section-head{gap:25px}}
@media(max-width:560px){.v2-meta span:nth-child(2){display:none}.v2-hero{padding-top:16px}.v2-hero h1{font-size:clamp(80px,24vw,120px)}.v2-orbit{min-height:290px;height:290px}.orbit-core{width:120px;height:120px}.orbit-core span{font-size:34px}.v2-hot-grid{grid-template-columns:1fr}.v2-hot{min-height:245px}.v2-hot-icon{margin-top:30px}.v2-category-grid{grid-template-columns:1fr}.v2-category h3{font-size:19px}.v2-ai-stack small{display:none}}
</style>
</MakerLayout>