---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalog from '../data/catalog.json';
import tools from '../data/ai-tools.json';

const featured = catalog.slice(0, 8);
const featuredTools = tools.slice(0, 6);
---

<BaseLayout 
  title="PARADOX — Observable AI Agent Intelligence & Trust Signals" 
  description="Discover, inspect, compare and evaluate public AI agents and GitHub projects using observable repository evidence before you depend on them."
>
  <main class="home-brutalist">
    <!-- Chapter 01: High-Contrast Editorial Hero + Interactive 3D Paradox Core Stage -->
    <section class="hero-cinematic">
      <div class="hero-inner">
        <div class="hero-meta-strip">
          <div class="meta-tag">
            <span class="dot-pulse"></span>
            <span>PARADOX // OBSERVABLE INTELLIGENCE PLATFORM</span>
          </div>
          <div class="meta-coords">PROTOCOL: DETERMINISTIC_EVIDENCE · WEBGL2 · 120 FPS</div>
        </div>

        <div class="hero-stage-layout">
          <!-- Left Column: Editorial Statement & Actions -->
          <div class="hero-editorial">
            <div class="hero-statement-kicker">[ CHAPTER 01 // THE THESIS ]</div>
            <h1 class="hero-giant-title" data-kinetic data-hero-kinetic>
              OBSERVE WHAT<br />
              OTHERS <span class="text-electric">ASSUME.</span>
            </h1>
            <p class="hero-lead-text">
              Inspect public AI agents, MCP tooling and GitHub repositories using deterministic AST evidence before you depend on them. Zero code run. Mathematical proof.
            </p>

            <div class="hero-cta-row">
              <a href="/verify/" class="btn btn-primary" data-cursor="VERIFY">
                <span>Inspect Repository →</span>
              </a>
              <a href="/compare/" class="btn btn-ghost" data-cursor="COMPARE">
                <span>Compare Matrix →</span>
              </a>
            </div>

            <form class="search-bar-unified" method="get" action="/agents/">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--signal); margin-right: 8px;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input id="homeQuery" name="q" type="search" placeholder="Search 20+ public agent frameworks, MCP servers, LangGraph..." autocomplete="off" />
              <div class="shortcut-hint">⌘K</div>
              <button type="submit" class="btn btn-emerald btn-sm" data-cursor="SEARCH">SEARCH</button>
            </form>

            <div class="hero-chips" aria-label="Suggested searches">
              <span class="chips-label">INDEX:</span>
              <a href="/agents/?q=mcp" data-cursor="MCP">MCP Servers</a>
              <a href="/agents/?q=coding+agent" data-cursor="CODING">Coding Agents</a>
              <a href="/agents/?q=claude+skill" data-cursor="SKILL">Claude Skills</a>
              <a href="/agents/?q=browser+automation" data-cursor="BROWSER">Browser Automation</a>
            </div>
          </div>

          <!-- Right Column: Interactive 3D Paradox Core Stage -->
          <div class="hero-3d-stage hud-corners" data-cursor="DRAG 3D">
            <div class="stage-header">
              <div class="stage-tag">
                <span class="dot-pulse"></span>
                <span>[ PARADOX CORE ] — EVIDENCE TOPOLOGY</span>
              </div>
              <div class="stage-badge" id="stageFpsBadge">120 FPS // STABLE</div>
            </div>

            <!-- Viewport Drag Surface -->
            <div class="stage-viewport" id="heroStageViewport">
              <div class="stage-overlay-reticle" aria-hidden="true"></div>
              <div class="stage-drag-hint">
                <span>DRAG TO ORBIT CORE ↺</span>
              </div>
            </div>

            <!-- Stage HUD Telemetry & Controls -->
            <div class="stage-hud-footer">
              <div class="stage-modes" role="group" aria-label="Core Geometry Mode">
                <button type="button" class="stage-mode-btn is-active" data-mode="core" data-cursor="CORE">01 // CORE</button>
                <button type="button" class="stage-mode-btn" data-mode="network" data-cursor="NETWORK">02 // NETWORK</button>
                <button type="button" class="stage-mode-btn" data-mode="tunnel" data-cursor="TUNNEL">03 // TUNNEL</button>
              </div>
              <div class="stage-telemetry">
                <span id="stageAngles">RX: 11.4° RY: 22.9°</span>
                <button type="button" class="stage-pulse-btn" id="stagePulseBtn" data-cursor="PULSE">PULSE ⟡</button>
              </div>
            </div>
          </div>
        </div>

        <div class="hero-scroll-cue">
          <span class="scroll-cue-line"></span>
          <span>SCROLL TO ADVANCE NARRATIVE ↓</span>
        </div>
      </div>
    </section>

    <!-- Continuous High-Octane Marquee Strip (Lando Norris Signature) -->
    <div class="marquee-strip" aria-hidden="true">
      <div class="marquee-content">
        <span>PARADOX <strong>INTELLIGENCE</strong></span>
        <span>STATIC <strong>VERIFICATION</strong></span>
        <span>ZERO <strong>CODE EXECUTION</strong></span>
        <span>DETERMINISTIC <strong>EVIDENCE</strong></span>
        <span>AI <strong>OBSERVABILITY</strong></span>
        <span>PARADOX <strong>INTELLIGENCE</strong></span>
        <span>STATIC <strong>VERIFICATION</strong></span>
        <span>ZERO <strong>CODE EXECUTION</strong></span>
        <span>DETERMINISTIC <strong>EVIDENCE</strong></span>
        <span>AI <strong>OBSERVABILITY</strong></span>
      </div>
    </div>

    <!-- Chapter 02: Pinned Horizontal Decision Rail (Evidence Architecture) -->
    <section class="horizontal-track-wrapper">
      <div class="horizontal-track-header">
        <div>
          <span class="section-kicker">[ 02 // EVIDENCE_ARCHITECTURE ]</span>
          <h2 class="section-title" data-kinetic>Deterministic signals. Zero guesswork.</h2>
        </div>
        <div style="font-family: var(--font-mono); font-size: 11px; color: var(--signal); display: flex; align-items: center; gap: 8px;">
          <span class="dot-pulse"></span>
          <span>SCROLL DOWN TO ADVANCE RAIL →</span>
        </div>
      </div>

      <div class="horizontal-track-pin">
        <div class="horizontal-track-inner">
          <article class="horizontal-card spotlight-card hud-corners" data-cursor="EVIDENCE">
            <div class="horizontal-card-num">01</div>
            <span class="card-kicker">DECISION ARCHITECTURE</span>
            <h3>Evidence First</h3>
            <p>Every score is anchored exclusively in public commit histories, release provenance, and manifests. No subjective marketing claims or hype.</p>
          </article>

          <article class="horizontal-card spotlight-card hud-corners" data-cursor="ISOLATION">
            <div class="horizontal-card-num">02</div>
            <span class="card-kicker">ISOLATION CORE</span>
            <h3>Zero Code Run</h3>
            <p>Target repository install scripts, Dockerfiles, and binary payloads are never executed. Pure deterministic static AST parsing behind an immutable boundary.</p>
          </article>

          <article class="horizontal-card spotlight-card hud-corners" data-cursor="VELOCITY">
            <div class="horizontal-card-num">03</div>
            <span class="card-kicker">SIGNAL VELOCITY</span>
            <h3>Live Health & Risk</h3>
            <p>Real-time detection of abandoned codebases, unpinned transitive dependencies, credential access heuristics, and remote shell calls.</p>
          </article>

          <article class="horizontal-card spotlight-card hud-corners" data-cursor="MATRIX">
            <div class="horizontal-card-num">04</div>
            <span class="card-kicker">COMPARISON ENGINE</span>
            <h3>Side-by-Side Matrix</h3>
            <p>Direct mathematical alignment of competing frameworks across maintenance freshness, stars, releases, and vulnerability vectors.</p>
          </article>

          <article class="horizontal-card spotlight-card hud-corners" data-cursor="REASONING">
            <div class="horizontal-card-num">05</div>
            <span class="card-kicker">PROTOCOL VERIFICATION</span>
            <h3>Verified Manifests</h3>
            <p>Comprehensive AST analysis extracting Model Context Protocol (MCP) definitions, tool exports, and agent capabilities in sub-millisecond execution.</p>
          </article>
        </div>
        <div class="horizontal-progress-bar" id="trackProgress"></div>
      </div>
    </section>

    <!-- Chapter 03: Tactical Cyber Radar Station & Static Verifier Preview -->
    <section class="section-brutalist skewable">
      <div class="radar-station-frame hud-corners">
        <div class="radar-station-top">
          <div class="radar-station-title">
            <span class="dot-pulse"></span>
            <span>[ 03 // VERIFY_TERMINAL ] — REPOSITORY EVIDENCE SCAN</span>
          </div>
          <div class="radar-station-meta">AZIMUTH: 184.2° // FREQ: 433.92 MHz // 120 FPS</div>
        </div>

        <div class="radar-station-content">
          <div class="pv-hero-visual" aria-label="Agent intelligence radar visualization">
            <div class="pv-orbit"></div>
            <div class="pv-sweep"></div>
            <div class="pv-ping"></div>
            
            <div class="pv-core">
              <span>PX</span>
            </div>

            <div class="pv-node n1">
              <b>REPOSITORY</b>
              <span>evidence indexed</span>
            </div>
            <div class="pv-node n2">
              <b>RISK SIGNAL</b>
              <span>static scan</span>
            </div>
            <div class="pv-node n3">
              <b>FRESHNESS</b>
              <span>commit velocity</span>
            </div>
            <div class="pv-node n4">
              <b>STACK</b>
              <span>dependencies</span>
            </div>
          </div>

          <div class="radar-station-telemetry">
            <div class="hud-stream">
              <div class="hud-line"><span class="hud-time">SYSTEM:</span> <span class="hud-glyph">█</span> <span class="hud-msg">PARADOX radar active on 20 public agent categories</span></div>
              <div class="hud-line"><span class="hud-time">SECURITY:</span> <span class="hud-glyph">▓</span> <span class="hud-msg">Zero execution boundary confirmed immutable</span></div>
              <div class="hud-line"><span class="hud-time">ANALYSIS:</span> <span class="hud-glyph">▒</span> <span class="hud-msg">Deterministic GitHub API heuristics verified</span></div>
              <div class="hud-line"><span class="hud-time">LATENCY:</span> <span class="hud-glyph">░</span> <span class="hud-msg">0.8ms average static evidence resolution</span></div>
            </div>
            <div style="margin-top: 20px;">
              <a href="/verify/" class="btn btn-primary" data-cursor="SCAN">
                <span>Launch Full Inspection Terminal →</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Chapter 04: Indexed Agent Atlas (Featured Repositories) -->
    <section class="section-brutalist skewable">
      <div class="section-header-split">
        <div>
          <span class="section-kicker">[ 04 // AGENT_ATLAS_INDEX ]</span>
          <h2 class="section-title" data-kinetic>Featured Agent Repositories</h2>
        </div>
        <a href="/agents/" class="btn btn-ghost" data-cursor="EXPLORE">Explore All Agents →</a>
      </div>

      <div class="grid-agents">
        {featured.map((e) => (
          <article class="agent-card spotlight-card hud-corners" data-cursor="INSPECT">
            <div class="meta" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <span class="chip chip-accent">{e.category}</span>
              <span style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);">{e.owner}</span>
            </div>
            <h3 style="font-size: 20px; font-weight: 700; margin: 6px 0; font-family: var(--font-display);">{e.repo}</h3>
            <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin: 8px 0 16px;">{e.summary}</p>
            <div class="links" style="display: flex; gap: 12px; margin-top: auto; font-family: var(--font-mono); font-size: 11px; font-weight: 700;">
              <a href={`/agents/${e.owner}/${e.repo}/`} style="color: var(--accent); text-decoration: none;">Inspect Profile →</a>
              <a href={`/verify/?url=${encodeURIComponent(`https://github.com/${e.owner}/${e.repo}`)}`} style="color: var(--text-muted); text-decoration: none;">Run Verifier ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Chapter 05: Practical Developer Studio -->
    <section class="section-brutalist skewable" id="ai-tools">
      <div class="section-header-split">
        <div>
          <span class="section-kicker">[ 05 // DEVELOPER_STUDIO ]</span>
          <h2 class="section-title" data-kinetic>Practical Developer AI Tools</h2>
        </div>
        <a href="/ai/" class="btn btn-emerald" data-cursor="STUDIO">Open Studio ↗</a>
      </div>

      <div class="tools-grid">
        {featuredTools.map((tool, i) => (
          <a class="tool-brutalist-card spotlight-card hud-corners" href={`/ai/${tool.slug}/`} data-cursor="LAUNCH">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <span style="font-family: var(--font-mono); font-size: 11px; color: var(--signal); font-weight: 800;">{String(i + 1).padStart(2, '0')} // STUDIO_TOOL</span>
              <span class="tool-arrow">↗</span>
            </div>
            <strong style="font-size: 18px; font-family: var(--font-display); color: #ffffff; display: block; margin-bottom: 6px;">{tool.label}</strong>
            <p style="font-size: 13px; color: var(--text-secondary); margin: 0; line-height: 1.5;">{tool.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Chapter 06: Final Statement — Visual Silence (Report Standard) -->
    <section class="section-silence skewable">
      <div class="silence-inner">
        <span class="silence-kicker">[ 06 // SYSTEM_RESOLUTION ]</span>
        <h2 class="silence-title" data-kinetic>
          BETTER EVIDENCE.<br />
          <span class="text-electric">BETTER DECISIONS.</span>
        </h2>
        <p class="silence-lead">
          Stop evaluating agents on marketing promises. Start inspecting deterministic commit logs, release provenance, and AST risk signals.
        </p>
        <div class="silence-actions">
          <a href="/verify/" class="btn btn-primary btn-lg" data-cursor="VERIFY">Inspect Repository Now →</a>
          <a href="/agents/" class="btn btn-ghost btn-lg" data-cursor="ATLAS">Open Agent Atlas ↗</a>
        </div>
      </div>
    </section>
  </main>

  <script>
    // Hero 3D Stage HUD Controls & Real-time Telemetry
    if (typeof window !== 'undefined') {
      const modeButtons = document.querySelectorAll<HTMLButtonElement>('.stage-mode-btn');
      const pulseBtn = document.querySelector<HTMLButtonElement>('#stagePulseBtn');
      const anglesEl = document.querySelector<HTMLElement>('#stageAngles');

      modeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          modeButtons.forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          const mode = btn.getAttribute('data-mode') as any;
          if (window.paradoxWebGL && mode) {
            window.paradoxWebGL.setMode(mode);
          }
        });
      });

      if (pulseBtn) {
        pulseBtn.addEventListener('click', () => {
          if (window.paradoxWebGL) {
            window.paradoxWebGL.triggerImpulse();
          }
        });
      }

      // Telemetry Polling at 30Hz
      setInterval(() => {
        if (window.paradoxWebGL && anglesEl) {
          const t = window.paradoxWebGL.getTelemetry();
          if (t) {
            anglesEl.textContent = `RX: ${t.rx}° RY: ${t.ry}°`;
          }
        }
      }, 66);
    }
  </script>
</BaseLayout>

