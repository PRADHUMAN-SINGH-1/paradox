---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalog from '../data/catalog.json';
import { CATEGORIES } from '../lib/catalog.ts';
import tools from '../data/ai-tools.json';

const featured = catalog.slice(0, 8);
const featuredTools = tools.slice(0, 6);

---

<BaseLayout 
  title="PARADOX — AI Agent Intelligence & Trust Signals" 
  description="Discover, inspect, compare and evaluate public AI agents and GitHub projects using observable repository evidence before you depend on them."
>
  <main class="home-container" style="max-width: var(--max-w-content); margin: 0 auto; padding: 0 24px;">
    <!-- High-Impact Hero Section -->
    <section class="hero-home">
      <div class="hero-copy animate-fade-slide-up">
        <div class="hero-eyebrow">
          <span class="dot-pulse"></span>
          <span>INTELLIGENCE ENGINE / OBSERVABLE EVIDENCE / 01</span>
        </div>
        <h1>
          Understand the agents you are about to <em>trust.</em>
        </h1>
        <p class="hero-lead">
          Discover public AI agents and GitHub repositories, then inspect observable evidence for activity, health, documentation, stack and static risk signals before making architectural decisions.
        </p>
        
        <!-- Omni-Search Bar -->
        <div class="hero-search-wrapper">
          <form class="search-bar-unified" method="get" action="/agents/">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted); margin-right: 6px;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input id="homeQuery" name="q" type="search" placeholder="Search agents, MCP servers, coding tools, LangChain..." autocomplete="off" />
            <div class="shortcut-hint">
              <span>⌘K</span>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Explore</button>
          </form>

          <!-- Quick Discovery Chips -->
          <div class="search-chips" aria-label="Suggested searches">
            <span style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); align-self: center;">POPULAR:</span>
            <a href="/agents/?q=mcp">MCP Servers</a>
            <a href="/agents/?q=coding+agent">Coding Agents</a>
            <a href="/agents/?q=claude+skill">Claude Skills</a>
            <a href="/agents/?q=browser+automation">Browser Automation</a>
          </div>
        </div>

        <div style="display: flex; gap: 16px; align-items: center; margin-top: 10px;">
          <a href="/verify/" class="btn btn-emerald btn-sm">
            <span>Inspect a GitHub Repo →</span>
          </a>
          <a href="/compare/" class="btn btn-ghost btn-sm">
            <span>Compare Two Agents →</span>
          </a>
        </div>
      </div>

      <!-- High-Class Animated Intelligence Radar -->
      <div class="pv-hero-visual" aria-label="PARADOX agent intelligence radar visualization">
        <div class="pv-orbit"></div>
        <div class="pv-sweep"></div>
        <div class="pv-ping"></div>
        
        <div class="pv-core">
          <span>PX</span>
        </div>

        <div class="pv-node n1">
          <b>REPOSITORY</b>
          <span>evidence indexed</span>
        </div>
        <div class="pv-node n2">
          <b>RISK SIGNAL</b>
          <span>static scan</span>
        </div>
        <div class="pv-node n3">
          <b>FRESHNESS</b>
          <span>commit activity</span>
        </div>
        <div class="pv-node n4">
          <b>STACK</b>
          <span>dependencies</span>
        </div>

        <div class="pv-scan-pill">
          <span class="dot-pulse"></span>
          <span>RADAR: <strong>ONLINE</strong> · 0 CODE RUN</span>
        </div>
      </div>
    </section>

    <!-- Platform Principles Bento Grid -->
    <section style="margin: 40px 0 80px;" aria-label="Platform principles">
      <div style="margin-bottom: 20px;">
        <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--accent-light); text-transform: uppercase;">02 / PLATFORM FOUNDATIONS</span>
        <h2 style="font-size: 26px; font-weight: 800; letter-spacing: -0.02em; margin: 6px 0;">Deterministic signals. Zero guesswork.</h2>
      </div>
      <div class="bento-grid-4">
        <div class="bento-cell">
          <span class="kicker">DECISION MODEL</span>
          <h3>Evidence First</h3>
          <p>Every verdict is anchored in observable repository commits, documentation, and dependencies. No subjective hype.</p>
        </div>
        <div class="bento-cell">
          <span class="kicker">INSPECTION MODE</span>
          <h3>Zero Code Execution</h3>
          <p>Target repository code, Dockerfiles, and install scripts are never executed. Static inspection only.</p>
        </div>
        <div class="bento-cell">
          <span class="kicker">CORE METRICS</span>
          <h3>Live Health & Risk</h3>
          <p>Real-time calculation of repository freshness, maintenance velocity, and static security risk signals.</p>
        </div>
        <div class="bento-cell">
          <span class="kicker">DECISION LAYER</span>
          <h3>Side-by-Side Matrix</h3>
          <p>Compare two agents head-to-head using normalized criteria to select the most reliable dependency.</p>
        </div>
      </div>
    </section>

    <!-- The 4-Step Intelligence Workflow -->
    <section style="margin: 80px 0; border-top: 1px solid var(--border-subtle); padding-top: 60px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; margin-bottom: 36px;">
        <div>
          <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--accent-light); text-transform: uppercase;">03 / WORKFLOW</span>
          <h2 style="font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; letter-spacing: -0.02em; margin: 8px 0 0;">From discovery to defensible decision.</h2>
        </div>
        <p style="color: var(--text-secondary); max-width: 440px; font-size: 14px; margin: 0;">PARADOX makes an agent understandable before it becomes a mission-critical dependency.</p>
      </div>

      <div class="bento-grid-4">
        <div class="bento-cell">
          <div style="font-family: var(--font-mono); font-size: 28px; font-weight: 800; color: var(--accent); opacity: 0.6;">01</div>
          <h3>Discover</h3>
          <p>Search public GitHub repositories by capability, tools, or MCP protocol support.</p>
        </div>
        <div class="bento-cell">
          <div style="font-family: var(--font-mono); font-size: 28px; font-weight: 800; color: var(--cyan); opacity: 0.6;">02</div>
          <h3>Inspect</h3>
          <p>Analyze health scores, release frequency, model dependencies, and potential risk flags.</p>
        </div>
        <div class="bento-cell">
          <div style="font-family: var(--font-mono); font-size: 28px; font-weight: 800; color: var(--emerald); opacity: 0.6;">03</div>
          <h3>Compare</h3>
          <p>Align two repositories in a side-by-side matrix to contrast activity and maintenance.</p>
        </div>
        <div class="bento-cell">
          <div style="font-family: var(--font-mono); font-size: 28px; font-weight: 800; color: var(--amber); opacity: 0.6;">04</div>
          <h3>Decide</h3>
          <p>Save verified shortlists to your dashboard with explicit uncertainty indicators.</p>
        </div>
      </div>
    </section>

    <!-- Curated Signals / Featured Agents -->
    <section style="margin: 80px 0; border-top: 1px solid var(--border-subtle); padding-top: 60px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; margin-bottom: 36px;">
        <div>
          <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--cyan); text-transform: uppercase;">04 / CURATED INDEX</span>
          <h2 style="font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; letter-spacing: -0.02em; margin: 8px 0 0;">Featured Agent Repositories</h2>
        </div>
        <a href="/agents/" class="btn btn-ghost btn-sm">Explore All Agents →</a>
      </div>

      <div class="grid-agents">
        {featured.map((e) => (
          <article class="agent-card">
            <div class="meta">
              <span class="chip chip-accent">{e.category}</span>
              <span>{e.owner}</span>
            </div>
            <h3>{e.repo}</h3>
            <p>{e.summary}</p>
            <div class="links">
              <a href={`/agents/${e.owner}/${e.repo}/`}>Inspect Profile →</a>
              <a href={`/verify/?url=${encodeURIComponent(`https://github.com/${e.owner}/${e.repo}`)}`}>Run Verifier ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- AI Developer Workbench Section -->
    <section style="margin: 80px 0; border-top: 1px solid var(--border-subtle); padding-top: 60px;" id="ai-tools">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px; margin-bottom: 36px;">
        <div>
          <span style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; color: var(--emerald-light); text-transform: uppercase;">05 / DEVELOPER WORKBENCH</span>
          <h2 style="font-size: clamp(28px, 3.5vw, 42px); font-weight: 800; letter-spacing: -0.02em; margin: 8px 0 0;">Practical Developer AI Tools</h2>
        </div>
        <a href="/ai/" class="btn btn-emerald btn-sm">Open All Tools ↗</a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
        {featuredTools.map((tool, i) => (
          <a class="card-glass" href={`/ai/${tool.slug}/`} style="text-decoration: none; display: flex; flex-direction: column; gap: 10px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-family: var(--font-mono); font-size: 10px; color: var(--text-muted);">{String(i + 1).padStart(2, '0')}</span>
              <span class="chip" style="font-size: 9px;">AI TOOL</span>
            </div>
            <strong style="font-size: 16px; color: var(--text-primary);">{tool.label}</strong>
            <p style="font-size: 13px; color: var(--text-secondary); margin: 0; line-height: 1.5;">{tool.description}</p>
            <span style="margin-top: auto; font-family: var(--font-mono); font-size: 11px; color: var(--accent-light); padding-top: 10px;">LAUNCH TOOL ↗</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
