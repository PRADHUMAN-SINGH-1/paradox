---
import MakerLayout from '../layouts/MakerLayout.astro';
import demand from '../data/demand.json';
import utilityOpportunities from '../data/utility-opportunities.json';

const tools=[
  {icon:'🎲',name:'Bingo cards',desc:'Make a custom card from names, words or prompts.',href:'/bingo-card-generator/',tags:'school classroom party game'},
  {icon:'🔎',name:'Word searches',desc:'Turn your words into a printable puzzle.',href:'/word-search-generator/',tags:'school spelling vocabulary puzzle'},
  {icon:'👥',name:'Random teams',desc:'Split any group fairly in seconds.',href:'/random-team-generator/',tags:'teams school office sports'},
  {icon:'🎡',name:'Decision wheel',desc:'Put your choices in. Let the wheel decide.',href:'/decision-wheel/',tags:'choice random picker party'},
  {icon:'🏆',name:'Tournament bracket',desc:'Set up matchups for your next competition.',href:'/tournament-bracket-generator/',tags:'sports tournament competition'},
  {icon:'🎟️',name:'Raffle tickets',desc:'Create numbered tickets ready to print.',href:'/raffle-ticket-generator/',tags:'event fundraiser giveaway'},
  {icon:'🪑',name:'Seating chart',desc:'Arrange names into a clean printable plan.',href:'/seating-chart-generator/',tags:'wedding event dinner classroom'},
  {icon:'🏅',name:'Certificates',desc:'Make a simple certificate people will actually want.',href:'/certificate-maker/',tags:'award graduation appreciation'}
];
const utilities=utilityOpportunities.slice(0,8);
const ranked=(demand.opportunities||[]).filter(x=>x.route).slice(0,3);
const signals=(demand.globalTrends||[]).slice(0,6);
const lead=ranked[0] || {label:'Random Team Generator',route:'/random-team-generator/',score:0};
const countries=[...new Set(signals.map(x=>x.geo).filter(Boolean))].slice(0,6);
---
<MakerLayout title="PARADOX — Free tools for real life" description="Free, simple tools for teams, classrooms, events, games and everyday jobs. No account required.">
<main class="home">
  <section class="home-hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="live-dot"></span> FREE · NO ACCOUNT · NO UPLOADS</div>
      <h1>Got a job?<br><em>Make it easy.</em></h1>
      <p class="hero-lead">Useful little tools for the things people actually need to get done — from picking teams to making a bracket, puzzle, certificate or seating plan.</p>
      <div class="hero-search">
        <span>⌕</span>
        <input id="toolSearch" type="search" placeholder="What are you trying to make?" aria-label="Search tools" autocomplete="off">
        <kbd>/</kbd>
      </div>
      <div class="hero-links"><a class="button button-dark" href="#tools">Explore tools</a><a class="text-link" href="/utilities/">More quick tools →</a></div>
    </div>
    <div class="hero-feature">
      <div class="feature-label">TODAY'S USEFUL PICK</div>
      <div class="feature-emoji">✦</div>
      <div class="feature-body">
        <span>Based on public global signals</span>
        <h2>{lead.label}</h2>
        <p>People are looking for this kind of thing right now. If it helps you, just use it.</p>
        <a href={lead.route}>Open it free →</a>
      </div>
      <div class="feature-meta"><span>{Math.round(lead.score || 0)} signal score</span><span>{countries.length || 1} markets sampled</span></div>
    </div>
  </section>
  <section class="trust-strip"><span>Built for humans</span><span>Instant start</span><span>Works on phone</span><span>Private by default</span><span>Print when you're done</span></section>
  <section class="section live-section">
    <div class="live-intro"><div><span class="eyebrow">COME BACK TOMORROW</span><h2>Useful once.<br><em>Useful every day.</em></h2><p>PARADOX now has a daily challenge and a live world desk — two places worth opening again.</p></div>
    <div class="live-actions"><a class="live-card" href="/daily/"><span>🔥</span><div><b>PARADOX Daily</b><small>5-second challenge · streak · share</small></div><strong>→</strong></a><a class="live-card" href="/world/"><span>🌍</span><div><b>World Desk</b><small>Live weather · currency · country facts</small></div><strong>→</strong></a></div></div>
  </section>
  <section class="section tools-section" id="tools">
    <div class="section-intro"><div><span class="eyebrow">THE TOOLBOX</span><h2>What do you need<br><em>right now?</em></h2></div><p>Pick a job. Fill in the blanks. Get the result. That's it.</p></div>
    <div class="tool-grid" id="toolGrid">
      {tools.map((tool,index)=><a class="tool-card" data-search={tool.name+' '+tool.desc+' '+tool.tags} href={tool.href}><div class="tool-icon">{tool.icon}</div><div class="tool-number">{String(index+1).padStart(2,'0')}</div><h3>{tool.name}</h3><p>{tool.desc}</p><span class="tool-arrow">Use it →</span></a>)}
    </div>
    <div id="noResults" class="no-results" hidden>No exact match. Try <a href="/utilities/">the full utility library →</a></div>
  </section>
  <section class="section quick-section">
    <div class="section-intro"><div><span class="eyebrow">QUICK ANSWERS</span><h2>Small problem.<br><em>Instant answer.</em></h2></div><p>Calculations, dates, conversions and text tools for those “I just need this done” moments.</p></div>
    <div class="quick-grid">{utilities.map(item=><a href={'/utilities/'+item.slug+'/'}><span>{item.label}</span><small>Open →</small></a>)}</div>
  </section>
  <section class="section signal-section">
    <div class="signal-card">
      <div class="signal-main"><span class="eyebrow">PARADOX RADAR</span><h2>We watch the world.<br><em>Then we make it useful.</em></h2><p>PARADOX combines public trend, news, knowledge and developer signals across markets. The point isn't to chase every trend — it's to notice useful demand and put the right tool in front of people.</p><a class="button button-light" href="/trending/">See the radar →</a></div>
      <div class="signal-list">{signals.map((item,index)=><a href="/trending/"><span>{String(index+1).padStart(2,'0')}</span><strong>{item.query}</strong><small>{item.geo} · {item.traffic || 'rising'}</small></a>)}</div>
    </div>
  </section>
  <section class="section simple-section">
    <div class="simple-grid"><div><span class="eyebrow">NO FUSS</span><h2>Open.<br>Make.<br><em>Done.</em></h2></div>
      <div class="simple-points"><article><b>01</b><div><h3>No account</h3><p>There is no sign-up wall between you and the tool.</p></div></article><article><b>02</b><div><h3>Your stuff stays with you</h3><p>Core generators process your inputs in the browser. We don't need your files.</p></div></article><article><b>03</b><div><h3>Made to finish the job</h3><p>Generate, print or save a result instead of reading a 2,000-word tutorial.</p></div></article></div>
    </div>
  </section>
</main>
<script is:inline>
(() => {
 const input=document.querySelector('#toolSearch'), cards=[...document.querySelectorAll('.tool-card')], empty=document.querySelector('#noResults');
 if(!input) return;
 input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let shown=0;cards.forEach(c=>{const ok=!q||c.dataset.search.toLowerCase().includes(q);c.hidden=!ok;if(ok)shown++});empty.hidden=shown>0});
 window.addEventListener('keydown',e=>{if(e.key==='/'&&document.activeElement!==input&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();input.focus()}});
})();
</script>
</MakerLayout>
