---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AITool from '../../components/ai/AITool.astro';
import aiTools from '../../data/ai/ai-tools.json';
const canonical = 'https://paradox.engineer/ai-studio/';
const toolkitStart = aiTools[0];
---
<BaseLayout title="PARADOX AI Studio — Multi-Model AI Workbench" description="A practical AI workbench for resumes, interviews, studying, writing and coding, powered by PARADOX's server-side AI provider router." canonical={canonical}>
<main class="studio">
  <header class="hero">
    <div class="eyebrow"><span>PARADOX / AI STUDIO</span><span>05 WORKFLOWS · MULTI-PROVIDER ROUTER</span></div>
    <div class="hero-grid">
      <div>
        <p class="signal"><i></i> PARADOX / AI WORKBENCH</p>
        <h1>Make AI<br><em>do the work.</em></h1>
        <p class="lead">One workbench for five AI workflows, sixteen developer utilities and live AI signals. Everything stays inside the current PARADOX interface.</p>
        <div class="router-card"><div><b>ROUTER ONLINE</b><span>Provider credentials remain server-side. Auto mode falls back through available providers.</span></div><select id="provider" aria-label="AI provider"><option value="auto">AUTO — best available</option><option value="gemini">Gemini</option><option value="groq">Groq</option><option value="cerebras">Cerebras</option><option value="huggingface">Hugging Face</option><option value="ollama">Ollama</option></select></div>
      </div>
      <div class="orbit" aria-hidden="true"><strong>AI</strong><span>PARADOX<br>STUDIO</span></div>
    </div>
  </header>
  <div class="studio-switcher" role="tablist" aria-label="Studio modules"><button type="button" class="studio-switcher-btn active" data-section-tab="workflows">01 / WORKFLOWS</button><button type="button" class="studio-switcher-btn" data-section-tab="toolkit">02 / DEVELOPER TOOLKIT <span>16</span></button><button type="button" class="studio-switcher-btn" data-section-tab="radar">03 / LIVE RADAR</button></div>
  <section id="studioWorkflows" class="workbench" aria-label="AI Studio workbench">
    <aside class="sidebar">
      <div class="side-head"><span>01</span><b>WORKFLOW</b></div>
      <button type="button" class="flow active" data-flow="resume"><strong>01</strong><span>Resume Tailor<small>Match your resume to a job</small></span></button>
      <button type="button" class="flow" data-flow="interview"><strong>02</strong><span>Interview Coach<small>Generate questions + answer framework</small></span></button>
      <button type="button" class="flow" data-flow="study"><strong>03</strong><span>Study Engine<small>Turn notes into a revision pack</small></span></button>
      <button type="button" class="flow" data-flow="content"><strong>04</strong><span>Content Studio<small>Turn an idea into publishable content</small></span></button>
      <button type="button" class="flow" data-flow="code"><strong>05</strong><span>Code Fixer<small>Diagnose and repair a concrete bug</small></span></button>
    </aside>
    <section class="main-panel">
      <div class="form-head"><div><span id="flowLabel">RESUME TAILOR</span><h2 id="flowTitle">Make the application fit.</h2></div><span id="status" class="status">READY</span></div>
      <div id="fields" aria-live="polite"></div>
      <div class="actions"><button type="button" id="run" class="run">RUN AI ↗</button><button type="button" id="example" class="btn">TRY EXAMPLE</button><button type="button" id="clear" class="btn">CLEAR</button><button type="button" id="copy" class="btn">COPY RESULT</button></div>
      <div id="error" class="error" hidden role="alert"></div>
      <article class="result"><div class="result-top"><span>02 / OUTPUT</span><button type="button" id="download" class="mini">DOWNLOAD .TXT</button></div><div class="px-result-meta"><span class="px-result-provider">AI</span><span class="px-result-latency">READY</span></div><div id="resultEmpty"><strong>Your deliverable will appear here.</strong><p>Choose a workflow, fill the inputs and run AI.</p></div><pre id="result" hidden></pre></article>
    </section>
  </section>
<section id="studioToolkit" class="studio-module" hidden aria-label="Developer AI Toolkit">
    <div class="studio-module-head"><div><span class="module-kicker">02 / FOCUSED_UTILITIES</span><h2>Developer Toolkit.</h2><p>All 16 browser-first developer AI tools live inside this Studio workspace. No separate tool pages.</p></div><span class="module-status">LOCAL · READY</span></div>
    <div class="tool-library">{aiTools.map((t,i)=><button type="button" class="studio-tool-select{i===0?' active':''}" data-tool-select={t.slug} data-tool-mode={t.mode}><b>{String(i+1).padStart(2,'0')}</b><span>{t.label}<small>{t.description}</small></span></button>)}</div>
    <div class="studio-tool-host"><AITool mode={toolkitStart.mode} title={toolkitStart.title} intro={toolkitStart.description} headingLevel="h2" /></div>
  </section>
  <section id="studioRadar" class="studio-module" hidden aria-label="Live AI Radar">
    <div class="studio-module-head"><div><span class="module-kicker">03 / LIVE_OBSERVABILITY</span><h2>AI Radar Station.</h2><p>Live public model, GitHub and Hacker News signals, now inside the same Studio instead of a separate route.</p></div><span id="radarStatus" class="module-status">READY</span></div>
    <div class="radar-grid"><section><div class="radar-head"><span>TRENDING MODELS</span><b>HUGGING FACE</b></div><div id="radarModels" class="radar-list"><p class="radar-empty">Open Radar to load live models.</p></div></section><section><div class="radar-head"><span>DEVELOPER SIGNALS</span><b>GITHUB</b></div><div id="radarGithub" class="radar-list"><p class="radar-empty">Open Radar to load projects.</p></div></section><section><div class="radar-head"><span>AI STORIES</span><b>HACKER NEWS</b></div><div id="radarNews" class="radar-list"><p class="radar-empty">Open Radar to load stories.</p></div></section></div>
  </section>
</main>
<style>
.studio{
  background:var(--bg);
  color:var(--text-primary);
  min-height:100vh;
  width:100%;
  overflow:hidden;
}
.hero{
  max-width:1600px;
  margin:0 auto;
  padding:28px clamp(20px,4vw,64px) 74px;
}
.eyebrow,.signal,.side-head,.result-top,.status,.router-card,.studio label,.btn,.run,.mini{
  font:800 9px/1.2 var(--font-mono);
  letter-spacing:.11em;
  text-transform:uppercase;
}
.eyebrow{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding-bottom:13px;
  border-bottom:1px solid var(--border-subtle);
  color:var(--text-muted);
}
.hero-grid{
  display:grid;
  grid-template-columns:minmax(0,1.12fr) minmax(300px,.88fr);
  gap:5vw;
  align-items:center;
  padding-top:56px;
}
.signal{
  color:var(--text-secondary);
  margin:0 0 18px;
}
.signal i{
  display:inline-block;
  width:7px;
  height:7px;
  margin-right:8px;
  border-radius:50%;
  background:var(--cobalt-data);
  box-shadow:0 0 0 4px rgba(59,91,219,.09);
}
.studio h1{
  margin:0 0 26px;
  max-width:940px;
  color:var(--text-primary);
  font:800 clamp(76px,10.5vw,154px)/.78 var(--font-display);
  letter-spacing:-.09em;
}
.studio h1 em{
  font-style:normal;
  color:var(--text-secondary);
}
.lead{
  max-width:760px;
  color:var(--text-secondary);
  font:500 16px/1.65 var(--font-sans);
}
.router-card{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  max-width:800px;
  margin-top:28px;
  padding:14px 16px;
  border:1px solid var(--border-default);
  background:rgba(9,11,14,.9);
}
.router-card b{color:var(--text-primary)}
.router-card span{
  display:block;
  margin-top:5px;
  color:var(--text-muted);
  font:500 11px/1.45 var(--font-sans);
  text-transform:none;
  letter-spacing:0;
}
.router-card select{
  min-width:230px;
  padding:11px 12px;
  border:1px solid var(--border-default);
  background:var(--surface-2);
  color:var(--text-primary);
  font:800 10px/1 var(--font-mono);
}
.orbit{
  width:min(34vw,430px);
  aspect-ratio:1;
  justify-self:end;
  position:relative;
  display:grid;
  place-items:center;
  border:1px solid var(--border-default);
  border-radius:50%;
  background:radial-gradient(circle at 50% 50%,rgba(59,91,219,.10),transparent 44%),var(--surface);
  overflow:hidden;
}
.orbit:before,.orbit:after{
  content:'';
  position:absolute;
  inset:8%;
  border:1px solid rgba(255,255,255,.15);
  border-radius:50%;
  transform:rotate(38deg) scaleX(1.6);
}
.orbit:after{transform:rotate(-43deg) scaleX(1.6)}
.orbit strong{
  width:132px;
  height:132px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#0a0c10;
  color:#fff;
  font:800 42px/1 var(--font-display);
  box-shadow:18px 18px 0 var(--cobalt-data);
  z-index:2;
}
.orbit span{
  position:absolute;
  bottom:15%;
  color:var(--text-muted);
  text-align:center;
  font:800 8px/1.4 var(--font-mono);
  letter-spacing:.12em;
}
.studio-switcher{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  border-top:1px solid var(--border-subtle);
  border-bottom:1px solid var(--border-subtle);
  background:#07090b;
  position:sticky;
  top:0;
  z-index:30;
}
.studio-switcher-btn{
  min-height:62px;
  border:0;
  border-right:1px solid var(--border-subtle);
  background:transparent;
  color:var(--text-muted);
  padding:0 18px;
  text-align:left;
  cursor:pointer;
  font:800 10px/1 var(--font-mono);
  letter-spacing:.10em;
}
.studio-switcher-btn:last-child{border-right:0}
.studio-switcher-btn:hover{background:#0d1015;color:var(--text-primary)}
.studio-switcher-btn.active{background:var(--text-primary);color:var(--bg)}
.studio-switcher-btn span{float:right;color:inherit}
.workbench{
  display:grid;
  grid-template-columns:320px minmax(0,1fr);
  max-width:1600px;
  min-height:760px;
  margin:0 auto;
  border-bottom:1px solid var(--border-subtle);
}
.sidebar{
  padding:22px 18px;
  border-right:1px solid var(--border-subtle);
  background:#07090b;
}
.side-head{
  display:flex;
  justify-content:space-between;
  padding:0 4px 16px;
  border-bottom:1px solid var(--border-subtle);
  color:var(--text-muted);
}
.flow{
  width:100%;
  display:grid;
  grid-template-columns:32px minmax(0,1fr) 18px;
  gap:10px;
  align-items:start;
  padding:18px 6px;
  border:0;
  border-bottom:1px solid var(--border-subtle);
  background:transparent;
  color:var(--text-secondary);
  text-align:left;
  cursor:pointer;
}
.flow:hover{background:#0c0f13;color:var(--text-primary)}
.flow.active{background:var(--text-primary);color:var(--bg)}
.flow strong{font:800 9px/1 var(--font-mono);color:var(--text-muted);padding-top:2px}
.flow.active strong{color:var(--cobalt-data)}
.flow span{font:800 12px/1.3 var(--font-mono);letter-spacing:.04em}
.flow small{display:block;margin-top:6px;color:var(--text-muted);font:500 10px/1.4 var(--font-sans);letter-spacing:0;text-transform:none}
.flow.active small{color:#606673}
.flow::after{content:'↗';font:800 12px/1 var(--font-mono);color:var(--text-muted)}
.flow.active::after{color:var(--bg)}
.main-panel{
  min-width:0;
  padding:28px clamp(18px,3vw,44px);
  background:rgba(5,6,8,.88);
}
.form-head{
  display:flex;
  justify-content:space-between;
  gap:20px;
  padding-bottom:18px;
  border-bottom:1px solid var(--border-subtle);
}
.form-head>div>span{
  font:800 9px/1 var(--font-mono);
  letter-spacing:.13em;
  color:var(--cobalt-data);
}
.studio h2{
  margin:10px 0 0;
  color:var(--text-primary);
  font:800 clamp(38px,4.7vw,68px)/.88 var(--font-display);
  letter-spacing:-.06em;
}
.status{
  height:max-content;
  padding:8px 10px;
  border:1px solid var(--border-default);
  color:var(--text-muted);
  white-space:nowrap;
}
.studio #fields{
  display:grid;
  gap:18px;
  margin-top:20px;
}
.studio #fields>label{
  display:grid;
  gap:8px;
  color:var(--text-muted);
}
.studio #fields input,.studio #fields textarea{
  width:100%;
  box-sizing:border-box;
  padding:13px 14px;
  border:1px solid var(--border-default);
  border-radius:0;
  background:var(--surface-2);
  color:var(--text-primary);
  font:500 14px/1.6 var(--font-sans);
}
.studio #fields textarea{min-height:150px;resize:vertical}
.studio #fields input::placeholder,.studio #fields textarea::placeholder{color:var(--text-muted)}
.studio #fields input:focus,.studio #fields textarea:focus{outline:1px solid rgba(59,91,219,.8);border-color:rgba(59,91,219,.8)}
.actions{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}
.run,.btn,.mini{
  border:1px solid var(--border-default);
  padding:12px 14px;
  background:var(--surface-1);
  color:var(--text-primary);
  cursor:pointer;
}
.run{background:var(--text-primary);color:var(--bg);border-color:var(--text-primary)}
.run:hover{background:#cbd3ff;border-color:#cbd3ff}
.btn:hover,.mini:hover{background:var(--surface-hover)}
.error{
  border:1px solid rgba(255,107,107,.45);
  background:rgba(255,107,107,.08);
  color:#ffb0b0;
  padding:12px 14px;
  font:500 11px/1.5 var(--font-mono);
}
.result{
  margin-top:20px;
  min-height:400px;
  border:1px solid var(--border-default);
  background:#040507;
  color:var(--text-primary);
}
.result-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  padding:12px 14px;
  border-bottom:1px solid var(--border-subtle);
  color:var(--text-muted);
}
.px-result-meta{
  display:flex;
  justify-content:space-between;
  gap:18px;
  padding:10px 14px;
  border-bottom:1px solid var(--border-subtle);
  font:800 9px/1 var(--font-mono);
  letter-spacing:.10em;
  color:var(--text-muted);
}
.px-result-provider{color:var(--status-success)}
.result pre{
  margin:0;
  padding:20px;
  max-height:650px;
  overflow:auto;
  white-space:pre-wrap;
  word-break:break-word;
  color:#e8ebf0;
  font:500 12px/1.75 var(--font-mono);
}
.result #resultEmpty{padding:72px 24px;color:var(--text-muted)}
.result #resultEmpty strong{display:block;color:var(--text-primary);font:800 18px/1.2 var(--font-display)}
.result #resultEmpty p{margin:8px 0 0;color:var(--text-muted);font:500 12px/1.5 var(--font-sans)}

.studio-module{
  max-width:1600px;
  margin:0 auto;
  padding:58px clamp(20px,4vw,64px) 92px;
  background:var(--bg);
}
.studio-module-head{
  display:flex;
  justify-content:space-between;
  gap:24px;
  align-items:flex-end;
  border-bottom:1px solid var(--border-subtle);
  padding-bottom:20px;
}
.module-kicker,.module-status,.studio-tool-select b,.radar-head{
  font:800 9px/1 var(--font-mono);
  letter-spacing:.12em;
  text-transform:uppercase;
}
.studio-module-head h2{
  margin:10px 0;
  color:var(--text-primary);
  font:800 clamp(44px,6vw,86px)/.88 var(--font-display);
  letter-spacing:-.06em;
}
.studio-module-head p{
  max-width:760px;
  margin:0;
  color:var(--text-secondary);
  font:500 14px/1.6 var(--font-sans);
}
.module-status{
  border:1px solid var(--border-default);
  padding:9px 11px;
  color:var(--text-muted);
  white-space:nowrap;
}
.tool-library{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:8px;
  margin:22px 0;
}
.studio-tool-select{
  display:grid;
  grid-template-columns:26px minmax(0,1fr);
  gap:10px;
  align-items:start;
  min-height:82px;
  padding:14px;
  border:1px solid var(--border-default);
  background:var(--surface-1);
  color:var(--text-primary);
  text-align:left;
  cursor:pointer;
}
.studio-tool-select:hover{background:var(--surface-hover)}
.studio-tool-select.active{background:var(--text-primary);color:var(--bg);border-color:var(--text-primary)}
.studio-tool-select b{color:var(--text-muted)}
.studio-tool-select.active b{color:var(--cobalt-data)}
.studio-tool-select span{font:800 11px/1.3 var(--font-mono)}
.studio-tool-select small{display:block;margin-top:5px;color:var(--text-muted);font:500 10px/1.35 var(--font-sans)}
.studio-tool-select.active small{color:#626976}
.studio-tool-host{padding-top:8px}
.studio-tool-host .generator-breadcrumb,.studio-tool-host .ad-slot,.studio-tool-host .generator-info,.studio-tool-host .generator-head{display:none!important}
.studio-tool-host .generator-page{min-height:auto!important;padding:0!important;background:transparent!important;color:var(--text-primary)!important}
.studio-tool-host .generator-layout{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;margin:0!important}
.studio-tool-host .generator-panel,.studio-tool-host .generator-preview{border:1px solid var(--border-default)!important;background:var(--surface-1)!important;color:var(--text-primary)!important}
.studio-tool-host .generator-panel-head,.studio-tool-host .generator-preview-head{padding:13px 14px!important;border-color:var(--border-subtle)!important;background:transparent!important}
.studio-tool-host .generator-panel-head h2,.studio-tool-host .generator-preview-head h2{color:var(--text-muted)!important;font:800 9px/1 var(--font-mono)!important;letter-spacing:.1em!important}
.studio-tool-host .generator-fields{padding:14px!important}
.studio-tool-host .field label{color:var(--text-muted)!important}
.studio-tool-host .field input,.studio-tool-host .field textarea{background:var(--surface-2)!important;color:var(--text-primary)!important;border-color:var(--border-default)!important}
.studio-tool-host .generator-preview{min-height:390px!important}
.studio-tool-host .preview-empty{background:transparent!important;color:var(--text-muted)!important}
.studio-tool-host .preview-empty strong{color:var(--text-primary)!important}
.studio-tool-host .gen-output{background:#040507!important}
.studio-tool-host .sheet{background:#040507!important;color:var(--text-primary)!important;border:0!important}
.studio-tool-host .code-block{background:var(--surface-1)!important;color:#e7ebf0!important;border-color:var(--border-default)!important}
.studio-tool-host .gen-btn{background:var(--surface-1)!important;color:var(--text-primary)!important;border-color:var(--border-default)!important}
.studio-tool-host .gen-btn:first-child{background:var(--text-primary)!important;color:var(--bg)!important;border-color:var(--text-primary)!important}

.radar-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:22px}
.radar-grid>section{border:1px solid var(--border-default);background:var(--surface-1);min-width:0}
.radar-head{display:flex;justify-content:space-between;gap:10px;padding:14px;border-bottom:1px solid var(--border-subtle);color:var(--text-primary)}
.radar-head b{color:var(--text-muted)}
.radar-list{display:grid}
.studio-radar-card{display:grid;gap:6px;padding:15px;border-bottom:1px solid var(--border-subtle);color:var(--text-primary);text-decoration:none}
.studio-radar-card:hover{background:var(--surface-hover)}
.studio-radar-card strong{font:700 12px/1.4 var(--font-sans);overflow-wrap:anywhere}
.studio-radar-card span{color:var(--text-muted);font:500 10px/1.4 var(--font-mono)}
.radar-empty{padding:18px;color:var(--text-muted);font:500 11px/1.5 var(--font-mono)}

@media(max-width:1050px){
  .hero-grid{grid-template-columns:1fr}
  .orbit{width:min(62vw,340px);justify-self:center}
  .workbench{grid-template-columns:1fr}
  .sidebar{border-right:0;border-bottom:1px solid var(--border-subtle)}
  .flow{grid-template-columns:30px minmax(0,1fr) 18px}
  .tool-library{grid-template-columns:repeat(3,minmax(0,1fr))}
  .studio-tool-host .generator-layout{grid-template-columns:1fr}
  .radar-grid{grid-template-columns:1fr}
}
@media(max-width:700px){
  .hero{padding-top:18px}
  .eyebrow{flex-direction:column;gap:8px}
  .studio h1{font-size:clamp(58px,16vw,108px)}
  .router-card{align-items:stretch;flex-direction:column}
  .router-card select{min-width:0;width:100%}
  .studio-switcher{grid-template-columns:1fr;position:static}
  .studio-switcher-btn{border-right:0;border-bottom:1px solid var(--border-subtle)}
  .studio-switcher-btn:last-child{border-bottom:0}
  .studio-module{padding:40px 18px 70px}
  .studio-module-head{flex-direction:column;align-items:flex-start}
  .tool-library{grid-template-columns:1fr 1fr}
  .workflow-list{padding:0}
  .main-panel{padding:22px 16px}
  .actions>*{flex:1 1 100%;text-align:center}
}
@media(max-width:430px){
  .tool-library{grid-template-columns:1fr}
  .orbit{width:78vw}
}
</style>
</BaseLayout>


