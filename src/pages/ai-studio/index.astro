---
import MakerLayout from '../../layouts/MakerLayout.astro';
const canonical='https://paradox.engineer/ai-studio/';
---
<MakerLayout title="PARADOX AI Studio — Free AI Workbench" description="A practical AI workbench for resumes, interviews, studying, writing, coding and research. Connect a free Gemini API key and run powerful workflows in your browser." canonical={canonical}>
<main id="main-content" class="studio">
  <header class="studio-hero">
    <div class="studio-kicker"><span>PARADOX / AI STUDIO</span><span>WORKFLOWS / 01—05</span></div>
    <div class="studio-grid">
      <div><p class="studio-eyebrow"><i></i> NOT ANOTHER PROMPT WRAPPER</p><h1>Give it a job.<br><em>Get the work.</em></h1><p class="studio-lead">Turn raw notes, a job description, an idea or a code problem into a useful deliverable. Choose a workflow, add your context, run the model and copy the result.</p><div class="studio-connect"><label for="apiKey">Gemini API key <a href="https://aistudio.google.com/apikey" target="_blank" rel="noreferrer">get a free key ↗</a></label><div><input id="apiKey" type="password" placeholder="Paste your Gemini key — stored only in this tab"><button id="saveKey" class="studio-btn">CONNECT</button></div><small>PARADOX does not send this key to its server or store it in your account.</small></div></div>
      <div class="studio-orbit"><div></div><strong>AI</strong><span>WORK<br/>BENCH</span></div>
    </div>
  </header>

  <section class="studio-workbench">
    <aside class="studio-sidebar"><div class="side-title"><span>01</span><b>WORKFLOW</b></div>
      <button class="flow active" data-flow="resume"><strong>01</strong><span>Resume Tailor<small>Match your resume to a job</small></span></button>
      <button class="flow" data-flow="interview"><strong>02</strong><span>Interview Coach<small>Generate questions + model answers</small></span></button>
      <button class="flow" data-flow="study"><strong>03</strong><span>Study Engine<small>Turn notes into a revision pack</small></span></button>
      <button class="flow" data-flow="content"><strong>04</strong><span>Content Studio<small>Idea → polished post or article</small></span></button>
      <button class="flow" data-flow="code"><strong>05</strong><span>Code Fixer<small>Explain, repair and improve code</small></span></button>
    </aside>

    <section class="studio-main">
      <div class="studio-form-head"><div><span id="flowLabel">RESUME TAILOR</span><h2 id="flowTitle">Make the application fit.</h2></div><span id="status" class="studio-status">READY</span></div>
      <div id="fields"></div>
      <div class="studio-actions"><button id="run" class="studio-run">RUN AI <span>↗</span></button><button id="clear" class="studio-btn">CLEAR</button><button id="copy" class="studio-btn">COPY RESULT</button></div>
      <div id="error" class="studio-error" hidden></div>
      <article class="studio-result"><div class="result-top"><span>02 / OUTPUT</span><button id="download" class="studio-mini">DOWNLOAD .TXT</button></div><div id="resultEmpty"><strong>Your deliverable will appear here.</strong><p>Connect Gemini, choose a workflow and run it.</p></div><pre id="result" hidden></pre></article>
    </section>
  </section>

  <section class="studio-proof"><div><span>WHY IT IS DIFFERENT</span><h2>Tools people actually<br/><em>come back to.</em></h2></div><div class="proof-grid"><article><b>JOB SEEKERS</b><p>Resume tailoring, JD matching and interview practice are repeat-use workflows, not one-click novelty.</p></article><article><b>STUDENTS</b><p>Drop notes in and get summaries, flashcards, quiz questions and a revision plan.</p></article><article><b>BUILDERS</b><p>Paste a failing function and get an explanation, likely bug, corrected version and tests.</p></article></div></section>
</main>
<script is:inline>
(()=>{
const root=document.querySelector('.studio');if(!root)return;
const flows={
 resume:{label:'RESUME TAILOR',title:'Make the application fit.',fields:[['Your resume','resume','ta','Paste your resume here...'],['Job description','jd','ta','Paste the job description here...'],['Target role','role','text','Software Engineer']]},
 interview:{label:'INTERVIEW COACH',title:'Train against the actual role.',fields:[['Job description','jd','ta','Paste the job description here...'],['Your background','bg','ta','Projects, experience, skills, education...'],['Interview stage','stage','text','Technical round']]},
 study:{label:'STUDY ENGINE',title:'Turn notes into a revision system.',fields:[['Topic or chapter','topic','text','DBMS — normalization'],['Notes / source material','notes','ta','Paste class notes, textbook text or your own notes...'],['Difficulty','difficulty','text','University exam']]},
 content:{label:'CONTENT STUDIO',title:'Go from idea to publishable draft.',fields:[['Idea / brief','brief','ta','What are you trying to say?'],['Audience','audience','text','College students and young professionals'],['Format','format','text','LinkedIn post']]},
 code:{label:'CODE FIXER',title:'Understand the bug before you patch it.',fields:[['Code','code','ta','Paste the code that is failing...'],['Error / expected behaviour','errorInfo','ta','Paste the error or explain what should happen.'],['Language','language','text','JavaScript']]}
};
const fields=root.querySelector('#fields'), flowLabel=root.querySelector('#flowLabel'), flowTitle=root.querySelector('#flowTitle'), result=root.querySelector('#result'), empty=root.querySelector('#resultEmpty'), status=root.querySelector('#status'), err=root.querySelector('#error');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let current='resume';
function render(name){current=name;const f=flows[name];flowLabel.textContent=f.label;flowTitle.textContent=f.title;fields.innerHTML=f.fields.map(([label,id,type,ph])=>type==='ta'?`<label>${label}<textarea id="${id}" placeholder="${ph}"></textarea></label>`:`<label>${label}<input id="${id}" placeholder="${ph}" /></label>`).join('');root.querySelectorAll('.flow').forEach(x=>x.classList.toggle('active',x.dataset.flow===name));result.hidden=true;empty.hidden=false;err.hidden=true;status.textContent='READY'}
root.querySelectorAll('.flow').forEach(b=>b.addEventListener('click',()=>render(b.dataset.flow)));
const promptFor=(name,get)=>{
if(name==='resume')return `Act as an expert ATS resume strategist. Compare the resume below against the job description. Return: 1) match score /100 with reasons, 2) missing skills/keywords, 3) rewritten high-impact bullets for the most relevant experience, 4) a tailored professional summary, 5) exact changes the candidate should make. Do not invent experience or credentials.\n\nRESUME:\n${get('resume')}\n\nJOB DESCRIPTION:\n${get('jd')}\n\nTARGET ROLE:\n${get('role')}`;
if(name==='interview')return `Act as a senior interviewer for the role described below. Create a realistic interview preparation pack: 8 role-specific questions, what a strong answer should contain, 3 technical follow-ups, 3 behavioural questions, a 30-second introduction tailored to the candidate, and 5 red flags to avoid. Ground everything in the provided job description and background.\n\nJOB DESCRIPTION:\n${get('jd')}\n\nCANDIDATE BACKGROUND:\n${get('bg')}\n\nSTAGE:\n${get('stage')}`;
if(name==='study')return `Act as an excellent university tutor. Turn the supplied material into a high-retention revision pack: concise explanation, key concepts, formulas or rules when relevant, 12 flashcards, 10 exam-style questions with answers, common mistakes, and a one-day revision plan. Do not add facts that are not needed; clearly mark anything uncertain.\n\nTOPIC:\n${get('topic')}\n\nMATERIAL:\n${get('notes')}\n\nDIFFICULTY:\n${get('difficulty')}`;
if(name==='content')return `Act as a sharp editor and content strategist. Transform the brief into a publishable ${get('format')}. Give it a strong hook, concrete value, natural human voice, useful structure and a clear ending. Avoid generic AI filler, fake statistics, empty hype and overdone emojis. Also provide 3 alternative hooks.\n\nIDEA:\n${get('brief')}\n\nAUDIENCE:\n${get('audience')}`;
return `Act as a senior ${get('language')} engineer. Diagnose the supplied code and error. Return: root cause, exact corrected code, line-by-line explanation of the critical fix, tests or test cases that should be added, and one improvement that would prevent the bug from recurring. Do not rewrite unrelated code.\n\nCODE:\n${get('code')}\n\nERROR / EXPECTED BEHAVIOUR:\n${get('errorInfo')}\n\nLANGUAGE:\n${get('language')}`;
};
function get(id){return root.querySelector('#'+id)?.value?.trim()||''}
async function run(){err.hidden=true;const key=sessionStorage.getItem('paradox_gemini_key')||'';if(!key){err.textContent='Connect a Gemini API key first. Google currently offers a free Gemini API tier for developers.';err.hidden=false;return}const f=flows[current];const all=f.fields.map(x=>x[1]);if(all.some(id=>!get(id))){err.textContent='Complete the workflow inputs first.';err.hidden=false;return}status.textContent='RUNNING';result.hidden=false;empty.hidden=true;result.textContent='Generating…';
try{const res=await fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key='+encodeURIComponent(key),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({systemInstruction:{parts:[{text:'You are PARADOX AI Studio. Be specific, truthful, useful and concise. Never invent a user credential, job, result or source.'}]},contents:[{role:'user',parts:[{text:promptFor(current,get)}]}],generationConfig:{temperature:.35,maxOutputTokens:5000}})});const data=await res.json();if(!res.ok)throw new Error(data?.error?.message||'Gemini request failed');const text=data?.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join('\n')||'No output returned.';result.textContent=text;status.textContent='DONE';window.gtag?.('event','ai_studio_run',{workflow:current})}catch(e){result.hidden=true;empty.hidden=false;err.textContent=e.message||'AI request failed.';err.hidden=false;status.textContent='ERROR'}}
root.querySelector('#saveKey').addEventListener('click',()=>{const key=root.querySelector('#apiKey').value.trim();if(!key){err.textContent='Paste a Gemini API key first.';err.hidden=false;return}sessionStorage.setItem('paradox_gemini_key',key);root.querySelector('#apiKey').value='';status.textContent='CONNECTED';err.hidden=true});
root.querySelector('#run').addEventListener('click',run);root.querySelector('#clear').addEventListener('click',()=>render(current));root.querySelector('#copy').addEventListener('click',async()=>{if(result.hidden)return;await navigator.clipboard.writeText(result.textContent);status.textContent='COPIED'});root.querySelector('#download').addEventListener('click',()=>{if(result.hidden)return;const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([result.textContent],{type:'text/plain'}));a.download='paradox-ai-result.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)});render('resume');
})();
</script>
<style>
.studio{--ink:#0d0f0f;--paper:#f3f0e7;--line:#bdbab1;--acid:#dcff32;--red:#ff583d;background:var(--paper);color:var(--ink);max-width:1440px;margin:auto}.studio-hero{padding:24px clamp(18px,4vw,62px) 75px;min-height:78vh}.studio-kicker,.studio-eyebrow,.side-title,.result-top,.studio-status{font:9px 'DM Mono',monospace;letter-spacing:.14em}.studio-kicker{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:12px}.studio-grid{display:grid;grid-template-columns:1.15fr .65fr;gap:7vw;align-items:center;min-height:65vh}.studio-eyebrow{margin-top:35px}.studio-eyebrow i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--red);margin-right:8px}.studio h1{font:700 clamp(75px,11vw,160px)/.72 'DM Sans';letter-spacing:-.08em;margin:25px 0}.studio h1 em,.studio h2 em{font-family:'Instrument Serif',serif;font-weight:400}.studio-lead{max-width:640px;color:#585a53;font-size:17px;line-height:1.55}.studio-connect{margin-top:30px;max-width:680px}.studio-connect label,.studio-main label{display:block;font:9px 'DM Mono';text-transform:uppercase;letter-spacing:.08em}.studio-connect label a{float:right;text-decoration:underline}.studio-connect>div{display:flex;margin-top:7px}.studio-connect input{flex:1;border:1px solid var(--ink);background:#fffdf7;padding:14px}.studio-btn,.studio-run,.studio-mini{border:1px solid var(--ink);background:transparent;padding:12px 16px;font:9px 'DM Mono';letter-spacing:.07em}.studio-run{background:var(--ink);color:#fff;padding:15px 20px}.studio-run:hover{background:var(--red)}.studio-btn:hover{background:#fff}.studio-connect small{display:block;color:#74766e;font:9px 'DM Mono';margin-top:8px}.studio-orbit{width:min(32vw,430px);aspect-ratio:1;border:1px solid #aaa;border-radius:50%;justify-self:end;position:relative;display:grid;place-items:center}.studio-orbit:before,.studio-orbit:after{content:'';position:absolute;inset:9%;border:1px solid #aaa;border-radius:50%;transform:rotate(55deg) scaleX(1.7)}.studio-orbit:after{transform:rotate(-55deg) scaleX(1.7)}.studio-orbit strong{width:130px;height:130px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:#fff;font-size:42px;box-shadow:16px 16px 0 var(--red)}.studio-orbit span{position:absolute;bottom:19%;font:8px 'DM Mono';text-align:center;color:#777}.studio-workbench{display:grid;grid-template-columns:310px 1fr;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);min-height:760px}.studio-sidebar{border-right:1px solid var(--ink);padding:25px}.side-title{display:flex;justify-content:space-between;padding-bottom:20px;border-bottom:1px solid var(--line)}.flow{width:100%;display:grid;grid-template-columns:35px 1fr;text-align:left;gap:10px;border:0;border-bottom:1px solid var(--line);background:transparent;padding:20px 3px;color:var(--ink)}.flow:hover,.flow.active{background:#fff}.flow strong{font:9px 'DM Mono';color:#999}.flow span{font-weight:700;font-size:14px}.flow small{display:block;margin-top:5px;color:#777;font-size:11px;font-weight:400}.flow.active span{color:var(--red)}.studio-main{padding:30px clamp(18px,4vw,55px)}.studio-form-head{display:flex;justify-content:space-between;gap:20px;align-items:start;border-bottom:1px solid var(--line);padding-bottom:18px}.studio-form-head span:first-child{font:9px 'DM Mono';letter-spacing:.12em}.studio-form-head h2{font:700 clamp(38px,5vw,70px)/.85 'DM Sans';letter-spacing:-.06em;margin:13px 0 0}.studio-status{border:1px solid var(--line);padding:8px 10px}.studio-main label{margin:20px 0 7px}.studio-main input,.studio-main textarea{display:block;width:100%;border:1px solid var(--line);background:#fffdf7;padding:14px;font:14px 'DM Sans'}.studio-main textarea{min-height:150px;resize:vertical}.studio-main input:focus,.studio-main textarea:focus{outline:2px solid var(--acid);border-color:var(--ink)}.studio-actions{display:flex;gap:8px;flex-wrap:wrap;margin:25px 0}.studio-error{border:1px solid var(--red);padding:12px;font:11px 'DM Mono';background:#fff1ed}.studio-result{margin-top:30px;border:1px solid var(--ink);background:#fffdf7}.result-top{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:12px 15px}.studio-mini{font-size:8px;padding:7px}.studio-result>div:last-child{padding:22px;min-height:330px}.studio-result strong{font-size:22px}.studio-result p{color:#777}.studio-result pre{margin:0;padding:22px;min-height:330px;white-space:pre-wrap;word-break:break-word;background:#101211;color:#f4f1e8;font:12px/1.7 'DM Mono'}.studio-proof{padding:100px clamp(18px,4vw,62px);display:grid;grid-template-columns:1fr 1fr;gap:7vw}.studio-proof h2{font:700 clamp(60px,7vw,105px)/.77 'DM Sans';letter-spacing:-.07em;margin:20px 0}.proof-grid{display:grid;gap:1px}.proof-grid article{padding:24px;border-top:1px solid var(--line)}.proof-grid b{font:9px 'DM Mono';letter-spacing:.12em}.proof-grid p{color:#6b6d66;line-height:1.6}.studio button{cursor:pointer}@media(max-width:900px){.studio-grid,.studio-proof{grid-template-columns:1fr}.studio-orbit{width:340px;justify-self:start}.studio-workbench{grid-template-columns:1fr}.studio-sidebar{border-right:0;border-bottom:1px solid var(--ink)}}@media(max-width:600px){.studio h1{font-size:70px}.studio-connect>div{flex-direction:column}.studio-connect button{width:100%}.studio-kicker span:nth-child(2){display:none}.studio-orbit{width:280px}.studio-main{padding:24px 16px}.studio-actions{display:grid;grid-template-columns:1fr}.studio-run,.studio-btn{width:100%}}
</style>
</MakerLayout>
