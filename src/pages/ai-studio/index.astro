---
import MakerLayout from '../../layouts/MakerLayout.astro';
const canonical = 'https://paradox.engineer/ai-studio/';
const routerUrl = 'https://swzbxwrgahuveiaibqhq.supabase.co/functions/v1/ai-router';
---
<MakerLayout title="PARADOX AI Studio — Multi-Model AI Workbench" description="A practical AI workbench for resumes, interviews, studying, writing and coding, powered by PARADOX's server-side AI provider router." canonical={canonical}>
<main class="studio">
  <header class="hero">
    <div class="eyebrow"><span>PARADOX / AI STUDIO</span><span>05 WORKFLOWS · 05 PROVIDERS</span></div>
    <div class="hero-grid">
      <div>
        <p class="signal"><i></i> SERVER-SIDE AI WORKBENCH</p>
        <h1>Give it a job.<br><em>Get the work.</em></h1>
        <p class="lead">Choose a workflow, add your context and run it. PARADOX routes the request through its AI provider layer, so you do not need to paste an API key into the browser.</p>
        <div class="router-card"><div><b>ROUTER ONLINE</b><span>Provider selection is handled server-side.</span></div><select id="provider" aria-label="AI provider"><option value="auto">AUTO — best available</option><option value="gemini">Gemini</option><option value="groq">Groq</option><option value="cerebras">Cerebras</option><option value="huggingface">Hugging Face</option><option value="ollama">Ollama</option></select></div>
      </div>
      <div class="orbit"><strong>AI</strong><span>PARADOX<br>STUDIO</span></div>
    </div>
  </header>

  <section class="workbench">
    <aside class="sidebar">
      <div class="side-head"><span>01</span><b>WORKFLOW</b></div>
      <button class="flow active" data-flow="resume"><strong>01</strong><span>Resume Tailor<small>Match your resume to a job</small></span></button>
      <button class="flow" data-flow="interview"><strong>02</strong><span>Interview Coach<small>Generate questions + model answers</small></span></button>
      <button class="flow" data-flow="study"><strong>03</strong><span>Study Engine<small>Turn notes into a revision pack</small></span></button>
      <button class="flow" data-flow="content"><strong>04</strong><span>Content Studio<small>Idea → polished post or article</small></span></button>
      <button class="flow" data-flow="code"><strong>05</strong><span>Code Fixer<small>Explain, repair and improve code</small></span></button>
    </aside>

    <section class="main-panel">
      <div class="form-head"><div><span id="flowLabel">RESUME TAILOR</span><h2 id="flowTitle">Make the application fit.</h2></div><span id="status" class="status">READY</span></div>
      <div id="fields"></div>
      <div class="actions"><button id="run" class="run">RUN AI ↗</button><button id="clear" class="btn">CLEAR</button><button id="copy" class="btn">COPY RESULT</button></div>
      <div id="error" class="error" hidden></div>
      <article class="result"><div class="result-top"><span>02 / OUTPUT</span><button id="download" class="mini">DOWNLOAD .TXT</button></div><div id="resultEmpty"><strong>Your deliverable will appear here.</strong><p>Choose a workflow, fill the inputs and run AI.</p></div><pre id="result" hidden></pre></article>
    </section>
  </section>
</main>
<script is:inline define:vars={{ routerUrl }}>
(()=>{
  const root=document.querySelector('.studio'); if(!root)return;
  const workflows={
    resume:{label:'RESUME TAILOR',title:'Make the application fit.',fields:[['Your resume','resume','ta','Paste your resume here...'],['Job description','jd','ta','Paste the job description here...'],['Target role','role','text','Software Engineer']]},
    interview:{label:'INTERVIEW COACH',title:'Train against the actual role.',fields:[['Job description','jd','ta','Paste the job description here...'],['Your background','bg','ta','Projects, experience, skills, education...'],['Interview stage','stage','text','Technical round']]},
    study:{label:'STUDY ENGINE',title:'Turn notes into a revision system.',fields:[['Topic or chapter','topic','text','DBMS — normalization'],['Notes / source material','notes','ta','Paste class notes, textbook text or your own notes...'],['Difficulty','difficulty','text','University exam']]},
    content:{label:'CONTENT STUDIO',title:'Go from idea to publishable draft.',fields:[['Idea / brief','brief','ta','What are you trying to say?'],['Audience','audience','text','College students and young professionals'],['Format','format','text','LinkedIn post']]},
    code:{label:'CODE FIXER',title:'Understand the bug before you patch it.',fields:[['Code','code','ta','Paste the code that is failing...'],['Error / expected behaviour','errorInfo','ta','Paste the error or explain what should happen.'],['Language','language','text','JavaScript']]}
  };
  const $=s=>root.querySelector(s); const fields=$('#fields'), flowLabel=$('#flowLabel'), flowTitle=$('#flowTitle'), result=$('#result'), empty=$('#resultEmpty'), status=$('#status'), error=$('#error'), provider=$('#provider');
  let current='resume';
  function get(id){return root.querySelector('#'+id)?.value?.trim()||'';}
  function render(name){
    current=name; const f=workflows[name]; flowLabel.textContent=f.label; flowTitle.textContent=f.title;
    fields.innerHTML=f.fields.map(([label,id,type,ph])=>type==='ta'?`<label>${label}<textarea id="${id}" placeholder="${ph}"></textarea></label>`:`<label>${label}<input id="${id}" placeholder="${ph}" /></label>`).join('');
    root.querySelectorAll('.flow').forEach(b=>b.classList.toggle('active',b.dataset.flow===name)); result.hidden=true; empty.hidden=false; error.hidden=true; status.textContent='READY';
  }
  root.querySelectorAll('.flow').forEach(b=>b.addEventListener('click',()=>render(b.dataset.flow)));
  function promptFor(name){
    if(name==='resume')return `Act as an expert ATS resume strategist. Compare the resume below against the job description. Return: 1) match score /100 with reasons, 2) missing skills/keywords, 3) rewritten high-impact bullets for the most relevant experience, 4) a tailored professional summary, 5) exact changes the candidate should make. Do not invent experience or credentials.\n\nRESUME:\n${get('resume')}\n\nJOB DESCRIPTION:\n${get('jd')}\n\nTARGET ROLE:\n${get('role')}`;
    if(name==='interview')return `Act as a senior interviewer for the role described below. Create a realistic interview preparation pack: 8 role-specific questions, what a strong answer should contain, 3 technical follow-ups, 3 behavioural questions, a 30-second introduction tailored to the candidate, and 5 red flags to avoid. Ground everything in the provided job description and background.\n\nJOB DESCRIPTION:\n${get('jd')}\n\nCANDIDATE BACKGROUND:\n${get('bg')}\n\nSTAGE:\n${get('stage')}`;
    if(name==='study')return `Act as an excellent university tutor. Turn the supplied material into a high-retention revision pack: concise explanation, key concepts, formulas or rules when relevant, 12 flashcards, 10 exam-style questions with answers, common mistakes, and a one-day revision plan. Do not invent facts. Clearly mark uncertainty.\n\nTOPIC:\n${get('topic')}\n\nMATERIAL:\n${get('notes')}\n\nDIFFICULTY:\n${get('difficulty')}`;
    if(name==='content')return `Act as a sharp editor and content strategist. Transform the brief into a publishable ${get('format')}. Give it a strong hook, concrete value, natural human voice, useful structure and a clear ending. Avoid generic AI filler, fake statistics, empty hype and overdone emojis. Also provide 3 alternative hooks.\n\nIDEA:\n${get('brief')}\n\nAUDIENCE:\n${get('audience')}`;
    return `Act as a senior ${get('language')} engineer. Diagnose the supplied code and error. Return: root cause, exact corrected code, critical-fix explanation, tests or test cases that should be added, and one improvement that would prevent the bug recurring. Do not rewrite unrelated code.\n\nCODE:\n${get('code')}\n\nERROR / EXPECTED BEHAVIOUR:\n${get('errorInfo')}\n\nLANGUAGE:\n${get('language')}`;
  }
  async function run(){
    error.hidden=true; const f=workflows[current];
    if(f.fields.map(x=>x[1]).some(id=>!get(id))){error.textContent='Complete the workflow inputs first.';error.hidden=false;return;}
    status.textContent='RUNNING'; result.hidden=false; empty.hidden=true; result.textContent='Generating…';
    try{
      const res=await fetch(routerUrl,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({provider:provider.value,task:current,prompt:promptFor(current),system:'You are PARADOX AI Studio. Be specific, truthful, useful and concise. Never invent credentials, sources, statistics or facts. State uncertainty when evidence is missing.'})});
      const data=await res.json().catch(()=>null); if(!res.ok)throw new Error(data?.error||'AI router request failed');
      result.textContent=data?.text||'No output returned.'; status.textContent=`DONE · ${(data.provider||'AI').toUpperCase()}`;
      window.gtag?.('event','ai_studio_run',{workflow:current,provider:data.provider||'auto'});
    }catch(e){result.hidden=true;empty.hidden=false;error.textContent=e?.message||'AI request failed.';error.hidden=false;status.textContent='ERROR';}
  }
  $('#run').addEventListener('click',run); $('#clear').addEventListener('click',()=>render(current));
  $('#copy').addEventListener('click',async()=>{if(result.hidden)return;await navigator.clipboard.writeText(result.textContent);status.textContent='COPIED';});
  $('#download').addEventListener('click',()=>{if(result.hidden)return;const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([result.textContent],{type:'text/plain'}));a.download='paradox-ai-result.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),800);});
  render('resume');
})();
</script>
<style>
.studio{--ink:#0c0e0e;--paper:#f3f0e7;--line:#c5c1b6;--red:#ff593f;background:var(--paper);color:var(--ink);max-width:1440px;margin:auto}.hero{padding:24px clamp(18px,4vw,60px) 70px;min-height:72vh}.eyebrow,.signal,.side-head,.result-top,.status,.router-card,.studio label,.btn,.run,.mini{font:9px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase}.eyebrow{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:12px}.hero-grid{display:grid;grid-template-columns:1.2fr .6fr;gap:7vw;align-items:center;min-height:60vh}.signal{margin-top:38px}.signal i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--red);margin-right:8px}.studio h1{font:700 clamp(66px,10vw,150px)/.74 'DM Sans';letter-spacing:-.08em;margin:24px 0}.studio h1 em,.studio h2 em{font-family:'Instrument Serif',serif;font-weight:400}.lead{max-width:660px;font-size:17px;line-height:1.55;color:#55574f}.router-card{display:flex;align-items:center;justify-content:space-between;gap:20px;max-width:700px;margin-top:28px;border:1px solid var(--ink);padding:14px 16px;background:#fffdf7}.router-card b{display:block}.router-card span{display:block;color:#777;margin-top:5px;text-transform:none;letter-spacing:0;font:12px 'DM Sans'}.router-card select{border:1px solid var(--ink);background:transparent;padding:11px 12px;font:11px 'DM Mono';max-width:240px}.orbit{width:min(32vw,410px);aspect-ratio:1;border:1px solid #aaa;border-radius:50%;justify-self:end;display:grid;place-items:center;position:relative}.orbit:before,.orbit:after{content:'';position:absolute;inset:9%;border:1px solid #aaa;border-radius:50%;transform:rotate(52deg) scaleX(1.7)}.orbit:after{transform:rotate(-52deg) scaleX(1.7)}.orbit strong{display:grid;place-items:center;width:128px;height:128px;border-radius:50%;background:var(--ink);color:#fff;font-size:42px;box-shadow:15px 15px 0 var(--red)}.orbit span{position:absolute;bottom:17%;font:8px 'DM Mono';text-align:center;color:#777}.workbench{display:grid;grid-template-columns:300px 1fr;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);min-height:760px}.sidebar{padding:24px;border-right:1px solid var(--ink)}.side-head{display:flex;justify-content:space-between;padding-bottom:18px;border-bottom:1px solid var(--line)}.flow{width:100%;display:grid;grid-template-columns:34px 1fr;gap:10px;text-align:left;border:0;border-bottom:1px solid var(--line);background:transparent;padding:18px 3px;color:var(--ink)}.flow:hover,.flow.active{background:#fff}.flow strong{font:9px 'DM Mono';color:#999}.flow span{font:700 14px 'DM Sans'}.flow small{display:block;margin-top:5px;color:#777;font:11px 'DM Sans'}.flow.active span{color:var(--red)}.main-panel{padding:30px clamp(18px,4vw,54px)}.form-head{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding-bottom:18px}.form-head>div>span{font:9px 'DM Mono';letter-spacing:.12em}.studio h2{font:700 clamp(36px,5vw,68px)/.85 'DM Sans';letter-spacing:-.06em;margin:12px 0 0}.status{border:1px solid var(--line);padding:8px 10px;height:max-content}.studio label{display:block;margin:20px 0 7px}.studio input,.studio textarea{display:block;width:100%;box-sizing:border-box;border:1px solid var(--line);background:#fffdf7;padding:14px;font:14px 'DM Sans';color:var(--ink)}.studio textarea{min-height:170px;resize:vertical}.actions{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}.run,.btn,.mini{border:1px solid var(--ink);padding:13px 16px;background:transparent}.run{background:var(--ink);color:#fff}.run:hover{background:var(--red)}.btn:hover,.mini:hover{background:#fff}.error{border:1px solid var(--red);background:#fff2ef;padding:12px 14px;font:12px 'DM Mono';line-height:1.5}.result{margin-top:22px;border-top:1px solid var(--ink);background:#0d0f0f;color:#f6f1e6;min-height:420px}.result-top{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid #343636}.mini{color:#fff;border-color:#555}.result pre{white-space:pre-wrap;word-break:break-word;padding:22px;font:13px/1.65 'DM Mono';margin:0}.result:has(#resultEmpty:not([hidden])) #resultEmpty{padding:70px 25px;color:#9b9b94}.result:has(#resultEmpty:not([hidden])) #resultEmpty strong{font:700 18px 'DM Sans';color:#fff}.result p{color:#aaa;font:13px 'DM Sans'}@media(max-width:900px){.hero-grid{grid-template-columns:1fr}.orbit{width:min(58vw,340px);justify-self:start;margin-top:15px}.workbench{grid-template-columns:1fr}.sidebar{border-right:0;border-bottom:1px solid var(--ink)}}@media(max-width:600px){.eyebrow{font-size:8px}.hero{min-height:auto}.studio h1{font-size:62px}.router-card{align-items:flex-start;flex-direction:column}.router-card select{max-width:none;width:100%}.form-head{align-items:flex-start}.status{font-size:8px}.actions>*{flex:1}.orbit{margin-bottom:10px}}
</style>
</MakerLayout>
