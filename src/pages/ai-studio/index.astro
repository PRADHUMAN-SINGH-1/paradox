---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AITool from '../../components/ai/AITool.astro';
import aiTools from '../../data/ai/ai-tools.json';
const canonical='https://paradox.engineer/ai-studio/';
---
<BaseLayout title="PARADOX AI Studio — Multi-Model AI Workbench" description="A unified AI workbench for practical workflows, developer utilities and live AI signals." canonical={canonical}>
<main class="studio" id="studioPage" data-active-section="workflows">
<section class="studio-hero"><div class="hero-meta"><span>PARADOX / AI STUDIO</span><span>04 WORKFLOWS · 16 UTILITIES · LIVE SIGNALS</span></div><div class="hero-grid"><div><p class="eyebrow"><i></i> SERVER-SIDE AI WORKBENCH</p><h1>Make AI.<br><em>do the work.</em></h1><p class="lead">One workspace for applications, interviews, study and content. Developer utilities and live AI signals stay inside the same interface.</p><div class="router"><div><b>ROUTER ONLINE</b><span>Credentials stay server-side. AUTO falls back through available providers.</span></div><select id="provider" aria-label="AI provider"><option value="auto">AUTO — best available</option><option value="gemini">Gemini</option><option value="groq">Groq</option><option value="cerebras">Cerebras</option><option value="huggingface">Hugging Face</option><option value="ollama">Ollama</option></select></div></div><div class="orbit"><div class="ring one"></div><div class="ring two"></div><strong>AI</strong><span>PARADOX<br>STUDIO</span></div></div></section>
<nav class="switcher" role="tablist"><button type="button" class="active" data-section-tab="workflows">01 / WORKFLOWS <small>04</small></button><button type="button" data-section-tab="toolkit">02 / DEVELOPER TOOLKIT <small>16</small></button><button type="button" data-section-tab="radar">03 / LIVE RADAR <small>03 FEEDS</small></button></nav>
<section id="studioWorkflows" class="workbench"><aside class="flow-nav"><div class="nav-head"><span>WORKFLOW</span><span>01—04</span></div><button class="flow active" data-flow="resume" type="button"><b>01</b><span>Resume Tailor<small>Match your resume to a job</small></span><i>↗</i></button><button class="flow" data-flow="interview" type="button"><b>02</b><span>Interview Coach<small>Prepare against the actual role</small></span><i>↗</i></button><button class="flow" data-flow="study" type="button"><b>03</b><span>Study Engine<small>Build a revision system from notes</small></span><i>↗</i></button><button class="flow" data-flow="content" type="button"><b>04</b><span>Content Studio<small>Turn an idea into publishable content</small></span><i>↗</i></button></aside><section class="work-panel"><header class="panel-head"><div><span id="flowLabel">RESUME TAILOR</span><h2 id="flowTitle">Make the application fit.</h2><p id="flowDescription">Turn your actual experience into a role-specific, ATS-aware application without inventing anything.</p></div><strong id="status">READY</strong></header><div id="workflowFields" class="workflow-fields">
  <div class="workflow-form active" data-workflow-form="resume">
    <div class="resume-dropzone" data-resume-dropzone>
      <input id="resumeFile" data-field="resume-file" type="file" accept=".pdf,.doc,.docx,.txt,.md,.rtf,.csv,.json" />
      <div class="resume-dropzone-copy">
        <strong>ATTACH YOUR RESUME</strong>
        <span>PDF, Word, text and common document formats</span>
        <small data-resume-status>No file selected</small>
      </div>
      <button type="button" data-resume-browse>CHOOSE FILE ↗</button>
    </div>
    <div class="workflow-form-field"><label for="resume-jd"><span>Job description</span><textarea id="resume-jd" data-field="jd" rows="9" placeholder="Paste the complete job description here..."></textarea></label></div>
    <div class="resume-example-note" data-resume-example-note hidden></div>
    <div class="workflow-form-field compact">
      <label for="resume-role"><span>Target role</span><input id="resume-role" data-field="role" placeholder="Software Engineer" /></label>
    </div>
  </div>
  <div class="workflow-form" data-workflow-form="interview" hidden>
    <div class="workflow-form-field"><label for="interview-jd"><span>Job description</span><textarea id="interview-jd" data-field="jd" rows="8" placeholder="Paste the complete job description here..."></textarea></label></div>
    <div class="workflow-form-field"><label for="interview-bg"><span>Your background</span><textarea id="interview-bg" data-field="bg" rows="8" placeholder="Projects, experience, skills, education..."></textarea></label></div>
    <div class="workflow-form-field"><label for="interview-stage"><span>Interview stage</span><input id="interview-stage" data-field="stage" placeholder="Technical interview" /></label></div>
  </div>
  <div class="workflow-form" data-workflow-form="study" hidden>
    <div class="workflow-form-field"><label for="study-topic"><span>Topic</span><input id="study-topic" data-field="topic" placeholder="DBMS — normalization" /></label></div>
    <div class="workflow-form-field"><label for="study-notes"><span>Notes / source material</span><textarea id="study-notes" data-field="notes" rows="10" placeholder="Paste notes or source material..."></textarea></label></div>
    <div class="workflow-form-field"><label for="study-difficulty"><span>Difficulty / exam</span><input id="study-difficulty" data-field="difficulty" placeholder="University exam" /></label></div>
  </div>
  <div class="workflow-form" data-workflow-form="content" hidden>
    <div class="workflow-form-field"><label for="content-brief"><span>Idea / brief</span><textarea id="content-brief" data-field="brief" rows="8" placeholder="Describe what you want to publish..."></textarea></label></div>
    <div class="workflow-form-field"><label for="content-audience"><span>Audience</span><input id="content-audience" data-field="audience" placeholder="Developers and students" /></label></div>
    <div class="workflow-form-field"><label for="content-format"><span>Format / platform</span><input id="content-format" data-field="format" placeholder="LinkedIn post" /></label></div>
  </div>
</div><div class="actions"><button id="run" class="primary" type="button">RUN AI ↗</button><button id="example" type="button">TRY EXAMPLE</button><button id="clear" type="button">CLEAR</button><button id="copy" type="button">COPY RESULT</button></div><div id="error" class="error" hidden></div><article class="result"><header><span>02 / OUTPUT</span><button id="download" type="button">DOWNLOAD .TXT</button></header><div class="result-meta"><span class="px-result-provider">AI</span><span class="px-result-latency">READY</span></div><div id="resultEmpty"><strong>Your deliverable will appear here.</strong><span>Choose a workflow, provide context and run AI.</span></div><pre id="result" hidden></pre></article></section></section>
<section id="studioToolkit" class="module" hidden>
<header class="module-head"><div><span>02 / FOCUSED_UTILITIES</span><h2>Developer Toolkit.</h2><p>Sixteen focused browser-first utilities. Select one tool; only that tool occupies the workspace.</p></div><strong>16 TOOLS · LOCAL + AI ASSIST</strong></header>
<div class="tool-layout">
<nav class="tool-index" aria-label="Developer tools">
{aiTools.map((t, i) => (
  <button type="button" class:list={['studio-tool-select', i === 0 && 'active']} data-tool-select={t.slug} data-tool-mode={t.mode}>
    <b>{String(i + 1).padStart(2, '0')}</b>
    <span>{t.label}<small>{t.description}</small></span>
  </button>
))}
</nav>
<div class="tool-host" id="toolHost">
{aiTools.map((t, i) => (
  <div class="studio-tool-instance" data-studio-tool-instance={t.mode} hidden={i !== 0}>
    <AITool mode={t.mode} title={t.title} intro={t.description} headingLevel="h2" />
  </div>
))}
</div>
</div>
</section>

<section id="studioRadar" class="module" hidden><header class="module-head"><div><span>03 / LIVE_OBSERVABILITY</span><h2>AI Radar Station.</h2><p>Live public model, repository and AI-news signals, loaded from this workspace.</p></div><div class="radar-actions"><strong id="radarStatus">READY</strong><button id="radarRefresh" type="button">REFRESH ↻</button></div></header><div class="radar-grid"><section><header><span>TRENDING MODELS</span><b>HUGGING FACE</b></header><div id="radarModels" class="radar-list"><p>Open Radar to fetch live models.</p></div></section><section><header><span>DEVELOPER SIGNALS</span><b>GITHUB</b></header><div id="radarGithub" class="radar-list"><p>Open Radar to fetch repositories.</p></div></section><section><header><span>AI STORIES</span><b>HACKER NEWS</b></header><div id="radarNews" class="radar-list"><p>Open Radar to fetch current stories.</p></div></section></div></section>
</main>
<script>import '../../scripts/studio/ai-tool-runtime.ts';</script>
<style>
.studio{min-height:100vh;position:relative;z-index:2;background:transparent;color:#eef1f4}.studio [hidden]{display:none!important}.studio[data-active-section="toolkit"]>.studio-hero,.studio[data-active-section="radar"]>.studio-hero{display:none}.studio[data-active-section="toolkit"]>.workbench,.studio[data-active-section="radar"]>.workbench{display:none!important}.studio[data-active-section="workflows"]>.module{display:none!important}.studio-hero,.workbench,.module{max-width:1600px;margin:auto}.studio-hero{padding:32px clamp(20px,4vw,64px) 70px}.hero-meta{display:flex;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.11);padding-bottom:14px;color:#77818e;font:800 9px var(--font-mono);letter-spacing:.13em}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:5vw;align-items:center;padding-top:60px}.eyebrow,.nav-head,.module-head>div>span{font:800 10px var(--font-mono);letter-spacing:.13em;color:#7d8794;text-transform:uppercase}.eyebrow i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#5878ff;margin-right:9px;box-shadow:0 0 0 5px rgba(88,120,255,.1)}.hero-grid h1{margin:18px 0 25px;color:#f5f7f9;font:800 clamp(72px,10vw,150px)/.78 var(--font-display);letter-spacing:-.09em;text-shadow:0 0 18px rgba(255,255,255,.08)}.hero-grid h1 em{font-style:normal;color:#aeb6c3}.lead{max-width:760px;color:#a5aebb;font:500 17px/1.65 var(--font-sans)}.router{display:flex;justify-content:space-between;align-items:center;gap:20px;max-width:800px;margin-top:28px;padding:16px;border:1px solid rgba(255,255,255,.13);background:rgba(6,9,13,.74);backdrop-filter:blur(12px);font:800 9px var(--font-mono);letter-spacing:.1em}.router b{color:#f2f5f7}.router span{display:block;margin-top:6px;color:#747f8c;font:500 11px/1.45 var(--font-sans);letter-spacing:0}.router select{min-width:245px;padding:12px;border:1px solid #313a46;background:#11161d;color:#edf1f4;font:800 10px var(--font-mono)}.orbit{position:relative;width:min(34vw,440px);aspect-ratio:1;justify-self:end;display:grid;place-items:center}.ring{position:absolute;inset:8%;border:1px solid rgba(200,210,230,.24);border-radius:50%;transform:rotate(38deg) scaleX(1.45);animation:spin 16s linear infinite}.ring.two{transform:rotate(-42deg) scaleX(1.45);animation-direction:reverse}.orbit strong{width:132px;height:132px;border-radius:50%;display:grid;place-items:center;background:#080b0f;color:#fff;font:800 42px var(--font-display);box-shadow:18px 18px 0 #4f6ff1;z-index:2}.orbit span{position:absolute;bottom:11%;text-align:center;color:#707a87;font:800 8px/1.4 var(--font-mono);letter-spacing:.13em}.switcher{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid rgba(255,255,255,.1);background:rgba(5,7,9,.86);backdrop-filter:blur(18px);position:sticky;top:82px;z-index:20}.switcher button{min-height:66px;border:0;border-right:1px solid rgba(255,255,255,.1);background:transparent;color:#727d8a;padding:0 20px;text-align:left;font:800 10px var(--font-mono);letter-spacing:.1em}.switcher button.active{background:#f0f2f5;color:#090b0e}.switcher small{float:right}.workbench{display:grid;grid-template-columns:320px minmax(0,1fr);min-height:760px}.flow-nav{padding:22px 18px;background:rgba(5,7,9,.7);border-right:1px solid rgba(255,255,255,.1)}.nav-head{display:flex;justify-content:space-between;padding:0 5px 16px;border-bottom:1px solid rgba(255,255,255,.1)}.flow{width:100%;display:grid;grid-template-columns:30px minmax(0,1fr) 18px;gap:10px;padding:19px 7px;border:0;border-bottom:1px solid rgba(255,255,255,.08);background:transparent;color:#7b8592;text-align:left}.flow b,.flow i{font:800 9px var(--font-mono);color:#66717e}.flow span{font:800 12px/1.3 var(--font-mono);color:#b0b8c3}.flow small{display:block;margin-top:6px;color:#697481;font:500 10px/1.4 var(--font-sans)}.flow.active{background:#f1f3f5}.flow.active span{color:#0b0e12}.flow.active b,.flow.active i{color:#4f6ff1}.work-panel{min-width:0;padding:32px clamp(18px,3.5vw,52px);background:rgba(5,7,9,.66)}.panel-head{display:flex;justify-content:space-between;gap:22px;border-bottom:1px solid rgba(255,255,255,.1);padding-bottom:22px}.panel-head>div>span{color:#6d8cff;font:800 10px var(--font-mono);letter-spacing:.13em}.panel-head h2{margin:10px 0 8px;color:#f2f4f7;font:800 clamp(40px,4.5vw,70px)/.88 var(--font-display);letter-spacing:-.06em}.panel-head p{max-width:700px;margin:0;color:#7e8996;font:500 14px/1.55 var(--font-sans)}#status{height:max-content;padding:9px 11px;border:1px solid rgba(255,255,255,.13);color:#8994a0;font:800 9px var(--font-mono)}.fields{display:grid;grid-template-columns:1fr;gap:18px;margin-top:24px;min-width:0}.fields label{min-width:0}.fields input,.fields textarea{display:block!important;width:100%!important;max-width:none!important;box-sizing:border-box!important;min-width:0!important}.fields label{display:grid;gap:8px;color:#87919e;font:800 10px var(--font-mono);letter-spacing:.09em;text-transform:uppercase}.fields input,.fields textarea{width:100%;box-sizing:border-box;padding:14px 15px;border:1px solid rgba(255,255,255,.14);background:rgba(11,15,20,.9);color:#f1f4f7;font:500 15px/1.55 var(--font-sans)}.fields textarea{min-height:180px;resize:vertical}.fields input::placeholder,.fields textarea::placeholder{color:#66717e}.fields input:focus,.fields textarea:focus{outline:2px solid rgba(89,117,255,.25);border-color:#6884ff}.actions{display:flex;flex-wrap:wrap;gap:9px;margin:20px 0}.actions button,.result header button,.radar-actions button{padding:12px 14px;border:1px solid rgba(255,255,255,.15);background:#11161c;color:#e7ebef;font:800 9px var(--font-mono);letter-spacing:.08em}.actions .primary{background:#f0f2f5;color:#080a0d;border-color:#f0f2f5}.error{padding:12px 14px;border:1px solid rgba(255,80,80,.4);background:rgba(255,50,50,.08);color:#ffb2b2;font:500 11px var(--font-mono)}.result{min-height:410px;border:1px solid rgba(255,255,255,.13);background:rgba(3,5,7,.9)}.result header,.result-meta{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 15px;border-bottom:1px solid rgba(255,255,255,.09);color:#77828f;font:800 9px var(--font-mono);letter-spacing:.1em}.result-meta{font-size:9px}.px-result-provider{color:#5ee0b4}.result #resultEmpty{padding:70px 24px;color:#6f7a87}.result #resultEmpty strong{display:block;color:#eef2f5;font:800 21px var(--font-display)}.result #resultEmpty span{display:block;margin-top:7px;font:500 12px var(--font-sans)}.result pre{margin:0;padding:22px;max-height:700px;overflow:auto;white-space:pre-wrap;word-break:break-word;color:#e8edf2;font:500 12px/1.75 var(--font-mono)}.module{padding:58px clamp(20px,4vw,64px) 100px;background:rgba(5,7,9,.52)}.module-head{display:flex;justify-content:space-between;gap:24px;align-items:end;padding-bottom:22px;border-bottom:1px solid rgba(255,255,255,.1)}.module-head h2{margin:10px 0;color:#f2f4f7;font:800 clamp(48px,6vw,88px)/.86 var(--font-display);letter-spacing:-.07em}.module-head p{max-width:760px;color:#838e9b;font:500 14px/1.6 var(--font-sans)}.module-head>strong,.radar-actions strong{padding:9px 11px;border:1px solid rgba(255,255,255,.13);color:#7e8996;font:800 9px var(--font-mono)}.tool-layout{display:grid;grid-template-columns:330px minmax(0,1fr);gap:14px;margin-top:22px}.tool-index{display:grid;align-content:start;gap:7px}.studio-tool-select{display:grid;grid-template-columns:28px minmax(0,1fr);gap:10px;min-height:76px;padding:13px;border:1px solid rgba(255,255,255,.11);background:rgba(10,14,19,.72);color:#e0e5ea;text-align:left}.studio-tool-select b{color:#687381;font:800 9px var(--font-mono)}.studio-tool-select span{font:800 11px/1.3 var(--font-mono)}.studio-tool-select small{display:block;margin-top:5px;color:#727d8a;font:500 10px/1.35 var(--font-sans)}.studio-tool-select.active{background:#f0f2f5;color:#090b0e}.studio-tool-select.active b{color:#4f6ff1}.studio-tool-select.active small{color:#5b646e}.tool-host{min-width:0;border:1px solid rgba(255,255,255,.11);padding:18px;background:rgba(8,11,15,.72);overflow:hidden}.tool-host .field{min-width:0}.tool-host .field input,.tool-host .field textarea{display:block!important;width:100%!important;max-width:none!important;min-width:0!important;box-sizing:border-box!important}.tool-host .generator-fields{display:grid!important;grid-template-columns:1fr!important;gap:14px!important}.tool-host .generator-page{min-height:0!important;padding:0!important;background:transparent!important;color:#edf1f4!important}.tool-host .generator-breadcrumb,.tool-host .generator-head,.tool-host .ad-slot,.tool-host .generator-info{display:none!important}.tool-host .generator-layout{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px;margin:0!important}.tool-host .generator-panel,.tool-host .generator-preview{min-height:420px!important;background:rgba(13,17,22,.86)!important;color:#edf1f4!important;border-color:rgba(255,255,255,.11)!important}.tool-host .generator-fields{padding:18px!important}.tool-host .field input,.tool-host .field textarea{background:#090d12!important;color:#eef2f5!important;border-color:#2d3640!important}.tool-host .gen-btn{background:#11161c!important;color:#edf0f3!important;border-color:#35404c!important}.tool-host .gen-btn:first-child{background:#f0f2f5!important;color:#080a0d!important}.tool-host .preview-empty{background:transparent!important;color:#74808d!important}.tool-host .preview-empty strong{color:#eef1f4!important}.tool-host .gen-output,.tool-host .code-block{background:#06080b!important;color:#e9eef3!important}.radar-actions{display:flex;align-items:center;gap:8px}.radar-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:22px}.radar-grid>section{min-width:0;border:1px solid rgba(255,255,255,.11);background:rgba(9,12,16,.74)}.radar-grid header{display:flex;justify-content:space-between;gap:12px;padding:14px;border-bottom:1px solid rgba(255,255,255,.08);color:#e0e5ea;font:800 9px var(--font-mono);letter-spacing:.1em}.radar-grid header b{color:#687381}.radar-list p{padding:18px;color:#697481;font:500 11px/1.5 var(--font-mono)}.studio-radar-card{display:grid;gap:6px;padding:15px;border-bottom:1px solid rgba(255,255,255,.08);color:#e7ebef}.studio-radar-card strong{font:700 12px/1.4 var(--font-sans);overflow-wrap:anywhere}.studio-radar-card span{color:#6f7a87;font:500 10px var(--font-mono)}
@keyframes spin{to{transform:rotate(398deg) scaleX(1.45)}}
@media(max-width:1000px){.hero-grid,.workbench,.tool-layout{grid-template-columns:1fr}.studio[data-active-section="toolkit"] .tool-layout,.studio[data-active-section="radar"] .radar-grid{grid-template-columns:1fr}.orbit{width:min(65vw,360px);justify-self:center}.flow-nav{border-right:0;border-bottom:1px solid rgba(255,255,255,.1)}.tool-index{grid-template-columns:repeat(2,minmax(0,1fr))}.tool-host .generator-layout,.radar-grid{grid-template-columns:1fr}.switcher{position:static}}
@media(max-width:700px){.studio .module-head h2{font-size:clamp(42px,12vw,72px)}.studio-hero{padding:20px 18px 48px}.hero-meta{flex-direction:column;gap:9px}.hero-grid{padding-top:40px}.hero-grid h1{font-size:clamp(58px,17vw,100px)}.lead{font-size:15px}.router{flex-direction:column;align-items:stretch}.router select{min-width:0;width:100%}.switcher{grid-template-columns:1fr}.switcher button{min-height:54px;border-right:0;border-bottom:1px solid rgba(255,255,255,.08)}.flow-nav{padding:16px}.work-panel{padding:24px 16px}.panel-head{flex-direction:column}.actions button{width:100%}.module{padding:40px 18px 70px}.module-head{flex-direction:column;align-items:flex-start}.tool-index{grid-template-columns:1fr}.tool-host{padding:10px}.tool-host .generator-layout{grid-template-columns:1fr}.tool-host .generator-preview{min-height:330px!important}.orbit{width:82vw}.orbit strong{width:104px;height:104px;font-size:34px}}
@media(prefers-reduced-motion:reduce){.ring{animation:none}}
.studio .studio-tool-instance[hidden]{display:none!important}
.studio .tool-host{display:block;min-width:0;overflow:hidden}
.studio .tool-host .generator-page{width:100%;max-width:none!important;min-height:0!important;padding:0!important;margin:0!important;background:transparent!important;border:0!important}
.studio .tool-host .generator-breadcrumb,.studio .tool-host .generator-head,.studio .tool-host .ad-slot,.studio .tool-host .generator-info{display:none!important}
.studio .tool-host .generator-layout{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;align-items:stretch!important;gap:16px!important;width:100%!important;margin:0!important}
.studio .tool-host .generator-panel,.studio .tool-host .generator-preview{min-width:0!important;max-width:none!important;width:auto!important;margin:0!important;border:1px solid rgba(255,255,255,.12)!important;background:rgba(7,10,14,.9)!important}
.studio .tool-host .generator-panel-head,.studio .tool-host .generator-preview-head{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;padding:14px 16px!important;border-bottom:1px solid rgba(255,255,255,.09)!important;background:rgba(255,255,255,.02)!important}
.studio .tool-host .generator-panel-head h2,.studio .tool-host .generator-preview-head h2{margin:0!important;color:#edf1f5!important;font:800 10px var(--font-mono)!important;letter-spacing:.1em!important;text-transform:uppercase!important}
.studio .tool-host .generator-panel-head span,.studio .tool-host .generator-preview-head span{color:#6e7885!important;font:700 9px var(--font-mono)!important;text-transform:uppercase!important}
.studio .tool-host .generator-fields{display:grid!important;grid-template-columns:1fr!important;gap:16px!important;padding:18px!important}
.studio .tool-host .field{display:grid!important;grid-template-columns:1fr!important;gap:8px!important;min-width:0!important;width:100%!important}
