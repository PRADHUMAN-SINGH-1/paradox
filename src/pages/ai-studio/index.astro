---
import MakerLayout from '../../layouts/MakerLayout.astro';
import AITool from '../../components/AITool.astro';
import aiTools from '../../data/ai-tools.json';
const canonical = 'https://paradox.engineer/ai-studio/';
const toolkitStart = aiTools[0];
---
<MakerLayout title="PARADOX AI Studio — Multi-Model AI Workbench" description="A practical AI workbench for resumes, interviews, studying, writing and coding, powered by PARADOX's server-side AI provider router." canonical={canonical}>
<main class="studio">
  <header class="hero">
    <div class="eyebrow"><span>PARADOX / AI STUDIO</span><span>05 WORKFLOWS · MULTI-PROVIDER ROUTER</span></div>
    <div class="hero-grid">
      <div>
        <p class="signal"><i></i> SERVER-SIDE AI WORKBENCH</p>
        <h1>Give it a job.<br><em>Get the work.</em></h1>
        <p class="lead">Five focused workflows share one reliable controller. Switch workflows without losing the interface, load an example, run through the server-side provider router, copy the result or download it.</p>
        <div class="router-card"><div><b>ROUTER ONLINE</b><span>Provider credentials remain server-side. Auto mode falls back through available providers.</span></div><select id="provider" aria-label="AI provider"><option value="auto">AUTO — best available</option><option value="gemini">Gemini</option><option value="groq">Groq</option><option value="cerebras">Cerebras</option><option value="huggingface">Hugging Face</option><option value="ollama">Ollama</option></select></div>
      </div>
      <div class="orbit" aria-hidden="true"><strong>AI</strong><span>PARADOX<br>STUDIO</span></div>
    </div>
  </header>
  <div class="studio-switcher" role="tablist" aria-label="Studio modules"><button type="button" class="studio-switcher-btn active" data-section-tab="workflows">01 / WORKFLOWS</button><button type="button" class="studio-switcher-btn" data-section-tab="toolkit">02 / DEVELOPER TOOLKIT <span>16</span></button><button type="button" class="studio-switcher-btn" data-section-tab="radar">03 / LIVE RADAR</button></div>
  <section id="studioWorkflows" class="workbench" aria-label="AI Studio workbench">
    <aside class="sidebar">
      <div class="side-head"><span>01</span><b>WORKFLOW</b></div>
      <button type="button" class="flow active" data-flow="resume"><strong>01</strong><span>Resume Tailor<small>Match your resume to a job</small></span></button>
      <button type="button" class="flow" data-flow="interview"><strong>02</strong><span>Interview Coach<small>Generate questions + answer framework</small></span></button>
      <button type="button" class="flow" data-flow="study"><strong>03</strong><span>Study Engine<small>Turn notes into a revision pack</small></span></button>
      <button type="button" class="flow" data-flow="content"><strong>04</strong><span>Content Studio<small>Turn an idea into publishable content</small></span></button>
      <button type="button" class="flow" data-flow="code"><strong>05</strong><span>Code Fixer<small>Diagnose and repair a concrete bug</small></span></button>
    </aside>
    <section class="main-panel">
      <div class="form-head"><div><span id="flowLabel">RESUME TAILOR</span><h2 id="flowTitle">Make the application fit.</h2></div><span id="status" class="status">READY</span></div>
      <div id="fields" aria-live="polite"></div>
      <div class="actions"><button type="button" id="run" class="run">RUN AI ↗</button><button type="button" id="example" class="btn">TRY EXAMPLE</button><button type="button" id="clear" class="btn">CLEAR</button><button type="button" id="copy" class="btn">COPY RESULT</button></div>
      <div id="error" class="error" hidden role="alert"></div>
      <article class="result"><div class="result-top"><span>02 / OUTPUT</span><button type="button" id="download" class="mini">DOWNLOAD .TXT</button></div><div class="px-result-meta"><span class="px-result-provider">AI</span><span class="px-result-latency">READY</span></div><div id="resultEmpty"><strong>Your deliverable will appear here.</strong><p>Choose a workflow, fill the inputs and run AI.</p></div><pre id="result" hidden></pre></article>
    </section>
  </section>
<section id="studioToolkit" class="studio-module" hidden aria-label="Developer AI Toolkit">
    <div class="studio-module-head"><div><span class="module-kicker">02 / FOCUSED_UTILITIES</span><h2>Developer Toolkit.</h2><p>All 16 browser-first developer AI tools live inside this Studio workspace. No separate tool pages.</p></div><span class="module-status">LOCAL · READY</span></div>
    <div class="tool-library">{aiTools.map((t,i)=><button type="button" class="studio-tool-select{i===0?' active':''}" data-tool-select={t.slug} data-tool-mode={t.mode}><b>{String(i+1).padStart(2,'0')}</b><span>{t.label}<small>{t.description}</small></span></button>)}</div>
    <div class="studio-tool-host"><AITool mode={toolkitStart.mode} title={toolkitStart.title} intro={toolkitStart.description} headingLevel="h2" /></div>
  </section>
  <section id="studioRadar" class="studio-module" hidden aria-label="Live AI Radar">
    <div class="studio-module-head"><div><span class="module-kicker">03 / LIVE_OBSERVABILITY</span><h2>AI Radar Station.</h2><p>Live public model, GitHub and Hacker News signals, now inside the same Studio instead of a separate route.</p></div><span id="radarStatus" class="module-status">READY</span></div>
    <div class="radar-grid"><section><div class="radar-head"><span>TRENDING MODELS</span><b>HUGGING FACE</b></div><div id="radarModels" class="radar-list"><p class="radar-empty">Open Radar to load live models.</p></div></section><section><div class="radar-head"><span>DEVELOPER SIGNALS</span><b>GITHUB</b></div><div id="radarGithub" class="radar-list"><p class="radar-empty">Open Radar to load projects.</p></div></section><section><div class="radar-head"><span>AI STORIES</span><b>HACKER NEWS</b></div><div id="radarNews" class="radar-list"><p class="radar-empty">Open Radar to load stories.</p></div></section></div>
  </section>
</main>
<style>
.studio{--ink:#0c0e0e;--paper:#f3f0e7;--line:#c5c1b6;--red:#ff593f;background:var(--paper);color:var(--ink);max-width:1440px;margin:auto;overflow:hidden}.hero{padding:24px clamp(18px,4vw,60px) 70px;min-height:72vh}.eyebrow,.signal,.side-head,.result-top,.status,.router-card,.studio label,.btn,.run,.mini{font:9px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase}.eyebrow{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding-bottom:12px}.hero-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(240px,.6fr);gap:7vw;align-items:center;min-height:60vh}.signal{margin-top:38px}.signal i{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--red);margin-right:8px}.studio h1{font:700 clamp(58px,10vw,150px)/.78 'DM Sans';letter-spacing:-.08em;margin:24px 0}.studio h1 em,.studio h2 em{font-family:'Instrument Serif',serif;font-weight:400}.lead{max-width:680px;font-size:17px;line-height:1.55;color:#55574f}.router-card{display:flex;align-items:center;justify-content:space-between;gap:20px;max-width:760px;margin-top:28px;border:1px solid var(--ink);padding:14px 16px;background:#fffdf7}.router-card b{display:block}.router-card span{display:block;color:#777;margin-top:5px;text-transform:none;letter-spacing:0;font:12px 'DM Sans';line-height:1.45}.router-card select{border:1px solid var(--ink);background:#fffdf7;padding:11px 12px;font:11px 'DM Mono';max-width:240px}.orbit{width:min(32vw,410px);aspect-ratio:1;border:1px solid #aaa;border-radius:50%;justify-self:end;display:grid;place-items:center;position:relative}.orbit:before,.orbit:after{content:'';position:absolute;inset:9%;border:1px solid #aaa;border-radius:50%;transform:rotate(52deg) scaleX(1.7)}.orbit:after{transform:rotate(-52deg) scaleX(1.7)}.orbit strong{display:grid;place-items:center;width:128px;height:128px;border-radius:50%;background:var(--ink);color:#fff;font-size:42px;box-shadow:15px 15px 0 var(--red)}.orbit span{position:absolute;bottom:17%;font:8px 'DM Mono';text-align:center;color:#777}.workbench{display:grid;grid-template-columns:300px minmax(0,1fr);border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);min-height:760px}.sidebar{padding:24px;border-right:1px solid var(--ink)}.side-head{display:flex;justify-content:space-between;padding-bottom:18px;border-bottom:1px solid var(--line)}.flow{width:100%;display:grid;grid-template-columns:34px minmax(0,1fr);gap:10px;text-align:left;border:0;border-bottom:1px solid var(--line);background:transparent;padding:18px 3px;color:var(--ink);cursor:pointer}.flow:hover,.flow.active{background:#fff}.flow strong{font:9px 'DM Mono';color:#777}.flow span{font:700 14px 'DM Sans'}.flow small{display:block;margin-top:5px;color:#777;font:11px/1.35 'DM Sans';text-transform:none;letter-spacing:0}.flow.active span,.flow.active strong{color:var(--red)}.main-panel{padding:30px clamp(18px,4vw,54px);min-width:0}.form-head{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding-bottom:18px}.form-head>div>span{font:9px 'DM Mono';letter-spacing:.12em}.studio h2{font:700 clamp(34px,5vw,68px)/.88 'DM Sans';letter-spacing:-.06em;margin:12px 0 0}.status{border:1px solid var(--line);padding:8px 10px;height:max-content;white-space:nowrap}.studio #fields{display:grid;gap:18px;margin-top:22px}.studio #fields>label{display:grid;gap:8px;margin:0}.studio #fields input,.studio #fields textarea{display:block;width:100%;box-sizing:border-box;border:1px solid var(--line);background:#fffdf7;padding:14px 16px;font:15px/1.55 'DM Sans';color:var(--ink);border-radius:0}.studio #fields textarea{min-height:170px;resize:vertical}.studio #fields input:focus,.studio #fields textarea:focus{outline:2px solid rgba(255,89,63,.25);outline-offset:1px;border-color:var(--ink)}.actions{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}.run,.btn,.mini{border:1px solid var(--ink);padding:13px 16px;background:transparent;cursor:pointer}.run{background:var(--ink);color:#fff}.run:hover{background:var(--red)}.btn:hover,.mini:hover{background:#fff}.run:disabled,.btn:disabled,.mini:disabled{opacity:.5;cursor:not-allowed}.error{border:1px solid var(--red);background:#fff2ef;padding:12px 14px;font:12px/1.5 'DM Mono'}.result{margin-top:22px;border-top:1px solid var(--ink);background:#0d0f0f;color:#f6f1e6;min-height:420px}.result-top{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid #343636}.mini{color:#fff;border-color:#555}.px-result-meta{display:flex;justify-content:space-between;gap:20px;padding:10px 16px;border-bottom:1px solid #292c2b;font:9px 'DM Mono';letter-spacing:.12em;color:#aeb4af}.px-result-provider{color:#d9ff3f}.result pre{white-space:pre-wrap;word-break:break-word;padding:22px;font:13px/1.65 'DM Mono';margin:0}.result #resultEmpty{padding:70px 25px;color:#9b9b94}.result #resultEmpty strong{font:700 18px 'DM Sans';color:#fff}.result p{color:#aaa;font:13px/1.5 'DM Sans'}
@media(max-width:900px){.hero{min-height:auto;padding-bottom:46px}.hero-grid{grid-template-columns:1fr;gap:38px;min-height:auto}.orbit{width:min(64vw,300px);justify-self:center}.workbench{grid-template-columns:1fr}.sidebar{border-right:0;border-bottom:1px solid var(--ink);padding:14px}.flow{grid-template-columns:30px minmax(0,1fr);padding:14px 6px}.main-panel{padding:26px 18px}.router-card{align-items:flex-start;flex-direction:column}.router-card select{max-width:none;width:100%}}
@media(max-width:520px){.eyebrow{flex-direction:column;gap:7px}.studio h1{font-size:clamp(48px,16vw,82px)}.lead{font-size:15px}.orbit{width:72vw}.orbit strong{width:104px;height:104px;font-size:34px}.form-head{align-items:flex-start;flex-direction:column}.studio h2{font-size:clamp(32px,10vw,48px)}.actions>*{flex:1 1 100%;text-align:center}.result{min-height:320px}.result pre{padding:16px;font-size:12px}}
.studio-switcher{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);position:sticky;top:0;z-index:8;background:var(--paper)}.studio-switcher-btn{border:0;border-right:1px solid var(--line);background:transparent;padding:18px 16px;text-align:left;font:9px 'DM Mono';letter-spacing:.12em;cursor:pointer;color:#6f716b}.studio-switcher-btn:last-child{border-right:0}.studio-switcher-btn.active{background:var(--ink);color:#fff}.studio-switcher-btn span{float:right}.studio-module{padding:30px clamp(18px,4vw,60px);border-top:1px solid var(--ink);min-height:760px}.studio-module-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;border-bottom:1px solid var(--line);padding-bottom:20px}.studio-module-head h2{font-size:clamp(44px,6vw,86px);margin:8px 0}.studio-module-head p{max-width:760px;color:#64665f;font:15px/1.6 'DM Sans'}.module-kicker,.module-status,.studio-tool-select b,.radar-head{font:9px 'DM Mono';letter-spacing:.12em;text-transform:uppercase}.module-status{border:1px solid var(--line);padding:8px 10px;white-space:nowrap}.tool-library{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:22px 0}.studio-tool-select{display:grid;grid-template-columns:26px 1fr;gap:10px;text-align:left;border:1px solid var(--line);background:#fffdf7;padding:13px;cursor:pointer;min-height:78px}.studio-tool-select.active{border-color:var(--ink);background:#111;color:#fff}.studio-tool-select b{color:#777}.studio-tool-select.active b{color:#ff593f}.studio-tool-select span{font:700 12px/1.3 'DM Sans'}.studio-tool-select small{display:block;margin-top:5px;color:#777;font:10px/1.35 'DM Sans'}.studio-tool-select.active small{color:#b7b9b3}.studio-tool-host{border-top:1px solid var(--ink);padding-top:22px}.studio-tool-host .generator-breadcrumb,.studio-tool-host .ad-slot,.studio-tool-host .generator-info{display:none}.studio-tool-host .generator-page{min-height:auto;background:transparent;padding:0}.studio-tool-host .generator-head{display:none}.studio-tool-host .generator-layout{grid-template-columns:minmax(0,1fr) minmax(0,1fr);margin:0}.studio-tool-host .generator-panel,.studio-tool-host .generator-preview{background:#fffdf7}.studio-tool-host .generator-panel{border:1px solid var(--line)}.studio-tool-host .generator-preview{border:1px solid var(--ink);min-height:420px}.radar-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:22px}.radar-grid>section{border:1px solid var(--line);background:#fffdf7;min-width:0}.radar-head{display:flex;justify-content:space-between;gap:10px;padding:14px;border-bottom:1px solid var(--line)}.radar-head b{color:#777}.radar-list{display:grid}.studio-radar-card{display:grid;gap:6px;padding:15px;border-bottom:1px solid #ddd9cf;color:var(--ink);text-decoration:none}.studio-radar-card:hover{background:#fff}.studio-radar-card strong{font:700 13px/1.4 'DM Sans';overflow-wrap:anywhere}.studio-radar-card span{font:10px 'DM Mono';color:#777}.radar-empty{padding:18px;color:#777;font:12px 'DM Mono'}@media(max-width:1050px){.tool-library{grid-template-columns:repeat(3,minmax(0,1fr))}.radar-grid{grid-template-columns:1fr}.studio-tool-host .generator-layout{grid-template-columns:1fr}}@media(max-width:650px){.studio-switcher{grid-template-columns:1fr}.studio-switcher-btn{border-right:0;border-bottom:1px solid var(--line)}.studio-switcher-btn:last-child{border-bottom:0}.studio-module-head{flex-direction:column}.tool-library{grid-template-columns:1fr 1fr}.studio-module{padding:24px 16px}}@media(max-width:430px){.tool-library{grid-template-columns:1fr}}
</style>
</MakerLayout>

<script is:inline>
(() => {
  const root=document.querySelector('.studio'); if(!root)return;
  const tabs=[...root.querySelectorAll('[data-section-tab]')], panels={workflows:root.querySelector('#studioWorkflows'),toolkit:root.querySelector('#studioToolkit'),radar:root.querySelector('#studioRadar')};
  const setSection=(section)=>{tabs.forEach(b=>b.classList.toggle('active',b.dataset.sectionTab===section));Object.entries(panels).forEach(([k,p])=>{if(p)p.hidden=k!==section});if(section==='radar')loadRadar();};
  const toolItems=[...root.querySelectorAll('[data-tool-select]')];
  toolItems.forEach(btn=>btn.addEventListener('click',()=>{const mode=btn.dataset.toolMode;const slug=btn.dataset.toolSelect;const title=btn.querySelector('span')?.childNodes[0]?.textContent?.trim()||slug||'';const desc=btn.querySelector('small')?.textContent||'';toolItems.forEach(x=>x.classList.remove('active'));btn.classList.add('active');setSection('toolkit');window.dispatchEvent(new CustomEvent('paradox:ai-tool-change',{detail:{mode,title,intro:desc}}));history.replaceState(null,'',`/ai-studio/?section=toolkit&tool=${encodeURIComponent(slug||'')}`);}));
  tabs.forEach(btn=>btn.addEventListener('click',()=>{const section=btn.dataset.sectionTab||'workflows';if(section==='workflows')history.replaceState(null,'','/ai-studio/?workflow=resume');else if(section==='radar')history.replaceState(null,'','/ai-studio/?section=radar');else{const active=root.querySelector('[data-tool-select].active');history.replaceState(null,'',`/ai-studio/?section=toolkit&tool=${encodeURIComponent(active?.dataset.toolSelect||'')}`);}setSection(section);}));
  async function loadRadar(){const m=root.querySelector('#radarModels'),g=root.querySelector('#radarGithub'),n=root.querySelector('#radarNews'),s=root.querySelector('#radarStatus');if(!m||!g||!n||!s||root.dataset.radarLoaded==='true')return;root.dataset.radarLoaded='true';s.textContent='FETCHING LIVE SIGNALS…';const timed=async(url)=>{const c=new AbortController(),t=setTimeout(()=>c.abort(),10000);try{const r=await fetch(url,{signal:c.signal});if(!r.ok)throw new Error('request failed');return await r.json()}finally{clearTimeout(t)}};const [a,b,d]=await Promise.allSettled([timed('https://huggingface.co/api/models?sort=trending&direction=-1&limit=8'),timed('https://api.github.com/search/repositories?q=AI+OR+LLM&sort=stars&order=desc&per_page=8'),timed('https://hn.algolia.com/api/v1/search?query=AI%20LLM&tags=story&hitsPerPage=8')]);const models=a.status==='fulfilled'?a.value:[],repos=b.status==='fulfilled'?(b.value.items||[]):[],stories=d.status==='fulfilled'?(d.value.hits||[]):[];m.innerHTML=models.length?models.map((x,i)=>`<a class="studio-radar-card" href="https://huggingface.co/${x.id}" target="_blank" rel="noreferrer"><strong>${String(i+1).padStart(2,'0')} · ${x.id}</strong><span>${Number(x.downloads||0).toLocaleString()} downloads · ${Number(x.likes||0).toLocaleString()} likes</span></a>`).join(''):'<p class="radar-empty">Model feed unavailable.</p>';g.innerHTML=repos.length?repos.map(x=>`<a class="studio-radar-card" href="${x.html_url}" target="_blank" rel="noreferrer"><strong>${x.name}</strong><span>★ ${Number(x.stargazers_count||0).toLocaleString()}</span></a>`).join(''):'<p class="radar-empty">GitHub feed unavailable.</p>';n.innerHTML=stories.length?stories.map(x=>`<a class="studio-radar-card" href="${x.url||'https://news.ycombinator.com/'}" target="_blank" rel="noreferrer"><strong>${x.title||'AI story'}</strong><span>${Number(x.points||0)} points · ${Number(x.num_comments||0)} comments</span></a>`).join(''):'<p class="radar-empty">News feed unavailable.</p>';s.textContent=`${[models,repos,stories].filter(x=>x.length).length}/3 LIVE SOURCES`;}
  const params=new URLSearchParams(location.search),section=params.get('section');if(section==='toolkit'){const btn=root.querySelector(`[data-tool-select="${params.get('tool')||''}"]`)||root.querySelector('[data-tool-select]');btn?.click();}else if(section==='radar')setSection('radar');else setSection('workflows');
})();
</script>
