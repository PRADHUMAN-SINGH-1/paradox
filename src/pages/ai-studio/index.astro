---
import MakerLayout from '../../layouts/MakerLayout.astro';
const canonical='https://paradox.engineer/ai-studio/';
---
<MakerLayout title="PARADOX AI Studio — Free AI Workbench" description="A practical AI workbench for resumes, interviews, studying, writing, coding and research. Connect a free Gemini API key and run powerful workflows in your browser." canonical={canonical}>
<main class="studio">
  <header class="studio-hero">
    <div class="studio-kicker"><span>PARADOX / AI STUDIO</span><span>WORKSPACE / 01-05</span></div>
    <div class="studio-grid">
      <div>
        <p class="studio-eyebrow"><i></i> WORKFLOW ENGINEERING WORKSPACE</p>
        <h1>Give it a spec.<br><em>Get an output.</em></h1>
        <p class="studio-lead">A focused AI workbench with reusable workflows, structured inputs, model execution, and output controls for practical tasks.</p>
        <div class="studio-connect">
          <label for="apiKey">Gemini API key <a href="https://aistudio.google.com/apikey" target="_blank" rel="noreferrer">get free key ↗</a></label>
          <div><input id="apiKey" type="password" placeholder="Paste your Gemini key — stored only in this tab"><button id="saveKey" class="studio-btn">CONNECT</button></div>
          <small>Key stays in browser session storage and is sent directly to Gemini API.</small>
        </div>
      </div>
      <div class="studio-orbit" aria-hidden="true">
        <div class="pulse-grid"></div><strong>AI</strong><span>QUEUE · EXECUTE · REVIEW</span>
      </div>
    </div>
  </header>

  <section class="studio-workbench">
    <aside class="studio-sidebar">
      <div class="side-title"><span>01</span><b>WORKFLOWS</b></div>
      <button class="flow active" data-flow="resume"><strong>01</strong><span>Resume Tailor<small>ATS-fit targeted resume output</small></span></button>
      <button class="flow" data-flow="interview"><strong>02</strong><span>Interview Coach<small>Role-driven simulation + answer guide</small></span></button>
      <button class="flow" data-flow="study"><strong>03</strong><span>Study Engine<small>Notes to active revision pack</small></span></button>
      <button class="flow" data-flow="content"><strong>04</strong><span>Content Studio<small>Brief to polished publishable draft</small></span></button>
      <button class="flow" data-flow="code"><strong>05</strong><span>Code Fixer<small>Bug diagnosis + corrected implementation</small></span></button>
    </aside>

    <section class="studio-main">
      <div class="studio-form-head">
        <div><span id="flowLabel">RESUME TAILOR</span><h2 id="flowTitle">Make the application fit.</h2></div>
        <span id="status" class="studio-status">READY</span>
      </div>
      <div id="fields"></div>
      <div class="studio-actions"><button id="run" class="studio-run">RUN AI <span>↗</span></button><button id="clear" class="studio-btn">CLEAR</button><button id="copy" class="studio-btn">COPY RESULT</button></div>
      <div id="error" class="studio-error" hidden></div>
      <article class="studio-result"><div class="result-top"><span>OUTPUT CHANNEL</span><button id="download" class="studio-mini">DOWNLOAD .TXT</button></div><div id="resultEmpty"><strong>Awaiting execution output.</strong><p>Select a workflow, complete fields, and run AI.</p></div><pre id="result" hidden></pre></article>
    </section>
  </section>

  <section class="studio-proof"><div><span>WORKSPACE PRINCIPLES</span><h2>High-signal workflows.<br/><em>Repeatable execution.</em></h2></div><div class="proof-grid"><article><b>INPUT STRUCTURE</b><p>Predefined workflow schemas reduce ambiguity and improve output relevance.</p></article><article><b>MODEL SAFETY</b><p>No credential persistence on server. Inputs stay user-controlled in browser session.</p></article><article><b>DELIVERY LOOP</b><p>Generate, review, copy, and download without leaving the workspace.</p></article></div></section>
</main>
<script is:inline>
(()=>{
const root=document.querySelector('.studio');if(!root)return;
const flows={
 resume:{label:'RESUME TAILOR',title:'Make the application fit.',fields:[['Your resume','resume','ta','Paste your resume here...'],['Job description','jd','ta','Paste the job description here...'],['Target role','role','text','Software Engineer']]},
 interview:{label:'INTERVIEW COACH',title:'Train against the actual role.',fields:[['Job description','jd','ta','Paste the job description here...'],['Your background','bg','ta','Projects, experience, skills, education...'],['Interview stage','stage','text','Technical round']]},
 study:{label:'STUDY ENGINE',title:'Turn notes into a revision system.',fields:[['Topic or chapter','topic','text','DBMS — normalization'],['Notes / source material','notes','ta','Paste class notes, textbook text or your own notes...'],['Difficulty','difficulty','text','University exam']]},
 content:{label:'CONTENT STUDIO',title:'Go from idea to publishable draft.',fields:[['Idea / brief','brief','ta','What are you trying to say?'],['Audience','audience','text','College students and young professionals'],['Format','format','text','LinkedIn post']]},
 code:{label:'CODE FIXER',title:'Understand the bug before you patch it.',fields:[['Code','code','ta','Paste the code that is failing...'],['Error / expected behaviour','errorInfo','ta','Paste the error or explain what should happen.'],['Language','language','text','JavaScript']]}
};
const fields=root.querySelector('#fields'), flowLabel=root.querySelector('#flowLabel'), flowTitle=root.querySelector('#flowTitle'), result=root.querySelector('#result'), empty=root.querySelector('#resultEmpty'), status=root.querySelector('#status'), err=root.querySelector('#error');
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let current='resume';
function render(name){current=name;const f=flows[name];flowLabel.textContent=f.label;flowTitle.textContent=f.title;fields.innerHTML=f.fields.map(([label,id,type,ph])=>type==='ta'?`<label>${label}<textarea id="${id}" placeholder="${ph}"></textarea></label>`:`<label>${label}<input id="${id}" placeholder="${ph}" /></label>`).join('');root.querySelectorAll('.flow').forEach(x=>x.classList.toggle('active',x.dataset.flow===name));result.hidden=true;empty.hidden=false;err.hidden=true;status.textContent='READY'}
root.querySelectorAll('.flow').forEach(b=>b.addEventListener('click',()=>render(b.dataset.flow)));
const promptFor=(name,get)=>{
if(name==='resume')return `Act as an expert ATS resume strategist. Compare the resume below against the job description. Return: 1) match score /100 with reasons, 2) missing skills/keywords, 3) rewritten high-impact bullets for the most relevant experience, 4) a tailored professional summary, 5) exact changes the candidate should make. Do not invent experience or credentials.\n\nRESUME:\n${get('resume')}\n\nJOB DESCRIPTION:\n${get('jd')}\n\nTARGET ROLE:\n${get('role')}`;
if(name==='interview')return `Act as a senior interviewer for the role described below. Create a realistic interview preparation pack: 8 role-specific questions, what a strong answer should contain, 3 technical follow-ups, 3 behavioural questions, a 30-second introduction tailored to the candidate, and 5 red flags to avoid. Ground everything in the provided job description and background.\n\nJOB DESCRIPTION:\n${get('jd')}\n\nCANDIDATE BACKGROUND:\n${get('bg')}\n\nSTAGE:\n${get('stage')}`;
if(name==='study')return `Act as an excellent university tutor. Turn the supplied material into a high-retention revision pack: concise explanation, key concepts, formulas or rules when relevant, 12 flashcards, 10 exam-style questions with answers, common mistakes, and a one-day revision plan. Do not add facts that are not needed; clearly mark anything uncertain.\n\nTOPIC:\n${get('topic')}\n\nMATERIAL:\n${get('notes')}\n\nDIFFICULTY:\n${get('difficulty')}`;
if(name==='content')return `Act as a sharp editor and content strategist. Transform the brief into a publishable ${get('format')}. Give it a strong hook, concrete value, natural human voice, useful structure and a clear ending. Avoid generic AI filler, fake statistics, empty hype and overdone emojis. Also provide 3 alternative hooks.\n\nIDEA:\n${get('brief')}\n\nAUDIENCE:\n${get('audience')}`;
return `Act as a senior ${get('language')} engineer. Diagnose the supplied code and error. Return: root cause, exact corrected code, line-by-line explanation of the critical fix, tests or test cases that should be added, and one improvement that would prevent the bug from recurring. Do not rewrite unrelated code.\n\nCODE:\n${get('code')}\n\nERROR / EXPECTED BEHAVIOUR:\n${get('errorInfo')}\n\nLANGUAGE:\n${get('language')}`;
};
function get(id){return root.querySelector('#'+id)?.value?.trim()||''}
async function run(){err.hidden=true;const key=sessionStorage.getItem('paradox_gemini_key')||'';if(!key){err.textContent='Connect a Gemini API key first. Google currently offers a free Gemini API tier for developers.';err.hidden=false;return}const f=flows[current];const all=f.fields.map(x=>x[1]);if(all.some(id=>!get(id))){err.textContent='Complete the workflow inputs first.';err.hidden=false;return}status.textContent='RUNNING';result.hidden=false;empty.hidden=true;result.textContent='Generating…';
try{const res=await fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key='+encodeURIComponent(key),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({systemInstruction:{parts:[{text:'You are PARADOX AI Studio. Be specific, truthful, useful and concise. Never invent a user credential, job, result or source.'}]},contents:[{role:'user',parts:[{text:promptFor(current,get)}]}],generationConfig:{temperature:.35,maxOutputTokens:5000}})});const data=await res.json();if(!res.ok)throw new Error(data?.error?.message||'Gemini request failed');const text=data?.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join('\n')||'No output returned.';result.textContent=text;status.textContent='DONE';window.gtag?.('event','ai_studio_run',{workflow:current})}catch(e){result.hidden=true;empty.hidden=false;err.textContent=e.message||'AI request failed.';err.hidden=false;status.textContent='ERROR'}}
root.querySelector('#saveKey').addEventListener('click',()=>{const key=root.querySelector('#apiKey').value.trim();if(!key){err.textContent='Paste a Gemini API key first.';err.hidden=false;return}sessionStorage.setItem('paradox_gemini_key',key);root.querySelector('#apiKey').value='';status.textContent='CONNECTED';err.hidden=true});
root.querySelector('#run').addEventListener('click',run);root.querySelector('#clear').addEventListener('click',()=>render(current));root.querySelector('#copy').addEventListener('click',async()=>{if(result.hidden)return;await navigator.clipboard.writeText(result.textContent);status.textContent='COPIED'});root.querySelector('#download').addEventListener('click',()=>{if(result.hidden)return;const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([result.textContent],{type:'text/plain'}));a.download='paradox-ai-result.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)});render('resume');
})();
</script>
<style>
.studio{--ink:#091015;--surface:#0f171f;--surface-2:#141f29;--line:rgba(170,205,255,.18);--text:#e7f0ff;--muted:#8ea2be;--lime:#ccff4d;--coral:#ff6c51;background:radial-gradient(circle at 14% 0%,rgba(204,255,77,.10),transparent 26%),radial-gradient(circle at 86% 8%,rgba(255,108,81,.14),transparent 24%),#070d13;color:var(--text);max-width:1500px;margin:auto}.studio-hero{padding:24px clamp(18px,4vw,62px) 60px}.studio-kicker,.studio-eyebrow,.side-title,.result-top,.studio-status{font:9px 'DM Mono',monospace;letter-spacing:.14em}.studio-kicker{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:12px;color:#aac2df}.studio-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:6vw;align-items:center;min-height:62vh}.studio-eyebrow{margin-top:34px;color:#d2def1}.studio-eyebrow i{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--lime);margin-right:8px;box-shadow:0 0 0 8px rgba(204,255,77,.18)}.studio h1{font:700 clamp(72px,10vw,156px)/.74 'DM Sans';letter-spacing:-.08em;margin:20px 0}.studio h1 em,.studio h2 em{font-family:'Instrument Serif',serif;font-weight:400;color:var(--coral)}.studio-lead{max-width:640px;color:#adc0d8;font-size:17px;line-height:1.6}.studio-connect{margin-top:28px;max-width:700px}.studio-connect label,.studio-main label{display:block;font:9px 'DM Mono';text-transform:uppercase;letter-spacing:.08em;color:#bcd1eb}.studio-connect label a{float:right;text-decoration:underline;color:#e8f5ff}.studio-connect>div{display:flex;margin-top:8px;gap:8px}.studio-connect input{flex:1;border:1px solid var(--line);background:rgba(255,255,255,.03);color:#f2f7ff;padding:14px}.studio-btn,.studio-run,.studio-mini{border:1px solid var(--line);background:rgba(255,255,255,.02);color:#e9f1ff;padding:12px 16px;font:9px 'DM Mono';letter-spacing:.07em}.studio-run{background:linear-gradient(120deg,var(--lime),#9dde35);color:#07220a;border-color:transparent;padding:15px 20px;font-weight:700}.studio-run:hover{filter:brightness(1.06)}.studio-btn:hover{background:rgba(255,255,255,.08)}.studio-connect small{display:block;color:#8095b1;font:9px 'DM Mono';margin-top:8px}.studio-orbit{width:min(36vw,430px);aspect-ratio:1;border:1px solid var(--line);border-radius:24px;justify-self:end;position:relative;display:grid;place-items:center;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.01));overflow:hidden}.pulse-grid{position:absolute;inset:12px;background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);background-size:28px 28px;mask-image:radial-gradient(circle at center,black 45%,transparent 90%);animation:gridFloat 7s linear infinite}.studio-orbit strong{width:128px;height:128px;border-radius:50%;display:grid;place-items:center;background:var(--surface);color:#fff;font-size:42px;border:1px solid var(--line);box-shadow:0 0 0 12px rgba(255,255,255,.03)}.studio-orbit span{position:absolute;bottom:11%;font:8px 'DM Mono';text-align:center;color:#98adca}.studio-workbench{display:grid;grid-template-columns:320px 1fr;border-top:1px solid var(--line);border-bottom:1px solid var(--line);min-height:760px;background:linear-gradient(180deg,rgba(255,255,255,.01),rgba(255,255,255,.00))}.studio-sidebar{border-right:1px solid var(--line);padding:24px;background:rgba(255,255,255,.015)}.side-title{display:flex;justify-content:space-between;padding-bottom:16px;border-bottom:1px solid var(--line)}.flow{width:100%;display:grid;grid-template-columns:35px 1fr;text-align:left;gap:10px;border:1px solid transparent;border-bottom-color:var(--line);background:transparent;padding:18px 4px;color:var(--text);transition:.2s}.flow:hover,.flow.active{background:rgba(255,255,255,.05);border-color:var(--line)}.flow strong{font:9px 'DM Mono';color:#90a4be}.flow span{font-weight:700;font-size:14px}.flow small{display:block;margin-top:5px;color:#88a0bb;font-size:11px;font-weight:400}.flow.active span{color:var(--lime)}.studio-main{padding:30px clamp(18px,4vw,55px)}.studio-form-head{display:flex;justify-content:space-between;gap:20px;align-items:start;border-bottom:1px solid var(--line);padding-bottom:18px}.studio-form-head span:first-child{font:9px 'DM Mono';letter-spacing:.12em;color:#aac3df}.studio-form-head h2{font:700 clamp(36px,5vw,66px)/.88 'DM Sans';letter-spacing:-.06em;margin:13px 0 0}.studio-status{border:1px solid var(--line);padding:8px 10px;background:rgba(255,255,255,.04)}.studio-main label{margin:20px 0 7px}.studio-main input,.studio-main textarea{display:block;width:100%;border:1px solid var(--line);background:rgba(255,255,255,.025);color:#f4f8ff;padding:14px;font:14px 'DM Sans'}.studio-main textarea{min-height:150px;resize:vertical}.studio-main input:focus,.studio-main textarea:focus{outline:2px solid rgba(204,255,77,.32);border-color:var(--lime)}.studio-actions{display:flex;gap:8px;flex-wrap:wrap;margin:25px 0}.studio-error{border:1px solid var(--coral);padding:12px;font:11px 'DM Mono';background:rgba(255,108,81,.08)}.studio-result{margin-top:20px;border:1px solid var(--line);background:var(--surface)}.result-top{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:12px 15px;color:#95adca}.studio-mini{font-size:8px;padding:7px}.studio-result>div:last-child{padding:22px;min-height:330px}.studio-result strong{font-size:22px}.studio-result p{color:#90a5bf}.studio-result pre{margin:0;padding:22px;min-height:330px;white-space:pre-wrap;word-break:break-word;background:#070d13;color:#dbe7f8;font:12px/1.7 'DM Mono'}.studio-proof{padding:90px clamp(18px,4vw,62px);display:grid;grid-template-columns:1fr 1fr;gap:7vw}.studio-proof h2{font:700 clamp(56px,7vw,98px)/.78 'DM Sans';letter-spacing:-.07em;margin:20px 0}.proof-grid{display:grid;gap:1px}.proof-grid article{padding:24px;border-top:1px solid var(--line);background:rgba(255,255,255,.015)}.proof-grid b{font:9px 'DM Mono';letter-spacing:.12em;color:#c5d9ef}.proof-grid p{color:#95abc5;line-height:1.6}@keyframes gridFloat{to{transform:translateY(-28px)}}.studio button{cursor:pointer}@media(max-width:900px){.studio-grid,.studio-proof{grid-template-columns:1fr}.studio-orbit{width:340px;justify-self:start}.studio-workbench{grid-template-columns:1fr}.studio-sidebar{border-right:0;border-bottom:1px solid var(--line)}}@media(max-width:600px){.studio h1{font-size:66px}.studio-connect>div{flex-direction:column}.studio-connect button{width:100%}.studio-kicker span:nth-child(2){display:none}.studio-orbit{width:100%}.studio-main{padding:20px 16px}.studio-actions{display:grid;grid-template-columns:1fr}.studio-run,.studio-btn{width:100%}}
</style>
</MakerLayout>
