---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact PARADOX" description="Contact PARADOX for bugs, feedback, project corrections and partnership." canonical="https://paradox.engineer/contact/">
  <main class="contact-page">
    <p class="label">CONTACT</p>
    <h1>Tell me what<br /><em>needs fixing.</em></h1>
    <p class="page-lead">Bug reports, incorrect agent data, feature ideas or partnership requests. Include the page URL.</p>
    <div class="links">
      <a href="mailto:pradhumansingh196@gmail.com">pradhumansingh196@gmail.com</a>
      <a href="https://www.linkedin.com/in/pradhuman--singh/" rel="me">LinkedIn</a>
    </div>
    <p class="note">Do not send passwords, API keys, private repositories or sensitive documents.</p>
    <ul class="page-lead">
      <li>Bug reports</li>
      <li>Feedback</li>
      <li>Project correction</li>
      <li>Partnership / contact</li>
    </ul>
  </main>
</BaseLayout>
