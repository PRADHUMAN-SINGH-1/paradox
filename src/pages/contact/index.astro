---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact PARADOX" description="Contact the PARADOX creator for product feedback, corrections, security concerns or collaboration." canonical="https://paradox.engineer/contact/">
<main class="contact-page"><span>CONTACT / PARADOX</span><h1>Build with me.<br/><em>Break it carefully.</em></h1><p>For product feedback, verification corrections, security concerns or collaboration:</p><div class="links"><a href="mailto:pradhumansingh196@gmail.com">pradhumansingh196@gmail.com ↗</a><a href="https://www.linkedin.com/in/pradhuman--singh/" target="_blank" rel="noopener">LinkedIn ↗</a></div><small>For security reports, do not send secrets, credentials or private repository contents by email.</small></main>
<style>.contact-page{max-width:950px;margin:auto;padding:90px 24px 130px}.contact-page>span{font:700 9px 'DM Mono';letter-spacing:.13em;color:var(--accent)}h1{font:400 clamp(75px,10vw,135px)/.78 'Instrument Serif';margin:22px 0}h1 em{color:var(--accent);font-style:italic}.contact-page p{color:var(--muted);max-width:560px;line-height:1.8}.links{display:flex;flex-wrap:wrap;gap:10px;margin:30px 0}.links a{padding:14px 17px;background:var(--ink);color:#fff;font:700 9px 'DM Mono'}.links a+ a{background:var(--paper);color:var(--ink);border:1px solid var(--line)}.contact-page small{color:var(--muted);font:9px/1.7 'DM Mono'}</style>
</BaseLayout>
