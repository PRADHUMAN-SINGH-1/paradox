---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Discover AI agents — PARADOX" description="Search public GitHub repositories for AI agents and inspect them with PARADOX static verification." canonical="https://paradox.engineer/agents/">
<main class="discover">
  <header><span class="eyebrow">PARADOX / DISCOVER</span><h1>Find an agent.<br/><em>Then check it.</em></h1><p>Search public GitHub repositories, open a report, and inspect the evidence before you install anything.</p><form id="search"><input id="q" value="AI agent" aria-label="Search GitHub agents"/><button>SEARCH ↗</button></form></header>
  <div class="status" id="status">Ready.</div><section class="grid" id="grid"></section>
</main>
<script>
  const form=document.querySelector('#search'), input=document.querySelector('#q'), grid=document.querySelector('#grid'), status=document.querySelector('#status');
  async function run(){
    status.textContent='Searching public GitHub repositories…'; grid.innerHTML='';
    try{const r=await fetch(`/api/search-agents?q=${encodeURIComponent(input.value)}`);const data=await r.json();if(!r.ok)throw new Error(data.error||'Search failed');status.textContent=`${data.items.length} repositories found`;grid.innerHTML=data.items.map(item=>`<article><div class="meta"><span>★ ${item.stars.toLocaleString()}</span><span>${item.language||'Unknown'}</span></div><h2>${escapeHtml(item.fullName)}</h2><p>${escapeHtml(item.description||'No description.')}</p><small>updated ${new Date(item.pushedAt).toLocaleDateString()}</small><div class="actions"><a href="/agent/${encodeURIComponent(item.owner)}/${encodeURIComponent(item.name)}/">VERIFY</a><a href="${item.url}" target="_blank" rel="noopener">GITHUB</a></div></article>`).join('') || '<div class="empty">No repositories matched this search.</div>';}catch(e){status.textContent=e.message;}
  }
  form.addEventListener('submit',e=>{e.preventDefault();run()}); run();
  const escapeHtml=value=>String(value).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
</script>
<style>
.discover{max-width:1120px;margin:auto;padding:75px 24px 120px}.eyebrow,.status,.meta,.actions,.discover small{font:700 9px 'DM Mono';letter-spacing:.1em;text-transform:uppercase}.eyebrow{color:var(--accent)}header h1{font:400 clamp(75px,10vw,130px)/.78 'Instrument Serif';margin:20px 0}header h1 em{color:var(--accent);font-style:italic}header p{max-width:650px;color:var(--muted);line-height:1.8}.discover form{display:flex;max-width:780px;margin-top:28px;border:1px solid var(--line);background:var(--paper)}.discover input{flex:1;border:0;background:transparent;padding:17px;outline:0;font-size:15px}.discover form button{border:0;background:var(--ink);color:#fff;padding:0 20px;font:700 9px 'DM Mono'}.status{margin:45px 0 14px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.grid article{background:var(--paper);border:1px solid var(--line);padding:19px;min-height:280px;display:flex;flex-direction:column}.meta{display:flex;justify-content:space-between;color:var(--muted)}.grid h2{font-size:22px;margin:28px 0 9px;word-break:break-word}.grid p{color:var(--muted);font-size:13px;line-height:1.6}.grid small{margin-top:auto;color:var(--muted)}.actions{display:flex;gap:8px;margin-top:17px}.actions a{padding:10px 12px;border:1px solid var(--line)}.actions a:first-child{background:var(--ink);color:#fff;border-color:var(--ink)}.empty{grid-column:1/-1;padding:50px;border:1px dashed var(--line);text-align:center;color:var(--muted)}
@media(max-width:850px){.grid{grid-template-columns:1fr 1fr}}@media(max-width:580px){.grid{grid-template-columns:1fr}.discover form{display:grid}.discover form button{height:50px}}
</style>
</BaseLayout>
