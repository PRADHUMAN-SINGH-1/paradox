---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import catalog from '../../../data/catalog/catalog.json';
import { CATEGORIES } from '../../../lib/catalog.ts';

export function getStaticPaths() {
  return catalog.map((entry) => ({ params: { owner: entry.owner, repo: entry.repo }, props: { entry } }));
}

const { entry } = Astro.props;
const fullName = `${entry.owner}/${entry.repo}`;
const canonical = `https://paradox.engineer/agents/${entry.owner}/${entry.repo}/`;
const category = CATEGORIES.find((c) => c.slug === entry.category);
const related = catalog.filter((e) => e.category === entry.category && e.repo !== entry.repo).slice(0, 4);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: entry.repo,
      url: canonical,
      description: entry.summary,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      codeRepository: `https://github.com/${fullName}`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://paradox.engineer/' },
        { '@type': 'ListItem', position: 2, name: 'Agents', item: 'https://paradox.engineer/agents/' },
        { '@type': 'ListItem', position: 3, name: fullName, item: canonical },
      ],
    },
  ],
};
---
<BaseLayout
  title={`${entry.repo} — AI Agent Analysis | PARADOX`}
  description={entry.summary}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <main class="verify-page" data-agent={fullName}>
    <!-- Breadcrumb Navigation -->
    <nav style="display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); margin-bottom: 24px;" aria-label="Breadcrumb">
      <a href="/" style="color: var(--text-secondary); text-decoration: none;">Home</a>
      <span>/</span>
      <a href="/agents/" style="color: var(--text-secondary); text-decoration: none;">Agents</a>
      {category && (
        <>
          <span>/</span>
          <a href={`/categories/${category.slug}/`} style="color: var(--text-secondary); text-decoration: none;">{category.label}</a>
        </>
      )}
      <span>/</span>
      <span style="color: var(--text-primary);">{entry.repo}</span>
    </nav>

    <div class="page-header animate-fade-slide-up">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
        <span class="dot-pulse"></span>
        <span>PUBLIC AGENT PROFILE / DETERMINISTIC ANALYSIS</span>
      </div>
      <h1>{entry.repo}</h1>
      <p class="page-lead">{entry.summary}</p>
      <div style="display: flex; gap: 8px; align-items: center; margin-top: 12px; flex-wrap: wrap;">
        <span class="chip chip-accent">{fullName}</span>
        <span class="chip chip-verified">{category?.label || entry.category}</span>
        {entry.topics.slice(0, 4).map((topic: string) => (
          <span class="chip">{topic}</span>
        ))}
      </div>
    </div>

    <!-- Live Analysis Status Indicator -->
    <div id="profileStatus" class="status" role="status" style="font-family: var(--font-mono); font-size: 12px; color: var(--accent-light); margin-bottom: 20px;">
      Loading live repository evidence…
    </div>

    <!-- Live Evidence Output Mount -->
    <div id="liveAnalysis"></div>

    <!-- Similar Agents Bento -->
    <section style="margin-top: 60px; border-top: 1px solid var(--border-subtle); padding-top: 40px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h2 style="font-size: 22px; font-weight: 800; margin: 0;">Similar Catalogued Agents</h2>
        <a href="/agents/" class="btn btn-ghost btn-sm">Explore All →</a>
      </div>
      <div class="grid-agents">
        {related.map((e) => (
          <article class="agent-card">
            <div class="meta">
              <span class="chip">{e.category}</span>
              <span>{e.owner}</span>
            </div>
            <h3>{e.repo}</h3>
            <p>{e.summary}</p>
            <div class="links">
              <a href={`/agents/${e.owner}/${e.repo}/`}>Open Profile →</a>
              <a href={`/verify/?url=${encodeURIComponent(`https://github.com/${e.owner}/${e.repo}`)}`}>Verify ↗</a>
            </div>
          </article>
        ))}
      </div>
      {!related.length && <p style="color: var(--text-muted); font-family: var(--font-mono); font-size: 12px;">No similar catalogued agents found in this category.</p>}
    </section>

    <div style="display: flex; gap: 16px; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border-subtle);">
      <a href={`/compare/?left=${encodeURIComponent(fullName)}`} class="btn btn-ghost btn-sm">Compare with another agent →</a>
      <a href={`/verify/?url=${encodeURIComponent(`https://github.com/${fullName}`)}`} class="btn btn-ghost btn-sm">Fresh verification ↗</a>
      <a href="/trending/" class="btn btn-ghost btn-sm">Trending agents →</a>
    </div>
  </main>
  <script>
    import '../../../scripts/pages/profile-page.ts';
  </script>
</BaseLayout>
