---
import MakerLayout from '../../layouts/MakerLayout.astro';
import GeneratorTool from '../../components/GeneratorTool.astro';
---
<MakerLayout title="Free Bingo Card Generator — PARADOX Makers" description="Create custom printable bingo cards from words, names or prompts. Free, no account, browser-side generation."><GeneratorTool mode="bingo" title="Bingo Card Generator" intro="Make a custom bingo card from your own words, names, vocabulary or prompts. Generate, print or save it as a PDF without creating an account." steps={['Enter up to 24 words, names or prompts, one per line.','Generate a fresh 5×5 card with a free center square.','Print the card or save the browser print view as PDF.']} faq={[["Can I use names instead of bingo numbers?","Yes. Use names, vocabulary, topics, icebreakers or any short phrases."],["Can I make a new card quickly?","Yes. Press Generate again to create another randomized arrangement from the same list."],["Does it upload my list?","No. The generator runs in your browser tab."]]}/></MakerLayout>
