---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { analyzeGitHubRepository } from '../../../lib/github-analyzer';
const { owner, repo } = Astro.params;
let report:any;
try { report = await analyzeGitHubRepository(`https://github.com/${owner}/${repo}`); } catch { return Astro.redirect('/analyze/'); }
const title = `${report.repository.fullName} — GitHub Agent Report | PARADOX`;
const description = `Static GitHub repository report for ${report.repository.fullName}: freshness, stack, permissions and verification signals.`;
---
<BaseLayout title={title} description={description} canonical={`https://paradox.engineer/agent/${owner}/${repo}/`}>
<main class="report-page">
  <header class="report-head"><a href="/analyze/" class="back">← VERIFY ANOTHER REPOSITORY</a><span class="eyebrow">PARADOX / AGENT REPORT</span><h1>{report.repository.fullName}</h1><p>{report.repository.description || 'No repository description.'}</p><div class="meta"><span>★ {report.repository.stars.toLocaleString()}</span><span>{report.verdict}</span><span>{report.freshness.daysSincePush === null ? 'freshness unknown' : `${report.freshness.daysSincePush}d since push`}</span></div></header>
  <section class="score-row"><div><span class="label">STATIC HEALTH SCORE</span><strong>{report.score}<small>/100</small></strong></div><div><span class="label">LIMIT</span><p>Static inspection only. PARADOX does not execute this repository.</p></div></section>
  <section class="blocks"><article><span class="label">CHECKS</span>{report.checks.map((x:any)=><div class="check"><b class={x.status}>{x.status}</b><strong>{x.label}</strong><span>{x.detail}</span></div>)}</article><article><span class="label">PERMISSIONS</span>{Object.entries(report.permissions).map(([key,value])=><div class="perm"><b>{key}</b><span>{value ? 'detected' : 'not detected'}</span></div>)}</article></section>
  <section class="risk"><span class="label">RISK INDICATORS</span>{report.riskFlags.length ? <ul>{report.riskFlags.map((flag:string)=><li>{flag}</li>)}</ul> : <p>No high-signal risk pattern was detected in the sampled files.</p>}</section>
  <section class="blocks"><article><span class="label">STACK</span><p>{report.stack.languages.join(' · ') || 'Unknown'}</p><p class="muted">{report.stack.manifests.join(' · ') || 'No manifest detected'}</p></article><article><span class="label">REPOSITORY</span><p>{report.repository.license || 'No SPDX license returned'}</p><a href={report.repository.url} target="_blank" rel="noopener">Open on GitHub ↗</a></article></section>
</main>
<style>
.report-page{max-width:1100px;margin:auto;padding:60px 24px 120px}.back,.label{font:700 9px 'DM Mono';letter-spacing:.1em}.back{display:block;color:var(--muted);margin-bottom:35px}.eyebrow{color:var(--accent);font:700 9px 'DM Mono';letter-spacing:.13em}.report-head{border-bottom:1px solid var(--line);padding-bottom:30px}.report-head h1{font:400 clamp(55px,8vw,105px)/.83 'Instrument Serif';margin:18px 0}.report-head>p{max-width:760px;color:var(--muted);line-height:1.7}.meta{display:flex;gap:24px;margin-top:20px;font:9px 'DM Mono';text-transform:uppercase}.meta span:nth-child(2){color:var(--accent)}.score-row{display:grid;grid-template-columns:1fr 1fr;gap:50px;padding:35px 0;border-bottom:1px solid var(--line)}.score-row strong{display:block;font:700 86px 'DM Sans';line-height:1;margin-top:10px}.score-row small{font:11px 'DM Mono';color:var(--muted)}.score-row p{color:var(--muted);line-height:1.7;max-width:420px}.blocks{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line)}.blocks article{padding:28px;border-right:1px solid var(--line)}.blocks article:last-child{border-right:0}.check{display:grid;grid-template-columns:55px 1fr;gap:8px;padding:13px 0;border-top:1px solid var(--line);margin-top:13px}.check b{text-transform:uppercase;font:700 8px 'DM Mono'}.check b.pass{color:#126144}.check b.warn{color:#a36800}.check span{grid-column:2;color:var(--muted);font-size:11px}.perm{display:flex;justify-content:space-between;padding:13px 0;border-bottom:1px solid var(--line);font:10px 'DM Mono'}.perm span{color:var(--muted)}.risk{padding:30px 0;border-bottom:1px solid var(--line)}.risk ul{padding-left:20px;color:#8b3c23;line-height:2}.risk p,.muted{color:var(--muted)}.blocks a{text-decoration:underline;font:9px 'DM Mono'}
@media(max-width:700px){.blocks,.score-row{grid-template-columns:1fr}.blocks article{border-right:0;border-bottom:1px solid var(--line)}.blocks article:last-child{border-bottom:0}.score-row{gap:15px}}
</style>
<script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'SoftwareSourceCode', name:report.repository.fullName, codeRepository:report.repository.url, description:description, programmingLanguage:report.repository.language || report.stack.languages[0] })} />
</BaseLayout>
