---
import BaseLayout from '../../layouts/BaseLayout.astro';
const links=[['JPG to PDF','Convert one or many images into a PDF.','/jpg-to-pdf/'],['Merge PDF','Combine several PDF files into one.','/merge-pdf/']];
---
<BaseLayout title="Free PDF Tools — PARADOX Tools" description="Free browser PDF utilities. Convert images to PDF and merge PDFs without an account or server upload.">
  <main class="section">
    <div class="section-head"><div><div class="eyebrow">FREE PDF TOOLS</div><h1 style="font:400 clamp(60px,8vw,105px)/.86 'Instrument Serif';margin:15px 0">PDF jobs,<br><em>without the fuss.</em></h1></div><p>Start with the common things people need while filling forms: create a PDF from images or combine existing PDFs.</p></div>
    <div class="tool-grid">{links.map(([n,d,u])=><a class="tool-card featured" href={u}><div><div class="tool-icon">▤</div><h3>{n}</h3><p>{d}</p></div><div class="tool-link">Open tool ↗</div></a>)}</div>
  </main>
</BaseLayout>
