---
import MakerLayout from '../../layouts/MakerLayout.astro';
---
<MakerLayout title="PARADOX Studio" description="PARADOX AI Studio — authenticated multi-provider AI workbench.">
  <main class="studio-redirect">
    <div class="redirect-card">
      <span class="kicker">PARADOX / STUDIO</span>
      <h1>AI Studio moved.</h1>
      <p>The current AI workbench uses the authenticated server-side provider router. You are being sent there now.</p>
      <a href="/ai-studio/">Open AI Studio →</a>
    </div>
  </main>
  <script is:inline>
    window.setTimeout(() => { window.location.replace('/ai-studio/'); }, 250);
  </script>
  <style>
    .studio-redirect{min-height:72vh;display:grid;place-items:center;padding:60px 24px;background:#f4f1e9;color:#111412}
    .redirect-card{width:min(720px,100%);padding:48px;border:1px solid #cbc7bd;background:#fffdf8;box-shadow:18px 18px 0 #ff593f}
    .kicker{font:700 10px/1.2 'DM Mono',monospace;letter-spacing:.14em;color:#ff593f}
    h1{font:400 clamp(48px,8vw,92px)/.9 'Instrument Serif',Georgia,serif;margin:16px 0}
    p{max-width:600px;color:#515954;font:16px/1.7 'DM Sans',sans-serif}
    a{display:inline-block;margin-top:20px;padding:12px 16px;background:#111412;color:#fffdf8;text-decoration:none;font:700 10px 'DM Mono',monospace;text-transform:uppercase}
  </style>
</MakerLayout>
