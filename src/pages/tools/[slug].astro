---
import MakerLayout from '../../layouts/MakerLayout.astro';
import GeneratorTool from '../../components/GeneratorTool.astro';
import AdSlot from '../../components/AdSlot.astro';
import opportunities from '../../data/verified_opportunities.json';

export function getStaticPaths() {
  return (opportunities.opportunities || []).map(item => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

const { item } = Astro.props;
const canonical = `https://paradox.engineer/tools/${item.slug}/`;
const jsonLd = {
  '@context':'https://schema.org',
  '@type':'WebApplication',
  name:item.title || item.query,
  url:canonical,
  description:item.description,
  applicationCategory:'UtilitiesApplication',
  operatingSystem:'Web Browser',
  isAccessibleForFree:true,
  offers:{'@type':'Offer',price:'0',priceCurrency:'USD'},
  featureList:[item.toolLabel || item.targetComponent || item.toolId || 'Utility generator','No account required','Browser-based','Print-ready output']
};
const mode = item.mode || ({
  'classroom-bingo':'bingo',
  'word-search-puzzles':'words',
  'random-teams':'teams',
  'decision-wheel':'wheel',
  'tournament-brackets':'bracket',
  'raffle-tickets':'raffle',
  'seating-charts':'seating',
  'certificates':'certificate'
}[item.toolId] || 'bingo');
const steps = {
  bingo:['Add at least 24 entries.','Generate the randomized card.','Print or save it as PDF.'],
  words:['Add at least 3 words.','Generate the puzzle.','Print or save the finished sheet.'],
  teams:['Paste your participants.','Choose the number of teams.','Generate the groups.'],
  wheel:['Add two or more choices.','Generate a result.','Use the selected choice.'],
  bracket:['Add participants or teams.','Generate matchups.','Print or save the bracket.'],
  raffle:['Set a title and ticket count.','Generate numbered tickets.','Print the tickets.'],
  seating:['Add names.','Choose columns.','Generate the seating plan.'],
  certificate:['Enter the recipient and award.','Generate the certificate.','Print or save it.']
}[mode] || ['Enter your information.','Generate the result.','Print or save it.'];
const faq = [
  ['Is this free?', 'Yes. The tool is free to use and does not require an account.'],
  ['Do I need to upload anything?', 'No. The core generator runs in your browser.'],
  ['Can I print the result?', 'Yes. Use Print / Save PDF after generating your result.']
];
---
<MakerLayout title={`${item.title || item.query} — PARADOX`} description={item.description} canonical={canonical}>
  <main class="maker-main">
    <section class="maker-hero compact-hero">
      <div>
        <div class="maker-kicker">FREE TOOL · {item.geo || 'GLOBAL'} · NO ACCOUNT</div>
        <h1>{item.title || item.query}</h1>
        <p>{item.description}</p>
      </div>
      <div class="maker-proof">
        <div class="proof-tile"><strong>01 · TOOL</strong><span>{item.toolLabel || item.targetComponent || 'Browser utility'}</span></div>
        <div class="proof-tile"><strong>02 · CONTEXT</strong><span>{item.query || 'Current public demand signal'}</span></div>
        <div class="proof-tile"><strong>03 · OUTPUT</strong><span>Generate, print or save.</span></div>
      </div>
    </section>

    <section class="maker-section" id="tool">
      <div class="maker-section-head"><div><div class="maker-label">MODULE 01 · INTERACTIVE TOOL</div><h2>Do the job<br/><em>right here.</em></h2></div><p>No account, upload or paid API. The generator runs in your browser.</p></div>
      <GeneratorTool mode={mode} title={item.toolLabel || item.targetComponent || item.query} intro={`Create a useful result for ${item.query || 'your task'} with this free browser generator.`} steps={steps} faq={faq} />
    </section>

    <section class="maker-section">
      <div class="maker-section-head"><div><div class="maker-label">MODULE 02 · CONTEXT</div><h2>Why this<br/><em>page exists.</em></h2></div><p>{item.context || `This page connects a public demand signal to an existing PARADOX utility. It is generated only when a real tool can fulfil the use case.`}</p></div>
      <div class="maker-guide-grid">
        <article class="maker-guide"><strong>Demand signal</strong><br/>Public aggregate signals are used as discovery inputs, not as individual user data.</article>
        <article class="maker-guide"><strong>Tool match</strong><br/>The page is generated only when an implemented browser tool can fulfil the intent.</article>
        <article class="maker-guide"><strong>Useful result</strong><br/>The visitor gets an interactive output rather than a keyword-only article.</article>
      </div>
    </section>

    <section class="maker-section"><AdSlot height={280} /></section>

    <section class="maker-section">
      <div class="maker-section-head"><div><div class="maker-label">MODULE 03 · QUICK ANSWERS</div><h2>Before you<br/><em>start.</em></h2></div></div>
      <div class="maker-guide-grid">{faq.map(([q,a]) => <article class="maker-guide"><strong>{q}</strong><br/>{a}</article>)}</div>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
</MakerLayout>
