---
const { mode, title, intro, steps = [], faq = [] } = Astro.props;
const configs={bingo:{label:'WORDS OR NAMES',placeholder:'apple\nbanana\ncherry\n...'},words:{label:'WORDS',placeholder:'solar\nplanet\nrocket\n...'},teams:{label:'PEOPLE',placeholder:'Aisha\nBen\nCarlos\nDana\n...'},wheel:{label:'CHOICES',placeholder:'Pizza\nSushi\nTacos\n...'},bracket:{label:'PARTICIPANTS',placeholder:'Team A\nTeam B\nTeam C\nTeam D\n...'},raffle:{label:'TICKET LABEL (optional)',placeholder:'Spring fundraiser'},seating:{label:'NAMES',placeholder:'Aisha\nBen\nCarlos\nDana\n...'},certificate:{label:'RECIPIENT NAME',placeholder:'Alex Morgan'}};
const c=configs[mode]||configs.bingo;
---
<main class="generator-page"><div class="generator-head"><span class="maker-kicker">FREE · NO ACCOUNT · BROWSER-SIDE</span><h1>{title}</h1><p>{intro}</p></div>
<div class="generator-layout"><section class="generator-panel"><div class="generator-fields">
{mode==='raffle' ? <div class="generator-row"><label>Ticket title</label><input id="title" value="Spring Raffle" /></div> : null}
{mode==='certificate' ? <><div class="generator-row"><label>Recipient</label><input id="recipient" placeholder={c.placeholder} /></div><div class="generator-row"><label>Award</label><input id="award" value="Certificate of Appreciation" /></div><div class="generator-row"><label>Presented by</label><input id="issuer" value="PARADOX MAKERS" /></div></> : null}
{mode!=='certificate'&&mode!=='raffle' ? <><label>{c.label}</label><textarea id="items" placeholder={c.placeholder}></textarea></> : null}
{mode==='teams' ? <div class="generator-row"><label>Number of teams</label><input id="count" type="number" min="2" value="3" /></div> : null}
{mode==='seating' ? <div class="generator-row"><label>Columns</label><input id="cols" type="number" min="1" max="10" value="4" /></div> : null}
{mode==='raffle' ? <div class="generator-row"><label>Number of tickets</label><input id="qty" type="number" min="4" max="200" value="24" /></div> : null}
<div class="generator-actions"><button class="gen-btn" id="generate">Generate ↗</button><button class="gen-btn alt" id="print">Print / Save PDF</button><button class="gen-btn alt" id="share">Copy share link</button></div></div>
<div class="gen-output" id="output"><h2>Your result appears here.</h2><p>Make something above. Nothing is uploaded.</p></div></section>
<aside class="generator-info"><h2>How it works</h2><ol>{steps.map(s=><li>{s}</li>)}</ol><h3>Privacy</h3><p>The generator runs in this browser tab. Your entries are not sent to a PARADOX server.</p><h3>Print-friendly</h3><p>Use Print / Save PDF to keep the generated result as a PDF from your browser.</p></aside></div>
<div class="ad-slot">ADVERTISEMENT</div>
{faq.length ? <section class="generator-faq"><h2>Common questions</h2>{faq.map(([q,a])=><div><h3>{q}</h3><p>{a}</p></div>)}</section> : null}
</main>
<script is:inline>
(() => {const root=document.querySelector('.generator-page');if(!root)return;const mode='{mode}',out=root.querySelector('#output'),input=root.querySelector('#items');const lines=()=>[...(input?.value||'').split(/[\n,]+/)].map(x=>x.trim()).filter(Boolean);const esc=s=>String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));const shuffle=a=>{a=[...a];for(let i=a.length-1;i>0;i--){const j=crypto.getRandomValues(new Uint32Array(1))[0]%(i+1);[a[i],a[j]]=[a[j],a[i]]}return a};const shell=h=>{out.innerHTML=`<div class="sheet">${h}</div>`};function bingo(){let a=shuffle(lines());while(a.length<24)a.push('FREE');a=a.slice(0,24);a.splice(12,0,'FREE');shell(`<h2>Bingo card</h2><table><tbody>${[0,1,2,3,4].map(r=>`<tr>${[0,1,2,3,4].map(c=>`<td>${esc(a[r*5+c])}</td>`).join('')}</tr>`).join('')}</tbody></table>`)}function words(){let ws=[...new Set(lines().map(x=>x.toUpperCase().replace(/[^A-Z]/g,'')))].filter(x=>x.length>1).slice(0,12);if(!ws.length)return shell('<h2>Add some words first.</h2>');let n=12,g=Array.from({length:n},()=>Array(n).fill(''));const d=[[1,0],[0,1],[1,1],[-1,1]];ws.forEach(w=>{for(let t=0;t<70;t++){let q=d[Math.floor(Math.random()*d.length)],r=Math.floor(Math.random()*n),c=Math.floor(Math.random()*n),rr=r+q[1]*(w.length-1),cc=c+q[0]*(w.length-1);if(rr<0||rr>=n||cc<0||cc>=n)continue;let ok=true;for(let i=0;i<w.length;i++){let ch=g[r+q[1]*i][c+q[0]*i];if(ch&&ch!==w[i])ok=false}if(!ok)continue;for(let i=0;i<w.length;i++)g[r+q[1]*i][c+q[0]*i]=w[i];break}});g=g.map(row=>row.map(ch=>ch||String.fromCharCode(65+Math.floor(Math.random()*26))));shell(`<h2>Word search</h2><table><tbody>${g.map(r=>`<tr>${r.map(ch=>`<td>${ch}</td>`).join('')}</tr>`).join('')}</tbody></table><p><strong>Find:</strong> ${ws.join(', ')}</p>`)}function teams(){let a=shuffle(lines());let k=Math.max(2,Math.min(12,+root.querySelector('#count').value||3)),g=Array.from({length:k},()=>[]);a.forEach((x,i)=>g[i%k].push(x));shell(`<h2>Random teams</h2><div class="print-grid">${g.map((x,i)=>`<div class="ticket"><strong>Team ${i+1}</strong><p>${x.map(esc).join('<br>')}</p></div>`).join('')}</div>`)}function wheel(){let a=lines();if(!a.length)return shell('<h2>Add choices first.</h2>');let p=a[Math.floor(Math.random()*a.length)];shell(`<h2>The wheel chose</h2><div style="font:400 72px 'Instrument Serif';text-align:center;padding:55px 10px">${esc(p)}</div><p style="text-align:center">${a.map(esc).join(' · ')}</p>`)}function bracket(){let a=shuffle(lines());if(a.length<2)return shell('<h2>Add at least two participants.</h2>');let pairs=[];for(let i=0;i<a.length;i+=2)pairs.push([a[i],a[i+1]||'BYE']);shell(`<h2>Round 1</h2><div class="print-grid">${pairs.map((p,i)=>`<div class="ticket"><strong>Match ${i+1}</strong><p>${esc(p[0])}<br>vs<br>${esc(p[1])}</p></div>`).join('')}</div>`)}function raffle(){let n=Math.max(4,Math.min(200,+root.querySelector('#qty').value||24)),t=esc(root.querySelector('#title').value||'Raffle');shell(`<h2>${t}</h2><div class="print-grid">${Array.from({length:n},(_,i)=>`<div class="ticket"><strong>Ticket #${String(i+1).padStart(3,'0')}</strong><br>${t}</div>`).join('')}</div>`)}function seating(){let a=shuffle(lines()),cols=Math.max(1,Math.min(10,+root.querySelector('#cols').value||4)),rows=Math.ceil(a.length/cols);shell(`<h2>Seating chart</h2><table><tbody>${Array.from({length:rows},(_,r)=>`<tr>${Array.from({length:cols},(_,c)=>`<td>${esc(a[r*cols+c]||'')}</td>`).join('')}</tr>`).join('')}</tbody></table>`)}function certificate(){let n=esc(root.querySelector('#recipient').value||'Your Name'),a=esc(root.querySelector('#award').value),i=esc(root.querySelector('#issuer').value);shell(`<div style="text-align:center;padding:60px 20px;border:10px double #171815"><div class="maker-kicker">CERTIFICATE</div><h2 style="font:400 72px 'Instrument Serif';margin:15px 0">${a}</h2><p>This certificate is proudly presented to</p><div style="font:400 48px 'Instrument Serif';margin:30px 0">${n}</div><p>Presented by ${i}</p></div>`)}const f={bingo,words,teams,wheel,bracket,raffle,seating,certificate}[mode]||bingo;root.querySelector('#generate').addEventListener('click',f);root.querySelector('#print').addEventListener('click',()=>window.print());root.querySelector('#share').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href);alert('Page link copied.')}catch(e){alert('Copy the page URL from your browser.')}});})();
</script>
