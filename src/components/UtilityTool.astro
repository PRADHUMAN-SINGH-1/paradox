---
const { mode, title, intro, aValue: propAValue, bValue: propBValue } = Astro.props;
const configs = {
  percentage:{a:'Percentage',b:'Of number',aType:'number',bType:'number',aValue:'15',bValue:'200'},
  age:{a:'Date of birth',b:'Calculate as of',aType:'date',bType:'date'},
  timezone:{a:'Date & time',b:'Source time zone',aType:'datetime-local',bType:'text',aValue:'2026-09-12T12:00',bValue:'UTC'},
  units:{a:'Value',b:'Conversion',aType:'number',bType:'text',aValue:'10',bValue:'km to miles'},
  countdown:{a:'Target date & time',b:'',aType:'datetime-local',bType:'text'},
  random:{a:'Minimum',b:'Maximum',aType:'number',bType:'number',aValue:'1',bValue:'100'},
  text:{a:'Text',b:'',aType:'textarea',bType:'text'},
  datediff:{a:'Start date',b:'End date',aType:'date',bType:'date'},
  password:{a:'Length',b:'Options',aType:'number',bType:'text',aValue:'20',bValue:'upper,lower,numbers,symbols'},
  bmi:{a:'Weight (kg)',b:'Height (cm)',aType:'number',bType:'number',aValue:'70',bValue:'175'},
  emi:{a:'Loan amount',b:'Annual interest %',c:'Loan term (months)',aType:'number',bType:'number',cType:'number',aValue:'1000000',bValue:'8.5',cValue:'60'},
  gst:{a:'Amount',b:'GST %',aType:'number',bType:'number',aValue:'1000',bValue:'18'},
  sip:{a:'Monthly investment',b:'Expected annual return %',c:'Investment period (years)',aType:'number',bType:'number',cType:'number',aValue:'5000',bValue:'12',cValue:'10'},
  discount:{a:'Original price',b:'Discount %',aType:'number',bType:'number',aValue:'1000',bValue:'20'},
  tip:{a:'Bill amount',b:'Tip %',aType:'number',bType:'number',aValue:'1000',bValue:'15'},
  json:{a:'JSON',b:'',aType:'textarea',bType:'text'},
  base64:{a:'Text',b:'Mode',aType:'textarea',bType:'text',bValue:'encode'},
  characters:{a:'Text',b:'',aType:'textarea',bType:'text'},
  qr:{a:'Text or URL',b:'Size',aType:'text',bType:'number',aValue:'https://paradox.engineer/',bValue:'240'},
  imagecompressor:{a:'Choose an image',b:'Quality %',aType:'file',bType:'number',aValue:'80',bValue:'80'}
};
const c=configs[mode]??configs.percentage;
---
<main class="generator-page utility-page" data-utility={mode}>
  <div class="generator-breadcrumb"><a href="/">PARADOX MAKERS</a> / <span>{title}</span></div>
  <header class="generator-head"><span class="maker-kicker">FREE · NO ACCOUNT · LOCAL CALCULATION</span><h1>{title}</h1><p>{intro}</p><div class="generator-subline">No upload · No paid API · Works in your browser</div></header>
  <div class="generator-layout">
    <section class="generator-panel" aria-label="Utility controls"><div class="generator-panel-head"><h2>01 / Inputs</h2><span>Instant</span></div><div class="generator-fields">
      <div class="field"><label for="utilityA">{c.a}</label>{c.aType==='textarea'?<textarea id="utilityA" data-field="a" placeholder="Paste or type text here"></textarea>:c.aType==='file'?<input id="utilityA" data-field="a" type="file" accept="image/jpeg,image/png,image/webp" />:<input id="utilityA" data-field="a" type={c.aType} value={propAValue ?? c.aValue} />}</div>
      {c.b?<div class="field"><label for="utilityB">{c.b}</label><input id="utilityB" data-field="b" type={c.bType} value={(propBValue ?? c.bValue) || ''} /></div>:null}
      {c.c?<div class="field"><label for="utilityC">{c.c}</label><input id="utilityC" data-field="c" type={c.cType} value={c.cValue || ''} min="1" /></div>:null}
      {mode==='random'?<div class="field"><label for="count">How many results?</label><input id="count" data-field="count" type="number" min="1" max="100" value="1" /></div>:null}
      {mode==='timezone'?<div class="field"><label for="zone">Convert to time zone</label><input id="zone" data-field="zone" value="Asia/Kolkata" placeholder="e.g. America/New_York" /></div>:null}
      <div class="generator-actions"><button type="button" class="gen-btn" id="calculate">Calculate</button><button type="button" class="gen-btn alt" id="clear">Clear</button><button type="button" class="gen-btn alt" id="share">Copy share link</button></div><div id="status" aria-live="polite"></div>
    </div></section>
    <aside class="generator-preview" aria-label="Result"><div class="generator-preview-head"><h2>02 / Result</h2><span id="resultLabel">Ready</span></div><div class="preview-empty" id="emptyPreview"><div><strong>Your answer appears here.</strong><span>Enter values and press Calculate.</span></div></div><div class="gen-output" id="output" hidden></div></aside>
  </div>
  <div class="ad-slot">ADVERTISEMENT</div>
  <aside class="generator-info"><h2>Privacy and speed</h2><p>Your values stay in this browser for the calculation. PARADOX does not need an account or server upload.</p></aside>
</main>
<script is:inline>
(() => {
  const root=document.querySelector('.utility-page');if(!root)return;const mode=root.dataset.utility,output=root.querySelector('#output'),empty=root.querySelector('#emptyPreview'),status=root.querySelector('#status'),label=root.querySelector('#resultLabel'),a=root.querySelector('[data-field="a"]'),b=root.querySelector('[data-field="b"]'),c=root.querySelector('[data-field="c"]'),count=root.querySelector('[data-field="count"]'),zone=root.querySelector('[data-field="zone"]');
  const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const msg=(text,type='error')=>status.innerHTML=text?`<div class="status-${type}">${esc(text)}</div>`:'';
  const show=(html,name='Calculated')=>{empty.hidden=true;output.hidden=false;output.innerHTML=`<div class="sheet utility-result">${html}</div>`;label.textContent=name;output.scrollIntoView({behavior:'smooth',block:'nearest'})};
  const dateValue=v=>{const d=new Date(v);return Number.isNaN(d.getTime())?null:d};
  function timezoneParts(instant,timeZone){const parts=new Intl.DateTimeFormat('en-US',{timeZone,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(instant);const out={};for(const p of parts)if(p.type!=='literal')out[p.type]=Number(p.value);return out}
  function zonedLocalToUtc(local,timeZone){const naive=Date.parse(`${local}:00Z`);if(Number.isNaN(naive))throw new Error('invalid-date');let guess=naive;for(let i=0;i<4;i++){const p=timezoneParts(new Date(guess),timeZone);const asUtc=Date.UTC(p.year,p.month-1,p.day,p.hour,p.minute,p.second);guess=naive-(asUtc-guess)}return new Date(guess)}
  function percentage(){const p=Number(a.value),n=Number(b.value);if(!Number.isFinite(p)||!Number.isFinite(n))return msg('Enter valid numbers.');show(`<h2 class="result-title">${p}% of ${n}</h2><div class="utility-big">${(p*n/100).toLocaleString()}</div><p>${p}% = ${p/100} of the whole.</p>`)}
  function age(){const birth=dateValue(a.value),asOf=dateValue(b.value);if(!birth||!asOf||asOf<birth)return msg('Choose valid dates.');let y=asOf.getFullYear()-birth.getFullYear(),m=asOf.getMonth()-birth.getMonth(),d=asOf.getDate()-birth.getDate();if(d<0){m--;d+=new Date(asOf.getFullYear(),asOf.getMonth(),0).getDate()}if(m<0){y--;m+=12}show(`<h2 class="result-title">Exact age</h2><div class="utility-big">${y}y ${m}m ${d}d</div>`)}
  function timezone(){const raw=a.value,from=(b.value||'UTC').trim(),to=(zone?.value||'Asia/Kolkata').trim();if(!raw)return msg('Choose a date and time.');try{const instant=zonedLocalToUtc(raw,from);const formatted=new Intl.DateTimeFormat(undefined,{timeZone:to,dateStyle:'full',timeStyle:'long'}).format(instant);show(`<h2 class="result-title">${esc(to)}</h2><div class="utility-big utility-time">${esc(formatted)}</div><p>${esc(raw)} interpreted in ${esc(from)}.</p>`)}catch{return msg('Use valid IANA zones like UTC, Europe/London or Asia/Kolkata.')}}
  function units(){const value=Number(a.value),spec=(b.value||'').toLowerCase().trim();if(!Number.isFinite(value))return msg('Enter a valid numeric value.');const pairs={'km to miles':value*0.621371,'miles to km':value/0.621371,'meters to feet':value*3.280839895,'feet to meters':value/3.280839895,'cm to inches':value/2.54,'inches to cm':value*2.54,'mm to inches':value/25.4,'inches to mm':value*25.4,'kg to pounds':value*2.2046226218,'pounds to kg':value/2.2046226218,'grams to ounces':value/28.349523125,'ounces to grams':value*28.349523125,'liters to gallons':value*0.2641720524,'gallons to liters':value/0.2641720524,'celsius to fahrenheit':value*9/5+32,'fahrenheit to celsius':(value-32)*5/9,'celsius to kelvin':value+273.15,'kelvin to celsius':value-273.15,'meters to kilometers':value/1000,'kilometers to meters':value*1000};if(!(spec in pairs))return msg('Unsupported pair. Examples: km to miles, kg to pounds, celsius to fahrenheit.');show(`<h2 class="result-title">Conversion</h2><div class="utility-big">${pairs[spec].toLocaleString(undefined,{maximumFractionDigits:8})}</div><p>${value} ${esc(spec)}</p>`)}
  function countdown(){const target=dateValue(a.value);if(!target)return msg('Choose a target date and time.');const render=()=>{const diff=target.getTime()-Date.now(),abs=Math.abs(diff),days=Math.floor(abs/86400000),hours=Math.floor(abs%86400000/3600000),mins=Math.floor(abs%3600000/60000),secs=Math.floor(abs%60000/1000);const html=`<h2 class="result-title">${diff>=0?'Time remaining':'Time elapsed'}</h2><div class="utility-big" id="liveCountdown">${days}d ${hours}h ${mins}m ${secs}s</div><p>${esc(target.toLocaleString())}</p>`;empty.hidden=true;output.hidden=false;output.innerHTML=`<div class="sheet utility-result">${html}</div>`;label.textContent='Live';};render();if(root._timer)clearInterval(root._timer);root._timer=setInterval(render,1000)}
  function randomNumber(){const min=Math.ceil(Number(a.value)),max=Math.floor(Number(b.value));if(!Number.isFinite(min)||!Number.isFinite(max)||max<min)return msg('Enter a valid minimum and maximum.');const n=Math.max(1,Math.min(100,Number(count?.value||1)));const cryptoRandom=()=>{const arr=new Uint32Array(1);crypto.getRandomValues(arr);return Math.floor((arr[0]/4294967296)*(max-min+1))+min};show(`<h2 class="result-title">Random result${n>1?'s':''}</h2><div class="utility-big">${Array.from({length:n},cryptoRandom).map(x=>`<span class="number-pill">${x}</span>`).join('')}</div>`)}
  function textStats(){const text=a.value||'',words=text.trim()?text.trim().split(/\s+/).length:0,chars=text.length,noSpaces=text.replace(/\s/g,'').length,lines=text?text.split(/\n/).length:0;show(`<h2 class="result-title">Text statistics</h2><div class="print-grid"><div class="ticket"><strong>WORDS</strong><p>${words.toLocaleString()}</p></div><div class="ticket"><strong>CHARACTERS</strong><p>${chars.toLocaleString()}</p></div><div class="ticket"><strong>NO SPACES</strong><p>${noSpaces.toLocaleString()}</p></div><div class="ticket"><strong>LINES</strong><p>${lines.toLocaleString()}</p></div></div>`)}
  function dateDiff(){const start=dateValue(a.value),end=dateValue(b.value);if(!start||!end)return msg('Choose both dates.');const days=Math.round(Math.abs(end-start)/86400000),weeks=Math.floor(days/7),rem=days%7;show(`<h2 class="result-title">Date difference</h2><div class="utility-big">${days.toLocaleString()} days</div><p>${weeks} weeks${rem?` and ${rem} days`:''}.</p>`)}
  function randomBelow(max){const limit=Math.floor(0x100000000-(0x100000000%max));const arr=new Uint32Array(1);do crypto.getRandomValues(arr);while(arr[0]>=limit);return arr[0]%max}
  function password(){const len=Math.max(4,Math.min(128,parseInt(a.value||20,10))),opts=(b.value||'').toLowerCase(),sets=[opts.includes('lower')?'abcdefghijklmnopqrstuvwxyz':'',opts.includes('upper')?'ABCDEFGHIJKLMNOPQRSTUVWXYZ':'',opts.includes('numbers')?'0123456789':'',opts.includes('symbols')?'!@#$%^&*_-+=?':''];let chars=sets.join('');if(!chars)chars='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*';const out=Array.from({length:len},()=>chars[randomBelow(chars.length)]).join('');show('<h2 class="result-title">Generated password</h2><div class="utility-big utility-code">'+esc(out)+'</div><button type="button" class="gen-btn" id="copyResult">Copy password</button>')}
  function bmi(){const w=Number(a.value),h=Number(b.value)/100;if(w<=0||h<=0)return msg('Enter valid weight and height.');const x=w/(h*h),range=x<18.5?'Underweight':x<25?'Healthy range':x<30?'Overweight':'Obesity';show('<h2 class="result-title">BMI</h2><div class="utility-big">'+x.toFixed(1)+'</div><p>'+range+'. BMI is a screening measure, not a diagnosis.</p>')}
  function emi(){const p=Number(a.value),r=Number(b.value)/1200,n=Math.max(1,Math.floor(Number(c?.value||60)));if(p<=0||r<0||n<=0)return msg('Enter valid loan values.');const m=r? p*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1):p/n;show('<h2 class="result-title">Monthly EMI</h2><div class="utility-big">'+m.toLocaleString(undefined,{maximumFractionDigits:2})+'</div><p>Total payment: '+(m*n).toLocaleString(undefined,{maximumFractionDigits:2})+' · Interest: '+(m*n-p).toLocaleString(undefined,{maximumFractionDigits:2})+'</p>')}
  function gst(){const amount=Number(a.value),rate=Number(b.value);if(!Number.isFinite(amount)||!Number.isFinite(rate)||rate<0)return msg('Enter valid values.');const tax=amount*rate/100;show('<h2 class="result-title">GST calculation</h2><div class="print-grid"><div class="ticket"><strong>GST</strong><p>'+tax.toLocaleString()+'</p></div><div class="ticket"><strong>TOTAL</strong><p>'+(amount+tax).toLocaleString()+'</p></div></div>')}
  function sip(){const p=Number(a.value),annual=Number(b.value),n=Math.max(1,Number(c?.value||10));if(p<=0||annual<0||n<=0)return msg('Enter valid SIP values.');const r=annual/1200,months=n*12,fv=r?p*((Math.pow(1+r,months)-1)/r)*(1+r):p*months;show('<h2 class="result-title">Estimated SIP value</h2><div class="utility-big">'+fv.toLocaleString(undefined,{maximumFractionDigits:0})+'</div><p>Invested: '+(p*months).toLocaleString()+' · Estimated gain: '+(fv-p*months).toLocaleString(undefined,{maximumFractionDigits:0})+'</p>')}
  function discount(){const price=Number(a.value),rate=Number(b.value);if(price<0||rate<0)return msg('Enter valid values.');const save=price*rate/100;show('<h2 class="result-title">Discount result</h2><div class="utility-big">'+(price-save).toLocaleString()+'</div><p>You save '+save.toLocaleString()+' ('+rate+'%).</p>')}
  function tip(){const bill=Number(a.value),rate=Number(b.value);if(bill<0||rate<0)return msg('Enter valid values.');const tip=bill*rate/100;show('<h2 class="result-title">Tip</h2><div class="utility-big">'+tip.toLocaleString()+'</div><p>Total bill: '+(bill+tip).toLocaleString()+'</p>')}
  function json(){try{const parsed=JSON.parse(a.value);show('<h2 class="result-title">Valid JSON</h2><pre class="utility-pre">'+esc(JSON.stringify(parsed,null,2))+'</pre>','Valid')}catch(e){msg('Invalid JSON: '+e.message)}}
  function base64(){try{const text=a.value||'';const out=(b.value||'encode').toLowerCase()==='decode'?new TextDecoder().decode(Uint8Array.from(atob(text.replace(/\s/g,'')),ch=>ch.charCodeAt(0))):(()=>{const bytes=new TextEncoder().encode(text);let bin='';for(let i=0;i<bytes.length;i+=0x8000)bin+=String.fromCharCode(...bytes.subarray(i,i+0x8000));return btoa(bin)})();show('<h2 class="result-title">Base64 result</h2><pre class="utility-pre">'+esc(out)+'</pre>')}catch{msg('Could not process this Base64 value.')}}
  function characters(){const t=a.value||'';show('<h2 class="result-title">Character count</h2><div class="utility-big">'+t.length.toLocaleString()+'</div><p>Without spaces: '+t.replace(/\s/g,'').length.toLocaleString()+' · Words: '+(t.trim()?t.trim().split(/\s+/).length:0).toLocaleString()+'</p>')}
  async function imagecompressor(){const file=a?.files?.[0];const quality=Math.max(.1,Math.min(1,Number(b.value||80)/100));if(!file)return msg('Choose a JPG, PNG or WebP image.');if(file.size>50*1024*1024)return msg('Please choose an image under 50 MB.');let bitmap=null;try{bitmap=await createImageBitmap(file);const canvas=document.createElement('canvas');canvas.width=bitmap.width;canvas.height=bitmap.height;const ctx=canvas.getContext('2d');if(!ctx)throw new Error('canvas');ctx.drawImage(bitmap,0,0);const blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',quality));if(!blob)return msg('This image could not be compressed.');const before=file.size,after=blob.size,percent=Math.max(0,Math.round((1-after/before)*100)),url=URL.createObjectURL(blob);show('<h2 class="result-title">Compressed image</h2><div class="utility-big">'+(after/1024).toFixed(0)+' KB</div><p>'+percent+'% smaller · '+(before/1024).toFixed(0)+' KB → '+(after/1024).toFixed(0)+' KB</p><a class="gen-btn" href="'+url+'" download="paradox-compressed.jpg">Download JPG</a><button type="button" class="gen-btn alt" id="releaseImageUrl">Release preview memory</button>','Done');root.querySelector('#releaseImageUrl')?.addEventListener('click',()=>{URL.revokeObjectURL(url);msg('Preview memory released.','success')})}catch{msg('This image could not be decoded or compressed in this browser.')}finally{bitmap?.close()}}
  function qr(){const text=a.value||'';if(!text)return msg('Enter a URL or text.');const size=Math.max(120,Math.min(800,Number(b.value)||240));show('<h2 class="result-title">QR code</h2><div id="qrMount" style="text-align:center"></div><p>QR generated for the text above.</p>');const render=()=>{const mount=document.querySelector('#qrMount');if(!mount||!window.QRCode?.toCanvas){msg('QR library is unavailable right now.');return}const canvas=document.createElement('canvas');mount.replaceChildren(canvas);window.QRCode.toCanvas(canvas,text,{width:size,margin:2},(error)=>{if(error)msg('QR code could not be generated.')})};if(window.QRCode){render();return}const src='https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js';const existing=document.querySelector(`script[src="${src}"]`);if(existing){existing.addEventListener('load',render,{once:true});existing.addEventListener('error',()=>msg('QR library could not be loaded.'),{once:true});return}const s=document.createElement('script');s.src=src;s.onload=render;s.onerror=()=>msg('QR library could not be loaded.');document.head.appendChild(s)}
  root.addEventListener('click',async event=>{const button=event.target instanceof Element?event.target.closest('#copyResult'):null;if(!button)return;const value=root.querySelector('.utility-code')?.textContent||'';try{await navigator.clipboard.writeText(value);msg('Password copied.','success')}catch{msg('Clipboard access is blocked; select the password and copy it manually.')}});
  const fn={percentage,age,timezone,units,countdown,random:randomNumber,text:textStats,datediff:dateDiff,password,bmi,emi,gst,sip,discount,tip,json,base64,characters,qr,imagecompressor}[mode];
  root.querySelector('#calculate')?.addEventListener('click',()=>{msg('');if(typeof fn==='function')fn()});
  root.querySelector('#clear')?.addEventListener('click',()=>{if(root._timer)clearInterval(root._timer);root.querySelectorAll('input,textarea').forEach(el=>el.value='');output.hidden=true;empty.hidden=false;label.textContent='Ready';msg('Cleared.','success')});
  root.querySelector('#share')?.addEventListener('click',async()=>{const q=new URLSearchParams({a:a?.value||'',b:b?.value||'',c:c?.value||'',count:count?.value||'',zone:zone?.value||''}),url=`${location.origin}${location.pathname}?${q}`;try{await navigator.clipboard.writeText(url);msg('Share link copied.','success')}catch{msg(url,'success')}});
  const q=new URLSearchParams(location.search);if(q.has('a')&&a)a.value=q.get('a')||'';if(q.has('b')&&b)b.value=q.get('b')||'';if(q.has('c')&&c)c.value=q.get('c')||'';if(q.has('count')&&count)count.value=q.get('count')||'1';if(q.has('zone')&&zone)zone.value=q.get('zone')||'Asia/Kolkata';if(q.has('a')&&typeof fn==='function')fn();
})();
</script>
