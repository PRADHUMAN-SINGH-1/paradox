---
const { height = 280, width = '100%', label = 'ADVERTISEMENT' } = Astro.props;
---
<div class="ad-slot paradox-ad" aria-label="Advertisement" style={`width:${width};height:${height}px;min-height:${height}px`}>
  <span>{label}</span>
</div>
<style>
.paradox-ad{position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;box-sizing:border-box}
.paradox-ad span{font-family:'DM Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.12em;opacity:.45}
</style>