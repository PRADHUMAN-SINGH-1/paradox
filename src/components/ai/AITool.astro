---
const { mode, title, intro } = Astro.props;

type Field = { label: string; id: string; type?: 'text'|'textarea'|'number'; placeholder?: string; value?: string; rows?: number };
const fields: Record<string, Field[]> = {
  'prompt-generator': [
    {label:'Goal',id:'goal',value:'Write a launch announcement'},
    {label:'Audience',id:'audience',value:'software developers'},
    {label:'Tone',id:'tone',value:'clear and confident'},
    {label:'Constraints',id:'rules',value:'No hype; stay factual'},
    {label:'Output format',id:'format',value:'headline + bullets + CTA'}
  ],
  'prompt-formatter': [{label:'Prompt',id:'text',type:'textarea',placeholder:'Paste a rough prompt...',rows:9}],
  'token-counter': [{label:'Text',id:'text',type:'textarea',placeholder:'Paste text...',rows:9},{label:'Context window',id:'ctx',type:'number',value:'128000'}],
  'cost-calculator': [
    {label:'Requests / month',id:'req',type:'number',value:'10000'},
    {label:'Input tokens / request',id:'in',type:'number',value:'1000'},
    {label:'Output tokens / request',id:'out',type:'number',value:'500'},
    {label:'Input $ / 1M tokens',id:'ip',type:'number',value:'2.50'},
    {label:'Output $ / 1M tokens',id:'op',type:'number',value:'10'}
  ],
  'context-calculator': [{label:'Text / prompt',id:'text',type:'textarea',placeholder:'Paste text...',rows:9},{label:'Context window',id:'ctx',type:'number',value:'128000'}],
  'json-formatter': [{label:'JSON',id:'text',type:'textarea',placeholder:'Paste JSON here...',rows:12}],
  'json-to-prompt': [{label:'JSON',id:'text',type:'textarea',value:'{"role":"analyst","task":"summarize","format":"bullets"}',rows:12}],
  'system-prompt-builder': [
    {label:'Role',id:'role',value:'Senior technical assistant'},
    {label:'Goals',id:'goals',type:'textarea',value:'Be useful, accurate and concise.',rows:6},
    {label:'Rules',id:'rules',type:'textarea',value:'Do not invent facts. State assumptions.',rows:6},
    {label:'Output format',id:'format',value:'Markdown with headings'}
  ],
  'prompt-diff': [{label:'Original',id:'a',type:'textarea',rows:8},{label:'New',id:'b',type:'textarea',rows:8}],
  'regex-tester': [{label:'Pattern',id:'pattern',value:'\\b[A-Z][a-z]+\\b'},{label:'Flags',id:'flags',value:'g'},{label:'Test text',id:'text',type:'textarea',rows:8}],
  'markdown-cleaner': [{label:'Markdown / AI output',id:'text',type:'textarea',placeholder:'Paste Markdown or AI output...',rows:10}],
  'uuid-generator': [{label:'Count',id:'count',type:'number',value:'10'}],
  'base64-encoder-decoder': [{label:'Value',id:'text',type:'textarea',placeholder:'Enter text or Base64...',rows:8}],
  'jwt-decoder': [{label:'JWT',id:'text',type:'textarea',placeholder:'Paste a JWT here...',rows:8}],
  'text-case-converter': [{label:'Text',id:'text',type:'textarea',placeholder:'Enter text...',rows:8}],
  'llms-txt-generator': [
    {label:'Site name',id:'site',value:'PARADOX Makers'},
    {label:'Description',id:'desc',type:'textarea',value:'Free browser-first tools.',rows:5},
    {label:'URLs, one per line',id:'urls',type:'textarea',value:'https://paradox.engineer/\\nhttps://paradox.engineer/ai-studio/',rows:8}
  ]
};
const modeFields = fields[mode] ?? fields['prompt-formatter'];
---
<div class="studio-tool" data-ai-tool={mode}>
  <header class="studio-tool-head">
    <div>
      <span>DEVELOPER TOOL</span>
      <h3>{title}</h3>
      <p>{intro}</p>
    </div>
    <strong>LOCAL · OPTIONAL AI ASSIST</strong>
  </header>
  <div class="studio-tool-grid">
    <section class="studio-tool-input">
      <header><span>01 / INPUT</span><b>{mode.replaceAll('-', ' ').toUpperCase()}</b></header>
      <div class="studio-tool-fields">
        {modeFields.map((field) => field.type === 'textarea' ? (
          <label>
            <span>{field.label}</span>
            <textarea data-field={field.id} rows={field.rows ?? 6} placeholder={field.placeholder ?? ''}>{field.value ?? ''}</textarea>
          </label>
        ) : (
          <label>
            <span>{field.label}</span>
            <input data-field={field.id} type={field.type ?? 'text'} value={field.value ?? ''} placeholder={field.placeholder ?? ''} />
          </label>
        ))}
      </div>
      <div class="studio-tool-actions">
        {mode === 'base64-encoder-decoder' && <button type="button" data-action="encode">ENCODE</button>}
        {mode === 'base64-encoder-decoder' && <button type="button" data-action="decode">DECODE</button>}
        <button type="button" class="primary" data-action="run">RUN TOOL ↗</button>
        <button type="button" data-action="ai">AI ASSIST ↗</button>
        <button type="button" data-action="clear">CLEAR</button>
        <button type="button" data-action="copy">COPY RESULT</button>
      </div>
      <div data-role="status" aria-live="polite"></div>
    </section>
    <section class="studio-tool-output">
      <header><span>02 / RESULT</span><b data-role="result-meta">READY</b></header>
      <div data-role="empty" class="studio-tool-empty"><strong>Ready.</strong><span>Enter data and run the tool.</span></div>
      <div data-role="output" class="studio-tool-result" hidden></div>
    </section>
  </div>
</div>
