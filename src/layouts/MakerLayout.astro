---
import '../styles/global.css';
const { title, description, canonical = 'https://paradox.engineer/' } = Astro.props;
const year = new Date().getFullYear();
const jsonLd={ '@context':'https://schema.org','@type':'WebApplication',name:title.split(' — ')[0],url:canonical,description,applicationCategory:'UtilitiesApplication',operatingSystem:'Web Browser',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'} };
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="google-adsense-account" content="ca-pub-4630615697632107"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><link rel="canonical" href={canonical}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet"/><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4630615697632107" crossorigin="anonymous"></script><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script><title>{title}</title>
<style>
body{background:#f6f2e9;color:#171815;font-family:Arial,sans-serif}.maker-header{height:72px;padding:0 5vw;border-bottom:1px solid #d8d0c2;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:rgba(246,242,233,.95);z-index:20}.maker-brand{font:500 18px 'DM Mono';letter-spacing:.13em}.maker-brand b{color:#d84f35;font-weight:500}.maker-nav{display:flex;gap:24px;font:10px 'DM Mono';text-transform:uppercase}.maker-nav a{opacity:.7}.maker-nav a:hover{opacity:1}.maker-cta{border:1px solid #171815;padding:9px 13px;font:10px 'DM Mono'}.maker-main{max-width:1180px;margin:auto;padding:58px 24px 90px}.maker-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:50px;align-items:center;padding:44px 0 70px}.maker-kicker,.maker-label{font:10px 'DM Mono';letter-spacing:.15em;text-transform:uppercase;color:#d14c35}.maker-hero h1{font:400 clamp(64px,9vw,128px)/.82 'Instrument Serif';letter-spacing:-.055em;margin:20px 0}.maker-hero h1 em{color:#d14c35}.maker-hero p{max-width:690px;font-size:18px;line-height:1.75;color:#5f615a}.maker-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.maker-primary,.maker-secondary{padding:14px 18px;font:10px 'DM Mono';border:1px solid #171815}.maker-primary{background:#171815;color:#f7f2e8}.maker-secondary{background:transparent}.maker-stamp{min-height:330px;border:1px solid #c9c0b2;background:#fbf8f1;display:grid;place-items:center;position:relative;overflow:hidden}.maker-stamp:before{content:'';position:absolute;width:250px;height:250px;border:1px dashed #c9c0b2;border-radius:50%}.maker-stamp-inner{position:relative;transform:rotate(-7deg);border:1px solid #171815;padding:26px;text-align:center}.maker-stamp-inner strong{font:400 58px 'Instrument Serif';display:block;color:#d14c35}.maker-tools{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.maker-card{background:#fffdf8;border:1px solid #ddd4c5;padding:22px;min-height:235px;display:flex;flex-direction:column;justify-content:space-between;transition:transform .2s,border-color .2s}.maker-card:hover{transform:translateY(-5px);border-color:#9c9385}.maker-card.featured{grid-column:span 2;background:#efe8da}.maker-icon{font-size:32px}.maker-card h2{font:400 32px/1 'Instrument Serif';margin:12px 0 8px}.maker-card p{font:12px/1.65 'DM Mono';color:#71736d;margin:0}.maker-open{font:10px 'DM Mono';text-transform:uppercase;letter-spacing:.08em;margin-top:14px}.maker-section{padding:85px 0;border-top:1px solid #d8d0c2}.maker-section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:28px}.maker-section-head h2{font:400 clamp(46px,7vw,82px)/.9 'Instrument Serif';margin:10px 0}.maker-section-head p{max-width:430px;font:12px/1.75 'DM Mono';color:#6d7069}.maker-guides{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.maker-guide{border:1px solid #d8d0c2;background:#fffdf8;padding:20px;font:12px/1.6 'DM Mono'}.maker-why{max-width:800px}.maker-why h2{font:400 64px/.9 'Instrument Serif';margin:12px 0 22px}.maker-why p{font:15px/1.9 Arial;color:#5d6059}.maker-footer{border-top:1px solid #d8d0c2;padding:28px 5vw;display:flex;justify-content:space-between;gap:20px;font:10px 'DM Mono';color:#6d7069}.maker-footer nav{display:flex;gap:18px}.generator-page{max-width:1180px;margin:auto;padding:55px 24px 90px}.generator-head{max-width:820px}.generator-head .maker-kicker{display:block}.generator-head h1{font:400 clamp(58px,8vw,105px)/.84 'Instrument Serif';margin:18px 0}.generator-head p{font:16px/1.8 Arial;color:#5f615a;max-width:760px}.generator-layout{display:grid;grid-template-columns:1.25fr .75fr;gap:18px;margin-top:32px}.generator-panel,.generator-info{background:#fffdf8;border:1px solid #d8d0c2;padding:22px}.generator-panel textarea,.generator-panel input,.generator-panel select{width:100%;border:1px solid #cfc6b7;background:#fff;padding:12px;font:12px 'DM Mono'}.generator-panel textarea{min-height:155px;resize:vertical}.generator-fields{display:grid;gap:14px}.generator-row{display:grid;grid-template-columns:1fr 160px;gap:12px;align-items:center}.generator-row label{font:11px 'DM Mono'}.generator-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}.gen-btn{border:1px solid #171815;background:#171815;color:#fff;padding:12px 15px;font:10px 'DM Mono'}.gen-btn.alt{background:transparent;color:#171815}.gen-output{margin-top:22px;border-top:1px solid #d8d0c2;padding-top:22px}.gen-output h2{font:400 38px 'Instrument Serif';margin:0 0 14px}.gen-output .sheet{background:white;border:1px solid #d0c8bb;padding:20px}.gen-output table{width:100%;border-collapse:collapse}.gen-output td,.gen-output th{border:1px solid #aaa194;padding:9px;text-align:center}.gen-output td{height:54px;font:600 13px Arial}.gen-output .print-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.gen-output .ticket{border:1px dashed #8e8679;padding:12px}.generator-info h2{font:400 34px 'Instrument Serif';margin:0 0 10px}.generator-info h3{font:500 12px 'DM Mono';margin-top:24px}.generator-info p,.generator-info li{font:12px/1.75 'DM Mono';color:#6d7069}.generator-faq{margin-top:55px;max-width:820px}.generator-faq h2{font:400 44px 'Instrument Serif'}.generator-faq h3{font:500 14px 'DM Mono';margin-top:28px}.generator-faq p{font:14px/1.8 Arial;color:#5f615a}.ad-slot{margin:24px 0;border-top:1px solid #d8d0c2;border-bottom:1px solid #d8d0c2;text-align:center;padding:13px;font:8px 'DM Mono';color:#9a958b}@media(max-width:900px){.maker-hero,.generator-layout{grid-template-columns:1fr}.maker-tools{grid-template-columns:1fr}.maker-card.featured{grid-column:auto}.maker-guides{grid-template-columns:1fr}.maker-header nav{display:none}.maker-footer{flex-direction:column}}@media(max-width:600px){.maker-main,.generator-page{padding-left:18px;padding-right:18px}.maker-hero h1{font-size:62px}.generator-head h1{font-size:60px}.generator-row{grid-template-columns:1fr}.gen-output .print-grid{grid-template-columns:1fr}}
@media print{.maker-header,.maker-footer,.maker-actions,.generator-info,.generator-head,.generator-faq,.ad-slot{display:none!important}.maker-main,.generator-page{max-width:none;padding:0}.gen-output{border:0}.sheet{page-break-inside:avoid}}
</style></head><body>
<header class="maker-header"><a class="maker-brand" href="/">PARADOX <b>MAKERS</b></a><nav class="maker-nav"><a href="/#tools">Generators</a><a href="/#guides">Guides</a><a href="/about/">About</a></nav><a class="maker-cta" href="/#tools">Start creating ↗</a></header>
<slot />
<footer class="maker-footer"><div>PARADOX MAKERS · free by design</div><nav><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/contact/">Contact</a></nav><small>© {year}</small></footer>
</body></html>
