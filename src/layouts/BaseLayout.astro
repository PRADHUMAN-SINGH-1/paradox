---
import '../styles/global.css';
import '../styles/product.css';
import '../styles/ui-enhancement.css';
import '../styles/product-visual-upgrade.css';
import '../styles/product-complete-ui.css';
import '../styles/product-polish.css';
import '../styles/product-final-ui.css';
import '../styles/startup-intelligence.css';
import '../styles/startup-visual-system.css';
import '../styles/visibility-fixes.css';
import '../styles/site-final.css';
const {
  title,
  description,
  canonical = 'https://paradox.engineer/',
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  jsonLd,
} = Astro.props;
const year = new Date().getFullYear();
const websiteLd = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PARADOX',
  url: 'https://paradox.engineer/',
  description: 'Discover, inspect and verify public AI agents and GitHub projects.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://paradox.engineer/agents/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5V0LJN6HTS"></script>
    <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){window.dataLayer.push(['js',new Date()])}gtag('config','G-5V0LJN6HTS');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#060807" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PARADOX" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23060807'/><path d='M30 72V28h22c13 0 21 7 21 18s-8 18-21 18H42V72zM42 53h9c6 0 10-2 10-7s-4-7-10-7h-9z' fill='%23d8ff43'/><path d='M28 78L72 22' stroke='%2371e6d2' stroke-width='5' opacity='.82'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd).replace(/</g, '\\u003c')}></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="PARADOX home">
        <span class="brand-mark" aria-hidden="true">P</span>
        <span class="brand-name">PARADOX</span>
        <span class="brand-subtitle">/ AGENT INTELLIGENCE</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/agents/">Discover</a><a href="/ai/">AI Tools</a><a href="/verify/">Verify</a><a href="/compare/">Compare</a><a href="/trending/">Trending</a><a href="/about/">About</a>
      </nav>
      <div class="header-actions"><a class="header-search" href="/agents/">Search</a><a class="header-cta" href="/auth/" data-auth-link>Sign in</a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobileNav" aria-label="Open navigation">Menu</button></div>
      <nav class="mobile-nav" id="mobileNav"><a href="/agents/">Discover</a><a href="/ai/">AI Tools</a><a href="/verify/">Verify</a><a href="/compare/">Compare</a><a href="/trending/">Trending</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/auth/" data-auth-link>Sign in</a></nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-brand-block">
        <strong>PARADOX</strong>
        <span>Discover, inspect and verify public AI agents and skills.</span>
        <div class="pf-contact" aria-label="Contact details">
          <a href="https://www.linkedin.com/in/pradhuman--singh/" rel="me noopener noreferrer" target="_blank" aria-label="LinkedIn profile">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M6.94 8.38H3.56V20h3.38V8.38ZM5.25 3a1.98 1.98 0 1 0 0 3.96A1.98 1.98 0 0 0 5.25 3ZM20.44 13.38c0-3.5-1.87-5.13-4.36-5.13-2.01 0-2.91 1.1-3.41 1.87v-1.74H9.29V20h3.38v-5.74c0-1.51.29-2.98 2.16-2.98 1.84 0 1.87 1.73 1.87 3.08V20H20l.44-6.62Z"/></svg>
            <span class="pf-label">LINKEDIN</span>
          </a>
          <a href="mailto:pradhumansingh196@gmail.com" aria-label="Email Pradhuman Singh">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4.5 7 7.5 6 7.5-6"/><path d="M4 18h5m6 0h5" opacity=".45"/></svg>
            <span class="pf-label">EMAIL</span>
          </a>
        </div>
      </div>
      <nav aria-label="Footer"><a href="/agents/">Discover</a><a href="/ai/">AI Tools</a><a href="/verify/">Verify</a><a href="/compare/">Compare</a><a href="/trending/">Trending</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav>
      <div><small>© {year} PARADOX · Static analysis is not a security certification</small></div>
    </footer>
    <script>import '../scripts/header-auth.ts';</script>
    <script>import '../scripts/ai-studio-provider.ts';</script>
  </body>
</html>
