---
import '../styles/global.css';
import '../styles/product.css';
import '../styles/ui-enhancement.css';
import '../styles/product-visual-upgrade.css';
import '../styles/product-complete-ui.css';
import '../styles/product-polish.css';
import '../styles/product-final-ui.css';
import '../styles/startup-intelligence.css';
import '../styles/startup-visual-system.css';
import '../styles/visibility-fixes.css';
import '../styles/site-final.css';
const { title, description, canonical='https://paradox.engineer/', robots='index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1', jsonLd } = Astro.props;
const year = new Date().getFullYear();
const websiteLd = jsonLd ?? {'@context':'https://schema.org','@type':'WebSite',name:'PARADOX',url:'https://paradox.engineer/',description:'Discover, inspect and verify public AI agents and GitHub projects.',potentialAction:{'@type':'SearchAction',target:'https://paradox.engineer/agents/?q={search_term_string}','query-input':'required name=search_term_string'}};
---
<!doctype html>
<html lang="en">
<head>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-5V0LJN6HTS"></script>
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){window.dataLayer.push(['js',new Date()])}gtag('config','G-5V0LJN6HTS');</script>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#060807" />
<meta name="description" content={description} /><meta name="robots" content={robots} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:type" content="website" /><meta property="og:site_name" content="PARADOX" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
<link rel="canonical" href={canonical} /><link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23060807'/><path d='M30 72V28h22c13 0 21 7 21 18s-8 18-21 18H42V72zM42 53h9c6 0 10-2 10-7s-4-7-10-7h-9z' fill='%23d8ff43'/><path d='M28 78L72 22' stroke='%2371e6d2' stroke-width='5' opacity='.82'/></svg>' />
<script type="application/ld+json" set:html={JSON.stringify(websiteLd).replace(/</g,'\\u003c')}></script><title>{title}</title>
</head>
<body>
<header class="site-header"><a class="brand" href="/" aria-label="PARADOX home"><span class="brand-mark" aria-hidden="true">P</span><span class="brand-name">PARADOX</span><span class="brand-subtitle">/ AGENT INTELLIGENCE</span></a><nav class="site-nav" aria-label="Primary"><a href="/agents/">Discover</a><a href="/ai/">AI Tools</a><a href="/verify/">Verify</a><a href="/compare/">Compare</a><a href="/trending/">Trending</a><a href="/about/">About</a></nav><div class="header-actions"><a class="header-search" href="/agents/">Search</a><a class="header-cta" href="/auth/" data-auth-link>Sign in</a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobileNav" aria-label="Open navigation">Menu</button></div><nav class="mobile-nav" id="mobileNav"><a href="/agents/">Discover</a><a href="/ai/">AI Tools</a><a href="/verify/">Verify</a><a href="/compare/">Compare</a><a href="/trending/">Trending</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/auth/" data-auth-link>Sign in</a></nav></header>
<slot />
<footer class="site-footer pf-footer">
  <div class="pf-footer-top">
    <section class="pf-footer-brand"><span class="pf-footer-kicker">PARADOX / AGENT INTELLIGENCE</span><strong>Useful intelligence.<br/><em>Built to be used.</em></strong><p>Discover, inspect and verify public AI agents and GitHub projects.</p></section>
    <nav class="pf-footer-nav" aria-label="Footer navigation"><span class="pf-footer-label">EXPLORE</span><a href="/agents/">Discover</a><a href="/ai/">AI Tools</a><a href="/verify/">Verify</a><a href="/compare/">Compare</a><a href="/trending/">Trending</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav>
    <section class="pf-footer-contact"><span class="pf-footer-label">CONNECT</span>
      <a class="pf-social-card" href="https://www.linkedin.com/in/pradhuman--singh/" rel="me noopener noreferrer" target="_blank"><span class="pf-social-icon pf-linkedin" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M6.2 8.2V18M6.2 5.2v.1M10.8 18v-5.4c0-2.2 1.3-3.5 3.2-3.5 1.9 0 3.1 1.2 3.1 3.6V18M10.8 12.5V9.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="3.5" y="3.5" width="17" height="17" rx="4" stroke="currentColor" stroke-width="1.4"/></svg></span><span><b>LinkedIn</b><small>Professional profile</small></span><i>↗</i></a>
      <a class="pf-social-card" href="mailto:pradhumansingh196@gmail.com"><span class="pf-social-icon pf-mail" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5.5" width="17" height="13" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="m5.5 7.5 6.5 5 6.5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Email</b><small>pradhumansingh196@gmail.com</small></span><i>↗</i></a>
    </section>
  </div>
  <div class="pf-footer-bottom"><span>© {year} PARADOX</span><span>Static analysis is not a security certification.</span><span>Built for the web.</span></div>
</footer>
<script>import '../scripts/header-auth.ts';</script><script>import '../scripts/ai-studio-provider.ts';</script>
</body></html>
