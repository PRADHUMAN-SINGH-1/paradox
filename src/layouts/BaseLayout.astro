---
import '../styles/global.css';
import '../styles/product.css';
import '../styles/ui-enhancement.css';
import '../styles/product-visual-upgrade.css';
import '../styles/product-complete-ui.css';
import '../styles/product-polish.css';
import '../styles/product-final-ui.css';
import '../styles/startup-intelligence.css';
import '../styles/startup-visual-system.css';
import '../styles/visibility-fixes.css';
import '../styles/site-final.css';
import '../styles/professional-polish.css';
import '../styles/analysis-output.css';
import '../styles/ai-studio-polish.css';
import '../styles/ai-tools-contrast.css';
import '../styles/site-contract.css';
const { title, description, canonical='https://paradox.engineer/', robots='index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1', jsonLd } = Astro.props;
const year = new Date().getFullYear();
const pageUrl = new URL(canonical);
const pagePath = pageUrl.pathname.replace(/\/+$/, '');
const slugLabel = (slug: string) => slug.replace(/[-_]+/g, ' ').replace(/\b\w/g, (char: string) => char.toUpperCase());
const breadcrumbPaths = pagePath ? pagePath.split('/').filter(Boolean) : [];
const breadcrumb: Record<string, unknown> | null = breadcrumbPaths.length > 0 ? {
  '@type':'BreadcrumbList',
  itemListElement:[
    { '@type':'ListItem', position:1, name:'Home', item:'https://paradox.engineer/' },
    ...breadcrumbPaths.map((part, index) => ({ '@type':'ListItem', position:index + 2, name:slugLabel(part), item:`https://paradox.engineer/${breadcrumbPaths.slice(0, index + 1).join('/')}/` }))
  ]
} : null;
const graph: Record<string, unknown>[] = [
  { '@type':'WebSite', '@id':'https://paradox.engineer/#website', name:'PARADOX', url:'https://paradox.engineer/', description:'Discover, inspect and verify public AI agents, GitHub projects and practical AI tools.', inLanguage:'en-US', publisher:{ '@id':'https://paradox.engineer/#organization' } },
  { '@type':'Organization', '@id':'https://paradox.engineer/#organization', name:'PARADOX', url:'https://paradox.engineer/', sameAs:['https://www.linkedin.com/in/pradhuman--singh/'] },
  { '@type':'WebPage', '@id':`${canonical}#webpage`, url:canonical, name:title, description, inLanguage:'en-US', isPartOf:{ '@id':'https://paradox.engineer/#website' } }
];
if (breadcrumb) graph.push({ '@context':'https://schema.org', ...breadcrumb });
if (jsonLd) graph.push(jsonLd as Record<string, unknown>);
const websiteLd = { '@context':'https://schema.org', '@graph':graph };
const websiteLdText = JSON.stringify(websiteLd).replace(/</g,'\\u003c');
---
<!doctype html>
<html lang="en">
<head>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-5V0LJN6HTS"></script>
<script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){window.dataLayer.push(arguments)}gtag('config','G-5V0LJN6HTS');</script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#060807" />
<meta name="application-name" content="PARADOX" />
<meta name="author" content="PARADOX" />
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="PARADOX" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500;700&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<script type="application/ld+json" set:html={websiteLdText}></script>
<title>{title}</title>
</head>
<body>
<header class="site-header"><a class="brand" href="/" aria-label="PARADOX home"><span class="brand-mark" aria-hidden="true">P</span><span class="brand-name">PARADOX</span><span class="brand-subtitle">/ AGENT INTELLIGENCE</span></a><nav class="site-nav" aria-label="Primary"><a href="/agents/">Discover</a><a href="/ai/">AI Tools</a><a href="/verify/">Verify</a><a href="/compare/">Compare</a><a href="/trending/">Trending</a><a href="/about/">About</a></nav><div class="header-actions"><a class="header-search" href="/agents/">Search</a><a class="header-cta" href="/auth/" data-auth-link>Sign in</a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobileNav" aria-label="Open navigation">Menu</button></div><nav class="mobile-nav" id="mobileNav"><a href="/agents/">Discover</a><a href="/ai/">AI Tools</a><a href="/verify/">Verify</a><a href="/compare/">Compare</a><a href="/trending/">Trending</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/auth/" data-auth-link>Sign in</a></nav></header>
<slot />
<footer class="site-footer pf-footer">
  <div class="pf-footer-top">
    <section class="pf-footer-brand"><span class="pf-footer-kicker">PARADOX / AGENT INTELLIGENCE</span><strong>Useful intelligence.<br/><em>Built to be used.</em></strong><p>Discover, inspect and verify public AI agents and GitHub projects.</p></section>
    <nav class="pf-footer-nav" aria-label="Footer navigation"><span class="pf-footer-label">EXPLORE</span><a href="/agents/">Discover</a><a href="/ai/">AI Tools</a><a href="/verify/">Verify</a><a href="/compare/">Compare</a><a href="/trending/">Trending</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav>
    <section class="pf-footer-contact"><span class="pf-footer-label">CONNECT</span>
      <a class="pf-social-card" href="https://www.linkedin.com/in/pradhuman--singh/" rel="me noopener noreferrer" target="_blank" aria-label="Open LinkedIn profile"><span class="pf-social-icon pf-linkedin" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M5.2 8.7h3.1V19H5.2zM6.75 4.5a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0 3.6ZM10.45 8.7h3v1.4h.04c.42-.8 1.45-1.65 2.98-1.65 3.18 0 3.77 2.1 3.77 4.83V19h-3.1v-5.05c0-1.2-.03-2.74-1.67-2.74-1.68 0-1.94 1.31-1.94 2.65V19h-3.08z"/></svg></span><span><b>LinkedIn</b><small>Professional profile</small></span><i>↗</i></a>
      <a class="pf-social-card" href="mailto:pradhumansingh196@gmail.com" aria-label="Email Pradhuman Singh"><span class="pf-social-icon pf-gmail" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 6.3 12 12.7l8.5-6.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.2 17.9V7.1c0-.7.4-1.3 1.1-1.6L12 10.4l6.7-4.9c.7.3 1.1.9 1.1 1.6v10.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M4.2 7.2 12 13l7.8-5.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span><span><b>Email</b><small>pradhumansingh196@gmail.com</small></span><i>↗</i></a>
    </section>
  </div>
  <div class="pf-footer-bottom"><span>© {year} PARADOX</span><span>Static analysis is not a security certification.</span><span>Built for the web.</span></div>
</footer>
<script>import '../scripts/header-auth.ts';</script>
<script>
  if (location.pathname.startsWith('/ai-studio/')) {
    void import('../scripts/ai-studio-provider.ts');
    void import('../scripts/ai-studio-polish.ts');
  }
  if (location.pathname === '/ai/' || location.pathname.startsWith('/utilities/')) {
    void import('../scripts/ai-tool-polish.ts');
    void import('../scripts/ai-tool-inputs.ts');
  }
  if (document.querySelector('[data-requires-auth]')) void import('../scripts/auth-gate.ts');
</script>
</body></html>
